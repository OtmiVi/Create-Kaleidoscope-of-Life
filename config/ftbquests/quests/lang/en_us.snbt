	quest.31C9CF030EAE9B98.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ask\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" about gift preferences, then give a preferred item.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check their reaction. \"},{\"text\":\"Repeating\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the same gift gives less \"},{\"text\":\"reputation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
