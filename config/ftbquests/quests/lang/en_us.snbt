	]
	quest.23AED1B252070A01.title: "Choose Your Own Adventure"
	quest.23CDF71256CF5FC0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this downgrade to reduce stack \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It is useful when you want smaller buffers or tighter limits on stored \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.23E70841DC3C1D63.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Catch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at least \"},{\"text\":\"35 fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in total. This trophy can then be fished up.\"}]}"]
	quest.23E70841DC3C1D63.title: "Iron Trophy"
	quest.242F82EDB7AD82B9.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a brush on an armadillo to collect scutes. Keep a supply for wolf \"},{\"text\":\"armor\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and its repairs.\"}]}"]
	quest.242F82EDB7AD82B9.title: "Get some arms"
	quest.2457933959868E1D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Leather\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is used for \"},{\"text\":\"armor\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", books and \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipment. Save some for the enchanting and backpack branches.\"}]}"]
	quest.24A3A61046CA3464.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Depot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" holds an item beneath a press, \"},{\"text\":\"spout\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or other processing \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it for a simple machine before adding belts.\"}]}"]
	quest.24A3A61046CA3464.title: "Depot"
	quest.257A57B87BB76486.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Basin\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beneath a compatible mixer or press for mixing and compacting \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check whether a \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" also needs heat.\"}]}"]
	quest.257A57B87BB76486.title: "Basin"
	quest.26458997375378F0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pump \"},{\"text\":\"Oxygen Gas\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into the \"},{\"text\":\"Oxygen Filler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then right-click to insert the spacesuit chestpiece. Wait for its oxygen supply to fill before removing it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check the \"},{\"text\":\"oxygen amount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on the chestpiece before leaving. The filler can also extract oxygen, so confirm that your pipes are supplying the equipment rather than draining it.\"}]}"
	]
	quest.26458997375378F0.title: "Fill the Suit Before Departure"
	quest.2655497B751A1091.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" handles the noodle and congee dishes in this branch. Add the required broth before its \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then close the lid while it cooks.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the \"},{\"text\":\"serving container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the pot so a finished dish can be collected before starting another \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.2655497B751A1091.title: "Noodles and a Pot of Comfort"
	quest.266E1B1345DE3792.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Supply a \"},{\"text\":\"Blaze Forger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and select its merge mode.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Give it two \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the same type, such as two enchanted swords, and let it combine them. A successful merge grants \"},{\"text\":\"Blazing Fusion\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.266E1B1345DE3792.title: "Merge Enchanted Items"
	quest.2681A60AE034E158.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a villager to open \"},{\"text\":\"Talk and Profile\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hold an \"},{\"text\":\"emerald\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to view reputation. \"},{\"text\":\"Sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" skips the dialogue screen. \"},{\"text\":\"Self-check\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": tick when done.\"}]}"
