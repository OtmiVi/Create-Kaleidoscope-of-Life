		"{\"text\":\"\",\"extra\":[{\"text\":\"Then \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the hatch to withdraw stored experience and earn \"},{\"text\":\"Spiritual Return\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
