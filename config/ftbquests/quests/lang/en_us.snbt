	quest.6B40084197CB6C3B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Amethyst Crystal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is a component of the \"},{\"text\":\"Circuit Engraver\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Its recipe uses \"},{\"text\":\"Polished Amethyst\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", so prepare polished shards before assembling the crystal.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Polished Amethyst is also used directly in \"},{\"text\":\"Circuits\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep some available for the electronics line instead of turning every piece into a crystal.\"}]}"
	]
