	quest.6F766C6D2A248B33.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Nature's Compass\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" searches for biomes; \"},{\"text\":\"Explorer's Compass\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" searches for structures.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Open the matching compass, select a target and follow its bearing. Use the biome compass for \"},{\"text\":\"crops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and terrain, and the structure compass for exploration routes.\"}]}"
