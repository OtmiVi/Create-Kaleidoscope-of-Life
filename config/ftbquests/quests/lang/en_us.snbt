	quest.06B694ACAD02094B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mercury\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has no atmosphere and its temperature changes sharply. Bring a filled suit, suitable \"},{\"text\":\"thermal protection\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and a prepared route home.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Tungsten\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" while keeping track of oxygen and your landing site. Check local conditions before leaving the rocket for a long mining trip.\"}]}"
	]
	quest.06B694ACAD02094B.title: "Mercury's Harsh Horizon"
	quest.06DB9A54534E08AB.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Upgrade Bases\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are components for \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" modules. Choose a module for the job you need, install it in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and configure it in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.0749C059A711739E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Gain the Flatulence\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" effect, then sneak to propel yourself upward.\"}]}"
