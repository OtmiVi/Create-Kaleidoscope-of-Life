	quest.69F6289F71DC379E.title: "Golden armor"
	quest.69FB459A6E304138.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bone Meal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is a component of the bait \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep a supply near your fishing equipment.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compare the bait types and take the one suited to the catches you are trying to find.\"}]}"
	]
	quest.69FB459A6E304138.title: "The Bait Bench"
	quest.6A09757C266B3F48.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pump Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through \"},{\"text\":\"Create Fluid Pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Break\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a section so the liquid leaks from an open pipe end.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Stand\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the leaking \"},{\"text\":\"experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to absorb it and earn the hidden advancement A \"},{\"text\":\"Shower Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep the \"},{\"text\":\"pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" running so experience continues to flow.\"}]}"
	]
	quest.6A09757C266B3F48.title: "Absorb Leaking Experience"
	quest.6A23E24D50AA419C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bites\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" take longer, but hitting a \"},{\"text\":\"sweet spot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" briefly stops the fish from escaping.\"}]}"]
	quest.6A23E24D50AA419C.title: "Slow and Steady"
	quest.6A44943162610F2F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Rutile Concentrate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can come from crushing \"},{\"text\":\"Sand\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Limestone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". A \"},{\"text\":\"Sodium Catalyst\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is made by filling salt with lava.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"These materials lead to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Titanium Tetrachloride\"},{\"text\":\", which is used in the processing sequence for a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sturdy Sheet\"},{\"text\":\".\"}]}"
	]
	quest.6A44943162610F2F.title: "The Titanium Process"
	quest.6A48F5260426487B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Cut\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"legendary fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", or process it in a powered \"},{\"text\":\"Mechanical Grindstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". The fillet keeps the fish's rarity.\"}]}"]
	quest.6A48F5260426487B.title: "Legendary Fillet"
	quest.6A57AB7BC4740C09.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Enlarges green \"},{\"text\":\"sweet spots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a more forgiving catch.\"}]}"]
	quest.6A57AB7BC4740C09.title: "A Little More Room"
	quest.6A6B32F574D84661.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use this template at a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to change the rod's appearance. Check the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for its matching material.\"}]}"]
	quest.6A6B32F574D84661.title: "Humble Skin Smithing Template"
	quest.6A73382DEA994C22.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bounces an \"},{\"text\":\"escaping fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" back once during the catch.\"}]}"]
	quest.6A73382DEA994C22.title: "One More Chance"
	quest.6A741ED634D2725C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" entering or leaving the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.6A7E000000000002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Find a \"},{\"text\":\"Grapevine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" hanging from an oak tree and break it by hand to bring it home.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Your tavern begins in the vineyard. Grow grapes, press \"},{\"text\":\"juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", brew a cellar of drinks, then bring \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into the business.\"}]}"
	]
	quest.6A7E000000000002.title: "A Tavern Starts with a Vine"
	quest.6A7E000000000005.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Plant\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Grapevine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a Trellis placed one block above the soil.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Vines\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" grow upward before spreading across neighbouring trellises. Leave \"},{\"text\":\"air\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beneath the fruit-bearing sections so grapes can form.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Harvest ripe grapes with Shears for \"},{\"text\":\"2-3\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" grapes instead of the usual \"},{\"text\":\"1-2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A7E000000000005.title: "Room for One More Vine"
	quest.6A7E000000000008.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Harvest \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Grapes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from your trellises.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use dirt or grass beneath the \"},{\"text\":\"trellis\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for ordinary grapes. Keep some fruit for your first \"},{\"text\":\"juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and some for later batches.\"}]}"
	]
	quest.6A7E000000000008.title: "The First Harvest"
	quest.6A7E00000000000B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Grow and collect \"},{\"text\":\"8\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Ice Grapes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using ice or snow beneath the trellis.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The vineyard needs space below its trellises to bear fruit. Check the ground and the space below the trellises when growth seems slow.\"}]}"
	]
	quest.6A7E00000000000B.title: "A Vineyard on Ice"
	quest.6A7E00000000000E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use netherrack or a magma block beneath the trellis and collect \"},{\"text\":\"8\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Gold Grapes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"These grapes make the \"},{\"text\":\"golden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" juice used for \"},{\"text\":\"Honey Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Miner's Star\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and other warm-colored brews.\"}]}"
	]
	quest.6A7E00000000000E.title: "A Warmer Vintage"
	quest.6A7E000000000011.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Green Grapes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are a chance drop from harvesting your vineyard.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep harvesting established vines and save the green grapes for their own \"},{\"text\":\"juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and brewing \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A7E000000000011.title: "A Lucky Bunch"
	quest.6A7E000000000014.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can grow grapes on \"},{\"text\":\"Trellises\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A7E000000000014.title: "Leaves Are Not a Vineyard"
	quest.6A7E00000000001A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Set a \"},{\"text\":\"Pressing Tub\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" flat on the ground and add pressable fruit.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Jump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on it repeatedly to turn the fruit into \"},{\"text\":\"juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". The tub holds one type of item at a time, so finish one fruit before changing to another.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use an empty bucket to collect the \"},{\"text\":\"juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A7E00000000001A.title: "Put Your Feet to Work"
	quest.6A7E00000000001D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use an empty bucket on the \"},{\"text\":\"Pressing Tub\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to collect \"},{\"text\":\"Grape Juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The juice is the base for \"},{\"text\":\"Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Champagne\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Brandy\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Carignan and Sakura Wine. Keep some near your brewing barrels.\"}]}"
	]
	quest.6A7E00000000001D.title: "A Bucket of the Vineyard"
	quest.6A7E000000000023.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ice Grape\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Gold Grape\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Green Grape\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Sweet Berries and Glow Berries juices provide different coloured brewing bases.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Press each fruit separately and keep the resulting buckets labelled so cocktail \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are easy to find.\"}]}"
	]
	quest.6A7E000000000023.title: "Six Colors on Tap"
	quest.6A7E00000000002B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Open the \"},{\"text\":\"Tavern Barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and add the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s fluid before its other ingredients.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Close\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the lid to start brewing. Keep the \"},{\"text\":\"barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" accessible so you can check its progress and collect the finished drink.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Tavern Barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for this process; an ordinary \"},{\"text\":\"Minecraft Barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is only storage.\"}]}"
	]
	quest.6A7E00000000002B.title: "Something Is Brewing"
	quest.6A7E00000000002E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s empty \"},{\"text\":\"container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beneath the \"},{\"text\":\"Tavern Barrel's Tap\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then right-click the tap to bottle the drink.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses \"},{\"text\":\"Tavern Empty Bottles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep the right containers beside the cellar so finished batches can be served immediately.\"}]}"
	]
	quest.6A7E00000000002E.title: "Ready to Serve"
	quest.6A7E000000000032.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from ordinary \"},{\"text\":\"grape juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then bottle it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check the \"},{\"text\":\"barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s brewing progress before serving. \"},{\"text\":\"Leaving\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it to age improves its brew level.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save several bottles at \"},{\"text\":\"Fine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" quality or better if you want to use them in cocktails.\"}]}"
	]
	quest.6A7E000000000032.title: "The House Wine"
	quest.6A7E000000000036.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can brew drinks by filling a \"},{\"text\":\"Barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", adding \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and closing its lid.\"}]}"]
	quest.6A7E000000000036.title: "Fluid First, Ingredients Second"
	quest.6A7E000000000039.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can leave drinks in the \"},{\"text\":\"Barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" longer to improve their quality.\"}]}"]
	quest.6A7E000000000039.title: "Give It Time"
	quest.6A7E00000000003C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Champagne\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Brandy\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Carignan and Sakura Wine.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"All four begin with ordinary grape juice. Their added ingredients are \"},{\"text\":\"Sugar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Apple\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Sweet Berries and Pink Petals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" respectively.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" each \"},{\"text\":\"barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with juice before adding its ingredient.\"}]}"
	]
	quest.6A7E00000000003C.title: "The Orchard Flight"
	quest.6A7E000000000043.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Ice Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Mother Snow\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Polaris Sweet White and Sherry.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"All use \"},{\"text\":\"Ice Grape Juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Ice Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs no extra ingredient; \"},{\"text\":\"Mother Snow\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" adds \"},{\"text\":\"Ice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Polaris adds Packed Ice, and Sherry adds Blue Ice.\"}]}"
	]
	quest.6A7E000000000043.title: "A Cellar Full of Winter"
	quest.6A7E00000000004A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Honey Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Miner's Star\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Madame Shexiang and Sunset Glow.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Start with \"},{\"text\":\"Gold Grape Juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Add \"},{\"text\":\"Honeycomb\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Iron Nugget\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Gold Nugget or Blaze Powder respectively.\"}]}"
	]
	quest.6A7E00000000004A.title: "The Golden Shelf"
	quest.6A7E000000000051.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Plum Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Sweet Berry Wine and Red Queen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from Sweet Berries Juice.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Sugar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Plum Wine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Sweet Berries\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for Sweet Berry Wine, and Redstone Dust for Red Queen.\"}]}"
	]
	quest.6A7E000000000051.title: "Berries in the Cellar"
	quest.6A7E000000000057.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Riesling Dry White and Sauvignon Blanc Dry White\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Green Grape Juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Riesling\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs \"},{\"text\":\"Gunpowder and Sugar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Sauvignon Blanc needs Sugar Cane and Sugar.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"These drinks supply the green ingredient group for your \"},{\"text\":\"shaker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A7E000000000057.title: "Good Things Come in Green"
	quest.6A7E00000000005C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Luminous Bride and Glowflower Brew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from \"},{\"text\":\"Glow Berries Juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add a \"},{\"text\":\"Glow Ink Sac\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Luminous Bride\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Glowstone Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Glowflower Brew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Both belong to the yellow cocktail ingredient group.\"}]}"
	]
	quest.6A7E00000000005C.title: "A Little Light in Every Bottle"
	quest.6A7E000000000061.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Vodka\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Whiskey and Rum\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using water as the starting fluid.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add \"},{\"text\":\"Potato\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Vodka\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Wheat for Whiskey, or Sugar Cane for Rum.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"These drinks belong to the white cocktail ingredient group.\"}]}"
	]
	quest.6A7E000000000061.title: "Clear Beginnings"
	quest.6A7E000000000067.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cocktail\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" recipes choose ingredients by colour group and require \"},{\"text\":\"Fine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" quality or better.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check the quality of every ingredient bottle before mixing and keep Empty \"},{\"text\":\"Glassware\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for serving.\"}]}"
	]
	quest.6A7E000000000067.title: "Shake Up the Menu"
	quest.6A7E00000000006B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can mix three \"},{\"text\":\"Fine-quality\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" drinks in a \"},{\"text\":\"Shaker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make cocktails.\"}]}"]
	quest.6A7E00000000006B.title: "Three Drinks and a Little Patience"
	quest.6A7E00000000006E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Allium Garden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses three light-purple ingredients, \"},{\"text\":\"Brass Heart\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses three gold ingredients, and \"},{\"text\":\"Emerald\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses three green ingredients.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Each brewing ingredient must be \"},{\"text\":\"Fine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" quality or better.\"}]}"
	]
	quest.6A7E00000000006E.title: "One Color, Three Measures"
	quest.6A7E000000000074.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mojito\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": white + white + green. \"},{\"text\":\"Grasshopper\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": green + green + white. \"},{\"text\":\"White Lady\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": white + green + yellow.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use matching bottles and let every brewing ingredient reach \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Fine\"},{\"text\":\" quality.\"}]}"
	]
	quest.6A7E000000000074.title: "Something Fresh"
	quest.6A7E00000000007A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bloody Mary\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": red + red + red. \"},{\"text\":\"Godfather\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": red + red + gold. \"},{\"text\":\"Screwdriver\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": yellow + yellow + gold.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a separate shelf for each ingredient color to make the next order easier.\"}]}"
	]
	quest.6A7E00000000007A.title: "A Bold Little Menu"
	quest.6A7E000000000080.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Depth Charge\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": blue + light purple + white. \"},{\"text\":\"Nether Special\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": red + green + blue. \"},{\"text\":\"Sculk Special\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": blue + blue + light purple.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Fine-quality\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or better for every recipe.\"}]}"
	]
	quest.6A7E000000000080.title: "A Round for the Adventurers"
	quest.6A7E000000000086.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Set up a serving area for your kitchen and cellar. Leave yourself room to reach the barrels and bottle \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A7E000000000086.title: "A Place to Pull Up a Stool"
	quest.6A7E00000000008B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"serving containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" near the bar and display your collection on racks. Check a rack's accepted bottle shape if a drink will not fit.\"}]}"]
	quest.6A7E00000000008B.title: "Bottles Deserve a Shelf"
	quest.6A7E000000000091.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Give your tavern a \"},{\"text\":\"menu\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a \"},{\"text\":\"cozy corner\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". This branch is for making the place feel like home.\"}]}"]
	quest.6A7E000000000091.title: "Tonight's Specials"
	quest.6A7E000000000096.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"You can use a \"},{\"text\":\"Mechanical Press and Basin\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make \"},{\"text\":\"grape juice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"Mechanical Press\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6431C7321BFC0EFB\"}}"
		"{\"text\":\"Basin\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"257A57B87BB76486\"}}"
	]
	quest.6A7E000000000096.title: "Let the Press Do the Stomping"
	quest.6A7E00000000009A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Fluid Pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a \"},{\"text\":\"Mechanical Pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to move juice into Fluid Tanks.\"}]}"
		"{\"text\":\"Fluid Pipes\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4FC8B0B6D84E9EE0\"}}"
