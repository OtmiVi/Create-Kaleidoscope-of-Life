		"{\"text\":\"\",\"extra\":[{\"text\":\"Plant\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and grow them on \"},{\"text\":\"farmland\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep the ripe tomatoes for stir-fries, soups and \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" bowls.\"}]}"
	]
	quest.6F846C8AA00B0321.title: "Tomatoes Start Small"
	quest.6F8E07DEFFBF4D1D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"rare\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" fillets to prepare all seven dishes: \"},{\"text\":\"hosomaki\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"nigiri\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", temaki, uramaki, salad, omelette and fish and chips.\"}]}"]
	quest.6F8E07DEFFBF4D1D.title: "Rare Fish Menu"
	quest.6FB787F8389A44C0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use this template at a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to change the rod's appearance. Check the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for its matching material.\"}]}"]
	quest.6FB787F8389A44C0.title: "Azure Crystal Skin Smithing Template"
	quest.6FDDBFD938CB4EE6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Apply the matching skin template to a \"},{\"text\":\"Starcatcher\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rod at a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6FDDBFD938CB4EE6.title: "Bamboo Rod"
	quest.70258B8247918D36.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Reach \"},{\"text\":\"Revered\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" reputation with one villager: \"},{\"text\":\"400 points\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.70258B8247918D36.title: "A Local Legend"
	quest.706E7CBC5F775826.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Hand Crank\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supplies rotation while you turn it. It is useful for testing a small setup before adding a permanent \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" source.\"}]}"]
	quest.706E7CBC5F775826.title: "Hand Crank"
	quest.707B5B058C8A1002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sturdy Sheets\"},{\"text\":\" are a processed component for advanced machinery. Complete their processing sequence to obtain the finished sheet.\"}]}"
	]
	quest.707B5B058C8A1002.title: "Sturdy Sheet"
	quest.70C606A656B56FE1.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Complete a \"},{\"text\":\"Builder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" blueprint.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Provide\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"payment\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", all materials and reachable storage. Keep the building site accessible.\"}]}"
	]
	quest.70C606A656B56FE1.title: "Blueprint for Success"
	quest.70D381D1357D5C8D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 2 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 5.\"}]}"
	]
	quest.70E3727DE9CE36F8.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"Blaze Forger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supplied with compatible enchanted templates and equipment.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The advancement tracks repeated forging operations. \"},{\"text\":\"Sort\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" finished equipment away from the \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to keep the line moving.\"}]}"
	]
	quest.71403084F0044DE9.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Voids \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" selected by its \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.71DEA555C859C16F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Turn some into planks and a crafting \"},{\"text\":\"table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", but keep spare logs for charcoal and your first shelter.\"}]}"]
	quest.71DEA555C859C16F.title: "Get wood"
	quest.7204A1D376F3D7F6.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the matching tea bag in a \"},{\"text\":\"heated\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and serve the finished drink in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a cup ready beside your \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.7204A1D376F3D7F6.title: "Butter Tea"
	quest.7254CD613193123A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Equip the \"},{\"text\":\"Exoskeleton Chestplate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and inspect its operating requirements. Check the assigned controls before testing its movement features.\"}]}"]
	quest.7254CD613193123A.title: "Andesite Exoskeleton"
	quest.733FCF269775E418.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place the \"},{\"text\":\"wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" directly over a lit \"},{\"text\":\"Stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or another suitable heat source.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add \"},{\"text\":\"Oil\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Stir\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the spatula until cooking finishes; wrong ingredients or waiting too long can spoil the dish.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the required \"},{\"text\":\"serving container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", usually a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", to collect the result. For dishes without a \"},{\"text\":\"container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", sneak-right-click with the \"},{\"text\":\"Kitchen Spatula\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.733FCF269775E418.title: "Your First Wok"
	quest.734BFBD31C3D2315.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Prepare a route to \"},{\"text\":\"Mars\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with an \"},{\"text\":\"Interplanetary Navigator\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" aboard. Check your oxygen supply, fuel reserves, and landing equipment before departure.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Stand on the Martian surface\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to earn the advancement. Look for \"},{\"text\":\"Raw Martian Iron\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to begin the next stage of materials processing.\"}]}"
	]
	quest.734BFBD31C3D2315.title: "One Giant Leap"
	quest.735DF7ABE693CD2A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Golden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" apples and \"},{\"text\":\"golden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" carrots make useful expedition supplies. Keep the apple for a difficult fight.\"}]}"]
	quest.735DF7ABE693CD2A.title: "Royale food"
	quest.7388048AC50D5ECE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Find a \"},{\"text\":\"Waystone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and look directly at it to complete the observation task.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Interact\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with it to activate the destination. \"},{\"text\":\"Newly\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" found \"},{\"text\":\"Waystones\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in this pack use activation-based visibility by default.\"}]}"
	]
	quest.73BB8BC267841762.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Check the material and mining tier before replacing your current \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and keep spare materials for repairs or replacements.\"}]}"]
	quest.73BB8BC267841762.title: "Blazing Tools"
	quest.73CC5B74270EFBAF.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Lunar Sapphire\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on the \"},{\"text\":\"Moon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect its shards. Save some for polishing: \"},{\"text\":\"Polished Lunar Sapphire\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is used in navigation and advanced electronics.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep track of your \"},{\"text\":\"oxygen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" while searching underground. Bring the shards home or process them at a prepared lunar outpost.\"}]}"
	]
	quest.73CC5B74270EFBAF.title: "Sapphires Under Moonlight"
	quest.7400035D23127D31.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Carry\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Satchel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to expand your traveling \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check its controls before filling it with expedition supplies.\"}]}"]
	quest.746B3CF62C2F530A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Broken Iron Space Suit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is a reminder to check your expedition gear. Inspect the condition of every equipped piece before relying on it away from your base.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"working replacement\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a filled chestpiece ready. Deal with damaged equipment in a protected area before continuing the trip.\"}]}"
	]
	quest.746B3CF62C2F530A.title: "When the Suit Gives Out"
	quest.74952DAF91A29B22.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with rotation and connect its front and back to \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Reverse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rotation when you need to reverse the fluid flow.\"}]}"]
	quest.74952DAF91A29B22.title: "Mechanical Pump"
	quest.74B6DA366E71A547.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bamboo Tube Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses the \"},{\"text\":\"Steamer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep its \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" together so another portion can be started when the first is ready.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use its \"},{\"text\":\"Bamboo\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" serving format when planning expedition meals.\"}]}"
	]
	quest.74B6DA366E71A547.title: "Lunch in a Bamboo Tube"
	quest.74CF736A6991E557.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Refills selected item stacks in the player's \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Choose the \"},{\"text\":\"target slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in its \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; \"},{\"text\":\"middle-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can also pick \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.75192CE143345911.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Fluid Atomizer\"},{\"text\":\" to your fluid workshop. Its \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ponder\"},{\"text\":\" scene explains the supported processing arrangements.\"}]}"
	]
	quest.75192CE143345911.title: "Fluid Atomizer"
	quest.754CDEB099E74278.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Start brewing with a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Brewing Stand\"},{\"text\":\" and blaze powder. Prepare bottles of water before adding \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"ingredients\"},{\"text\":\".\"}]}"
	]
	quest.754CDEB099E74278.title: "Let's drink it"
	quest.75542EADFE5CFBF1.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Telescope\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Paper\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to take Astronomical Readings of a celestial body. Add the readings to your \"},{\"text\":\"Space Atlas\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at the \"},{\"text\":\"Astronomy Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Return on \"},{\"text\":\"different days\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to build up science for a destination. Readings of the same body from the same day are duplicates; observations from other planets are worth more.\"}]}"
	]
	quest.75542EADFE5CFBF1.title: "Read the Night Sky"
	quest.7579B276EAB98783.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Basic\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Diamond\"},{\"text\":\" tier.\"}]}"
	]
	quest.75925DD859CB3CB9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"Large Fan\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a \"},{\"text\":\"Fan Blade\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to install the blade. Drive it through an adjacent \"},{\"text\":\"Encased Chain Drive\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The fan increases the maximum area of \"},{\"text\":\"Oxygen Sealers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"Temperature Regulators\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check the resulting coverage where people and equipment will actually be working.\"}]}"
	]
	quest.75925DD859CB3CB9.title: "Give Life Support More Reach"
	quest.75B04C49A360261F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Deployer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" performs item interactions at its working face. Use it for \"},{\"text\":\"Sequenced Assembly\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and other \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" that require a held ingredient or tool.\"}]}"]
	quest.75B04C49A360261F.title: "Deployer"
	quest.75B4499D270B3411.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Claim\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the dragon egg after defeating the \"},{\"text\":\"Ender Dragon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It teleports when touched, so collect it with a suitable piston or falling-\"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" setup.\"}]}"]
	quest.7652FF171AFF4D4B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 2 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 4.\"}]}"
	]
	quest.7695E361852C9C5C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 1 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 2.\"}]}"
	]
	quest.76AC070F021FA148.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically feeds the player using \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.77020AB6BC9F156F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Dormant Martian Seed\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs a revival sequence before it becomes a living plant. Pass it through \"},{\"text\":\"Water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", enhanced Healing, enhanced Strength, and enhanced Regeneration potion filling steps.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The sequence runs \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"twice\"},{\"text\":\" and can produce different Martian seeds.\"}]}"
	]
	quest.77020AB6BC9F156F.title: "Wake a Sleeping Seed"
	quest.774291101D99615E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Small\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and large cogwheels transfer rotation and can change its \"},{\"text\":\"speed\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Watch the direction of rotation when connecting machines.\"}]}"]
	quest.774291101D99615E.title: "Cogwheels"
	quest.775F114D30179638.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Lay Fresh Tea Leaves\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a \"},{\"text\":\"Bamboo Tray\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and leave them to dry.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the tray near your tea preparation area so dried \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can go straight to the \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.775F114D30179638.title: "Leaves on the Drying Tray"
	quest.77DBB83428A21C83.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place an \"},{\"text\":\"Andesite Tunnel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" over a \"},{\"text\":\"belt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to manage its item flow. \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shows where items can enter and leave.\"}]}"]
	quest.77DBB83428A21C83.title: "Andesite Tunnel"
	quest.7801851C6939D024.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Equip the \"},{\"text\":\"Exoskeleton Chestplate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and inspect its operating requirements. Check the assigned controls before testing its movement features.\"}]}"]
	quest.7801851C6939D024.title: "Copper Exoskeleton"
	quest.780AF722C380D38C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep your \"},{\"text\":\"armour\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipped during exploration and check its \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after combat. Compare protection with your current equipment before replacing a piece.\"}]}"]
	quest.780AF722C380D38C.title: "Copper armor"
	quest.785A45D09878B0F4.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Quest Book\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to follow the pack\u0027s progression and open a quest for practical setup hints.\"}]}"
		"{\"text\":\"Item tasks check your inventory. Tick practical checkmarks after trying the described activity.\"}"
	]
	quest.78902351B2D4C08A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Hold every available \"},{\"text\":\"Flora\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"flower drink\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in your inventory at once.\"}]}"]
	quest.78902351B2D4C08A.title: "The Complete Bouquet"
	quest.7993F28058B65375.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Help\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a wandering \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" settle in a tracked village.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use their dialogue and \"},{\"text\":\"Home\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" information. \"},{\"text\":\"Wandering\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" traders do not count.\"}]}"
	]
	quest.7993F28058B65375.title: "A New Neighbor"
	quest.79D85F0CE7026A9C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Steamer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Baozi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and keep a few buns available for travel.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Baozi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can also heal an injured wolf when thrown to it while sneaking, so save one for your \"},{\"text\":\"companion\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.79D85F0CE7026A9C.title: "Something Good Inside"
	quest.79DE274016EE90F1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Deposits \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into an \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" you \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.79E47D918E7EF240.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Portable Drill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" adds a handheld mining option. Check its tooltip for operation and supply requirements before a long mining trip.\"}]}"]
	quest.79E47D918E7EF240.title: "Portable Drill"
	quest.7A1648E7E2877A4A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Earn the Crowned\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by the \"},{\"text\":\"Village\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"An optional \"},{\"text\":\"reputation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" goal after becoming \"},{\"text\":\"Revered\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.7A1648E7E2877A4A.title: "Crowned by the Village"
	quest.7A3DD8F510A38490.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Experience Tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use \"},{\"text\":\"Heaps of Experience and Zinc Handles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Choose the tool for the \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or activity you are working on.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before an expedition and keep replacement components available at your workshop.\"}]}"
	]
	quest.7A3DD8F510A38490.title: "Experience Tools"
	quest.7A90F939830C8782.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Input and Output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" directional item flow. Use the \"},{\"text\":\"Storage Tool\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to link separate storage groups to the \"},{\"text\":\"Controller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; connectors bridge gaps in the storage layout.\"}]}"]
	quest.7A959F933587F365.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sequenced motion with \"},{\"text\":\"Brass Funnels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Tunnels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and inventory sensors. Configure filters and redstone thresholds before feeding a busy production line.\"}]}"]
	quest.7A959F933587F365.title: "Brass Logistics and Control"
	quest.7A9BF3B1BF289D1F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Process \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Raw Glowstone Ore\"},{\"text\":\" in the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Circuit Engraver\"},{\"text\":\" to obtain \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Enriched Glowstone Ore\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Those potions are useful for \"},{\"text\":\"reviving Martian plants\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep the enriched ore available when preparing a seed or sapling processing line.\"}]}"
	]
	quest.7A9BF3B1BF289D1F.title: "Enrich the Glowstone"
	quest.7AEE5B1EC5B455A4.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Supply a \"},{\"text\":\"Blaze Enchanter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its enchanting level on the panel, then insert an unenchanted item.\"}]}"]
	quest.7AEE5B1EC5B455A4.title: "Blaze Enchanter"
	quest.7AFCEE30B9303CBB.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sails or sail frames to a \"},{\"text\":\"Windmill Bearing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then assemble the windmill. Leave clearance for the blades to rotate.\"}]}"]
	quest.7AFCEE30B9303CBB.title: "Windmill Power"
	quest.7B0BEFF95776E04A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Equip this \"},{\"text\":\"Jetpack Chestplate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and check its \"},{\"text\":\"fuel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" requirements in the tooltip. Set the flight controls and test a short takeoff over safe ground.\"}]}"]
	quest.7B0BEFF95776E04A.title: "Brass Jetpack"
	quest.7B2C45DECEA08113.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Electrolysis Machine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" turns \"},{\"text\":\"Water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into \"},{\"text\":\"Hydrogen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"Oxygen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Supply the machine and route both products to storage or their consumers.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the oxygen for \"},{\"text\":\"life support\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the hydrogen for fuel or cooling recipes. Check both output paths if production stops.\"}]}"
	]
	quest.7B2C45DECEA08113.title: "Split Water, Save the Gases"
	quest.7B363CADBD78324F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Equip the \"},{\"text\":\"Diving Helmet\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Diving Boots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a charged \"},{\"text\":\"Backtank\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for underwater work. \"},{\"text\":\"Refill the Backtank\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with rotation before a long dive.\"}]}"]
	quest.7B363CADBD78324F.title: "Copper Diving Equipment"
	quest.7B3EA954508CB5B4.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Melon Slice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Jungle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.7B5B424C06E2A5B6.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Hanami Tale\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Pink Petals Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.7B5B424C06E2A5B6.title: "Hanami Tale"
	quest.7B6E92020E49F2EA.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Equip this \"},{\"text\":\"Jetpack Chestplate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and check its \"},{\"text\":\"fuel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" requirements in the tooltip. Set the flight controls and test a short takeoff over safe ground.\"}]}"]
	quest.7B6E92020E49F2EA.title: "Copper Jetpack"
	quest.7C43EF073F6FD620.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew When the \"},{\"text\":\"Wind Rises\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Dandelion Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.7C43EF073F6FD620.title: "When the Wind Rises"
	quest.7C66A99EFC207FC8.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Martian Steel Pickaxe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", axe, and shovel for gathering resources, and keep the sword ready when exploring unfamiliar terrain.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Watch their \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before a long expedition. Tools help with gathering and combat; continue checking your suit's oxygen and protection separately.\"}]}"
	]
	quest.7C66A99EFC207FC8.title: "Tools for the Expedition"
	quest.7CAB79FFAFE796AC.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the matching tea bag in a \"},{\"text\":\"heated\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and serve the finished drink in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a cup ready beside your \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.7CAB79FFAFE796AC.title: "Biluochun"
	quest.7CEA7321A4EC1BC8.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Steamer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a lit \"},{\"text\":\"Stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or another suitable heat source. \"},{\"text\":\"Insert\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ingredients from the top before adding another layer.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"With an empty hand, \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the top \"},{\"text\":\"steamer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to close its lid and start cooking. One \"},{\"text\":\"heat source\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supports up to eight layers.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Once the \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is ready, \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with an empty hand to open the lid, then \"},{\"text\":\"right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to collect it. \"},{\"text\":\"Work\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" down through a stack from the top.\"}]}"
	]
	quest.7CEA7321A4EC1BC8.title: "A Stack of Steamers"
	quest.7D02D098B2B984DE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Martian Steel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is produced by heated compacting of \"},{\"text\":\"Titanium\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Raw Martian Iron\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and \"},{\"text\":\"Volcanic Ash\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep those supplies together when planning a production line.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Press some ingots into \"},{\"text\":\"Martian Steel Sheets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for Advanced Circuits. Reserve others for the upgraded spacesuit, tools, and stronger rocket shielding.\"}]}"
	]
	quest.7D02D098B2B984DE.title: "Steel from Another World"
	quest.7D19D2E0346C7CD1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Look for an \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ship. Equip the \"},{\"text\":\"Elytra\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in your chest slot and keep a safe landing area for your first flight.\"}]}"]
	quest.7D19D2E0346C7CD1.title: "I can fly!"
	quest.7D32965F710B9731.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach Steam Engines\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a \"},{\"text\":\"heated\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"-filled tank boiler and connect their pistons to shafts. \"},{\"text\":\"Water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply and heat determine the boiler's usable output.\"}]}"]
	quest.7D32965F710B9731.title: "Steam Engine"
	quest.7D4C5CDB75DDCA92.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Deposits \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into an \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" you \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.7D665EE70CE7E500.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Advanced Circuits\"},{\"text\":\" extend the basic circuit\\u0027s assembly sequence with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Polished Lunar Sapphire\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Martian Steel Sheets\"},{\"text\":\". Use the Circuit Engraver for the engraving steps.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"These circuits lead to \"},{\"text\":\"Temperature Regulators\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep a supply of finished basic circuits available as input to the advanced line.\"}]}"
	]
	quest.7D665EE70CE7E500.title: "A More Capable Circuit"
	quest.7D98D536ECD7E0A5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Space Atlas\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" stores your astronomical research and landing destinations. Open it to inspect celestial bodies, then use the \"},{\"text\":\"Astronomy Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to add new readings and unlock travel.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Put the atlas in the \"},{\"text\":\"Rocket Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when choosing your route. Keep researching a destination if it is still locked.\"}]}"
	]
	quest.7D98D536ECD7E0A5.title: "A Map Beyond Earth"
	quest.7E9412EFB84F58A1.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bind a \"},{\"text\":\"Blank Scroll\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a \"},{\"text\":\"Waystone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before leaving on a long expedition.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the \"},{\"text\":\"bound scroll\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for an emergency return and check its destination before using it.\"}]}"
	]
	quest.7E9DA9380C835EAD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Tender Thorns\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Rose Bush Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.7E9DA9380C835EAD.title: "Tender Thorns"
	quest.7EA2911A0D2B15A7.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.7F455226B9BF72FE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Iron\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Gold\"},{\"text\":\" tier.\"}]}"
	]
	quest.7F55FA09B39D0603.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Set an equipment item in the \"},{\"text\":\"Blaze Enchanter's\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" slot, then supply a blank \"},{\"text\":\"Enchanting Template\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to write compatible \"},{\"text\":\"enchantments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" onto it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Blaze Forger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to apply the written template to equipment.\"}]}"
	]
	quest.7F55FA09B39D0603.title: "Enchanting Template"
