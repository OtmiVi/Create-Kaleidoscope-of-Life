	quest.20AA1DF0C7C9300D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Clockwork Bearing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" moves clock hands; the \"},{\"text\":\"Elevator Pulley\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" moves a lift. Use their \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" scenes to plan clear movement paths and stopping points.\"}]}"]
