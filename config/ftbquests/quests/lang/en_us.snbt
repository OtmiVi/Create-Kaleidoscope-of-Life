	]
	quest.23787F50BB3D3677.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Blasts ores and metal \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.23AED1B252070A01.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Finish a branching \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" questline.\"}]}"
