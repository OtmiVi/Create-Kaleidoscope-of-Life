	quest.19B1B9224B374349.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Sand\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Desert\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.19C34F99BFBD511F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Snowball\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Snowy Taiga\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
