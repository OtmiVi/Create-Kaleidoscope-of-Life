	quest.1A3C1F4EF310DD53.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Provides a portable \"},{\"text\":\"Jukebox\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with support for additional music \"},{\"text\":\"discs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Open its \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose \"},{\"text\":\"playback\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" options. Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
