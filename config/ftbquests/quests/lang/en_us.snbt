		"{\"text\":\"\",\"extra\":[{\"text\":\"Feed a \"},{\"text\":\"Caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a baby chicken to complete the \"},{\"text\":\"High-Quality Protein\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement.\"}]}"
