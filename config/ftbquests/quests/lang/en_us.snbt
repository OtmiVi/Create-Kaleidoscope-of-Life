	quest.09C9528550E1FD6B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Heavy Core\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is a rare reward from ominous vaults. \"},{\"text\":\"Combine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with a \"},{\"text\":\"Breeze Rod\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when you are ready to make a \"},{\"text\":\"Mace\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.09DDB60276EDB366.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Coiler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Argyre\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and \"},{\"text\":\"Wilter Saplings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" let you grow Martian trees. Leave room above and around each sapling for its tree to develop.\"}]}"
