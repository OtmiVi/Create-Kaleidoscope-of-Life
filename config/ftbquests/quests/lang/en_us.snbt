	quest.6DFF1A692717E667.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Voids \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" selected by its \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
