	quest.2DA28365F9AF5916.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Birch Log\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Birch Forest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
