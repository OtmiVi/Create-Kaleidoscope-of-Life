	quest.02A7C9C35D5C8897.title: "White Chocolate"
	quest.02A7C9C35D5C8897.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heated mixing\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Cocoa Butter\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Milk\"},{\"text\":\" to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB White Chocolate\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect a full bucket for the task. Keep a separate tank and Spout for white chocolate so the coating line always receives the right fluid.\"}]}"
	]
	quest.12800E936CAEF25E.title: "Glow Berry Jam"
	quest.12800E936CAEF25E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Sugar\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Glow Berries\"},{\"text\":\" in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"superheated Basin\"},{\"text\":\" to produce \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Glow Berry Jam\"},{\"text\":\". Supply a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Blaze Cake\"},{\"text\":\" to the burner.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"1000 mB\"},{\"text\":\" in a bucket and keep the remaining jam separate from the sweet berry line. It becomes the filling for glow berry rolls and waffles.\"}]}"
	]
	quest.14A4904A9F6C7BFD.title: "Sweet Berry Jam"
	quest.14A4904A9F6C7BFD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Sugar\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sweet Berries\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"superheated mixing\"},{\"text\":\" to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Sweet Berry Jam\"},{\"text\":\". A Blaze Burner fed with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Blaze Cake\"},{\"text\":\" provides the required heat.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect a bucket for the task. Pump the jam to a dedicated \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" to fill bread rolls and waffles.\"}]}"
	]
	quest.169E6F9A0454646F.title: "A Warm Drink and Honey Candy"
	quest.169E6F9A0454646F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"For \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Hot Chocolate\"},{\"text\":\", heat-mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Cocoa Powder\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Milk\"},{\"text\":\". Fill a Glass Bottle with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\" under a Spout, then craft it with a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Marshmallow\"},{\"text\":\" into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Soothing Hot Chocolate\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"For \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Honey Candy\"},{\"text\":\", heat-mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Wheat Flour\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Honey\"},{\"text\":\". Each batch makes \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"four candies\"},{\"text\":\", so make four batches to reach the required \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"sixteen\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect the drink and all sixteen candies.\"}]}"
	]
	quest.1EB4B8C5ABA08C01.title: "The Bright Side"
	quest.1EB4B8C5ABA08C01.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Dark Chocolate Bar\"},{\"text\":\" in the center of a crafting grid and surround it above, below, left and right with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"four Candy Canes\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The result is \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"The Bright Side\"},{\"text\":\" music disc. Collect it to complete this optional confectionery souvenir, then play it in a Jukebox.\"}]}"
	]
	quest.27ABBE1A0359EE97.title: "Superheated Nectar"
	quest.27ABBE1A0359EE97.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Sugar\"},{\"text\":\" in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"superheated Basin\"},{\"text\":\" to produce \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Nectar\"},{\"text\":\". Feed a Blaze Burner a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Blaze Cake\"},{\"text\":\" to reach the required heat level.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ordinary burner heat is insufficient for this recipe. Run enough batches to collect a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"full bucket\"},{\"text\":\", then reserve nectar for the fruit-glazing branch.\"}]}"
	]
	quest.2C68A5A2DFF94F07.title: "White Chocolate Selection"
	quest.2C68A5A2DFF94F07.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Supply a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"White Chocolate\"},{\"text\":\" to coat apples, sweet berries, marshmallows, bread rolls and cooked waffles. Each filling recipe uses \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compact the liquid in a Basin to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"White Chocolate Bars\"},{\"text\":\". Include the Full White Chocolate Bar and collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"all seven\"},{\"text\":\" items in this task.\"}]}"
	]
	quest.36C4054707F153EE.title: "Dark Chocolate"
	quest.36C4054707F153EE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Cocoa Butter\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Cocoa Beans\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Milk\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heat\"},{\"text\":\" to produce \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Dark Chocolate\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect a bucket, then reserve some chocolate for bars and glazing. The dark chocolate bar also appears in the optional \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"The Bright Side\"},{\"text\":\" music-disc recipe.\"}]}"
	]
	quest.3CB162A50F805F55.title: "A Jar for the Kitchen"
	quest.3CB162A50F805F55.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Craft a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Create Factory Jar\"},{\"text\":\" from \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"five Glass\"},{\"text\":\", an \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Iron Sheet\"},{\"text\":\" and a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Dye\"},{\"text\":\". This task accepts \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"any of the sixteen jar colors\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the jar as a small fluid container for your kitchen and dip compatible ingredients into its contents.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a jar near your confectionery station for small batches. Combine a jar with a different dye in crafting to change its color.\"}]}"
	]
	quest.486851AFC859E569.title: "Milk Chocolate"
	quest.486851AFC859E569.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Cocoa Beans\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Milk\"},{\"text\":\" in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Basin\"},{\"text\":\" under a powered \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mechanical Mixer\"},{\"text\":\". Supply ordinary \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heat\"},{\"text\":\" from a fueled Blaze Burner to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Chocolate\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pipe the output into a dedicated tank. Collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"1000 mB\"},{\"text\":\" in a bucket for this task, then send chocolate to a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" for glazing or to a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mechanical Press\"},{\"text\":\" over a Basin for bars.\"}]}"
	]
	quest.49EEFAB7A94EE7DD.title: "Sweet Berry Bakery"
	quest.49EEFAB7A94EE7DD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Bread\"},{\"text\":\" and a cooked \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Waffle\"},{\"text\":\" beneath a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Sweet Berry Jam\"},{\"text\":\" per item. Collect both the roll and waffle.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Make waffle bases by heated mixing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar, Dough, Egg and Milk\"},{\"text\":\" into Cake Paste, pressing it into Uncooked Waffles, then cooking them in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Smoker\"},{\"text\":\".\"}]}"
	]
	quest.4A193255CDC70259.title: "Liquid Caramel"
	quest.4A193255CDC70259.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Sugar\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Water\"},{\"text\":\" in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heated Basin\"},{\"text\":\" to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Caramel\"},{\"text\":\". Collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"1000 mB\"},{\"text\":\" in a bucket for this task.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Send caramel to a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" for glazing, or compact \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\" under a Mechanical Press to make a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Caramel Bar\"},{\"text\":\". Save bars for the filled-chocolate collection.\"}]}"
	]
	quest.4B5836FAF22DD69F.title: "Glow Berry Bakery"
	quest.4B5836FAF22DD69F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Send \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Bread\"},{\"text\":\" and cooked \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Waffles\"},{\"text\":\" beneath a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" supplied with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Glow Berry Jam\"},{\"text\":\". Each filling consumes \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect both products. Share the bread and plain-waffle supply with the other bakery lines, then route each batch to the correct jam Spout.\"}]}"
	]
	quest.4E9ED2FBCC812AF3.title: "Ruby Chocolate Selection"
	quest.4E9ED2FBCC812AF3.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Route \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ruby Chocolate\"},{\"text\":\" to a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" and coat apples, sweet berries, marshmallows, bread rolls and cooked waffles. Allow \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\" for each coating.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compact some fluid into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ruby Chocolate Bars\"},{\"text\":\". Include the Full Ruby Chocolate Bar and collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"all seven\"},{\"text\":\" listed products to finish the branch.\"}]}"
	]
	quest.52176106378A8FBD.title: "Candy Cane Tool Set"
	quest.52176106378A8FBD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Candy Canes\"},{\"text\":\" in the crafting recipes for a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sword\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Pickaxe\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Axe\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Shovel\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect all four tools to complete this optional set. Keep a separate reserve of canes if you also want to craft the music disc.\"}]}"
	]
	quest.570312138277F96B.title: "Dark Chocolate Selection"
	quest.570312138277F96B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Dark Chocolate\"},{\"text\":\" per item to glaze apples, sweet berries, marshmallows, bread rolls and cooked waffles.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"A Mechanical Press over a Basin compacts the fluid into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Dark Chocolate Bars\"},{\"text\":\". Include the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Full Dark Chocolate Bar\"},{\"text\":\" to finish this seven-item selection.\"}]}"
	]
	quest.581564C75A458F94.title: "Ruby Chocolate"
	quest.581564C75A458F94.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Dragon\\u0027s Breath\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Cocoa Beans\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Milk\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heated mixing\"},{\"text\":\" to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Ruby Chocolate\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect a full bucket. This branch needs Dragon\\u0027s Breath, so plan an End expedition before setting up a continuous ruby chocolate line.\"}]}"
	]
	quest.620AC1C3742231E5.title: "The Chocolatier's Challenge"
	quest.620AC1C3742231E5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Complete the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Chocolatier Challenge\"},{\"text\":\": collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"8 of each\"},{\"text\":\" of the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"sixteen filled chocolates\"},{\"text\":\" listed below, for \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"128 candies\"},{\"text\":\" in total.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"four coatings\"},{\"text\":\" with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"four centers\"},{\"text\":\". Use a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\" of chocolate to coat a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Caramel Bar\"},{\"text\":\" or one of the three other chocolate bars.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Repeat with \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Milk\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"White\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Dark\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ruby Chocolate\"},{\"text\":\" as the outer coating. Make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"eight candies per filling variant\"},{\"text\":\" before switching to the next recipe.\"}]}"
		"{\"text\":\"Keep separate fluid tanks for each coating.\"}"
	]
	quest.6F0850EACB317C5C.title: "Nectar-Glazed Fruit"
	quest.6F0850EACB317C5C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" to cover an \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Apple\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sweet Berries\"},{\"text\":\" in \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Nectar\"},{\"text\":\". Each product consumes \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect both glazed fruits. Feed ingredients by belt or Depot and keep the nectar tank supplied from the superheated mixing station.\"}]}"
	]
	quest.7124C1585876CE2C.title: "Caramel Selection"
	quest.7124C1585876CE2C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Glaze an \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Apple\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sweet Berries\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Bread\"},{\"text\":\" and a cooked \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Waffle\"},{\"text\":\" with caramel in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\". Each recipe uses \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Caramel\"},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compact another \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB\"},{\"text\":\" in a Basin into a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Caramel Bar\"},{\"text\":\". Collect all five listed products; the bar is also a filling for chocolate candy.\"}]}"
	]
	quest.743CCD7A5A7EBBBC.title: "Candy Canes"
	quest.743CCD7A5A7EBBBC.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Heat-mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"two Sugar\"},{\"text\":\", a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Slimeball\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Mundane Potion\"},{\"text\":\" to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"four Candy Canes\"},{\"text\":\". Use the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mundane\"},{\"text\":\" potion variant.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save extra canes for the optional tool set and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"The Bright Side\"},{\"text\":\" music disc. Both branches use candy canes as crafting ingredients.\"}]}"
	]
	quest.7A74A9EC566C83D9.title: "Gingerbread Workshop"
	quest.7A74A9EC566C83D9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Cinder Flour\"},{\"text\":\", \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Wheat Flour\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Honey\"},{\"text\":\" into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ginger Dough\"},{\"text\":\". This mixing step does not require heat.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Put the dough beneath a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mechanical Press\"},{\"text\":\" to make a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Gingerbread Man\"},{\"text\":\". Keep this pressing station separate from the Basin used to compact chocolate bars.\"}]}"
	]
	quest.7FDC23B190994F01.title: "Milk Chocolate Selection"
	quest.7FDC23B190994F01.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Feed \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"250 mB Chocolate\"},{\"text\":\" to a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" for each apple, sweet berry, marshmallow, bread roll or waffle you want to coat. Place the ingredient on a Depot or belt below it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Compact 250 mB\"},{\"text\":\" in a Basin with a Mechanical Press to make a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Chocolate Bar\"},{\"text\":\". Include the Full \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Chocolate Bar\"},{\"text\":\" and collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"all seven\"},{\"text\":\" listed treats.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"For waffles, mix \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sugar + Dough + Egg + 250 mB Milk\"},{\"text\":\" with heat into Cake Paste. Press the paste into an Uncooked Waffle, then cook it in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Smoker\"},{\"text\":\" before glazing.\"}]}"
	]
	chapter.6851CE0538D34B44.title: "{\"text\":\"Ancient Beasts\",\"color\":\"#D4CDBE\",\"bold\":false}"
	quest.67FF456831384B70.title: "Brush Excavation"
	quest.67FF456831384B70.quest_desc: [
		"The left branch groups eggs found with a Brush in each species' dedicated structure: Sniffer, Eater, Crusher, Glider, Surfer, Charger, Raider and Snatcher."
		"Brush suspicious sand, suspicious red sand and suspicious gravel. The Chisel branch on the right covers Walker and Soarer eggs in Suspicious Ice."
		"Keep an egg in your inventory until its quest registers, then hatch it. Each species keeps its structure, egg, skull, related items and mechanics quests."
	]
	quest.6FA9CB4EE2084F57.title: "Chisel Excavation and Field Kit"
	quest.6FA9CB4EE2084F57.quest_desc: [
		"Craft a Chisel, Paleo Table and Nest. Use the Chisel on Suspicious Ice to excavate Walker eggs at Ice Spike Castles and Soarer eggs at Ancient Nests."
		"A Brush does not excavate Suspicious Ice. Use the Chisel repeatedly on the block, then collect the find."
		"The Paleo Table duplicates pottery sherds using bricks and switches eggs between living and decorative forms using a Chisel. Keep a Nest ready for living eggs."
	]
	quest.60B2080F93134E19.title: "Living Eggs or Museum Pieces?"
	quest.60B2080F93134E19.quest_desc: [
		"Place a living egg to hatch it, or use it on a Nest. Decorative eggs do not hatch: check the tooltip before you wait."
		"Use an egg with a Chisel at the Paleo Table to switch its decorative state. Using a Chisel on an occupied Nest makes its eggs decorative."
		"Keep the area loaded while eggs hatch. This diamond is a reading hint; mark it after reading."
	]
	quest.65F5D75FE12D4BF7.title: "The Shared Fossil Grounds"
	quest.65F5D75FE12D4BF7.quest_desc: [
		"Digsites are an alternative, mixed source of ancient eggs, all ten skulls, Eater Teeth, Glider Feathers and Crusher Spikes."
		"Choose the tool by the block: a Brush for suspicious sand, red sand or gravel; a Chisel for Suspicious Ice. Mountain and Ice Spikes Digsites use Suspicious Ice."
		"The two main branches group species by the tool used at their dedicated structures. Mixed Digsites can yield eggs from either group, so carry both tools."
	]
	quest.66CC122E8FE64FBB.title: "Digging Deals"
	quest.66CC122E8FE64FBB.quest_desc: [
		"Trade with a wandering Paleontologist to earn Digging Deals. Bring emeralds and inspect the available trades and exploration maps."
	]
	quest.60E60E56D144406B.title: "A Better Excavation"
	quest.60E60E56D144406B.quest_desc: [
		"Egg Thief improves the chance of finding eggs when brushing. Treasure Hunter improves archaeological loot, while Preservation reduces the brushing needed."
		"A Brush is still for suspicious sand and gravel; Suspicious Ice needs a Chisel. Use the enchanting equipment available in this pack and mark this reading hint after reviewing the options."
	]
	quest.6F9218BABA904FDE.title: "Sniffer: Ocean Ruins"
	quest.6F9218BABA904FDE.quest_desc: [
		"Explore warm or cold Ocean Ruins. Both variants count in this pack."
		"Bring a Brush: this structure's egg finds are inside suspicious sand or gravel. Enter the structure and wait briefly for automatic detection."
	]
	quest.653824CE62184965.title: "Sniffer Egg"
	quest.653824CE62184965.quest_desc: [
		"Use a Brush on suspicious sand or gravel at Ocean Ruins to find the Sniffer Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.61DCE424809345C2.title: "Sniffer Skull"
	quest.61DCE424809345C2.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.6E6BA845248A463C.title: "Seeds from Another Age"
	quest.6E6BA845248A463C.quest_desc: [
		"Let an adult Sniffer dig on suitable ground. Ancient Beasts adds Rafflesia, Sundew and Equisetum seeds to its possible finds; collect all three."
	]
	quest.649F66690CA446B3.title: "More than Ancient Seeds"
	quest.649F66690CA446B3.quest_desc: [
		"Sniffers can also dig up Bellflower seeds, Moonflowers, Amber and Verdant Ginkgo seeds, and Olden Moss. Give one space to roam and dig."
		"Rafflesia has another use: it can put a calm Crusher to sleep when its sleep cooldown is ready. Mark this hint after reading."
	]
	quest.6ACF171CFAF04F23.title: "Eater: Mesa Temple"
	quest.6ACF171CFAF04F23.quest_desc: [
		"Search the badlands for a Mesa Temple. Both large and small temples count."
		"Bring a Brush: this structure's egg finds are inside suspicious red sand. Enter the structure and wait briefly for automatic detection."
	]
	quest.69D0959BFC184A05.title: "Eater Egg"
	quest.69D0959BFC184A05.quest_desc: [
		"Use a Brush on suspicious red sand at Mesa Temple to find the Eater Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.690885A8221F471E.title: "Eater Skull"
	quest.690885A8221F471E.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.633A0DB46CD54533.title: "Teeth and an Ancient Club"
	quest.633A0DB46CD54533.quest_desc: [
		"Find an Eater Tooth and craft an Ancient Club from teeth, planks and a stick. Collect a Jaw Pottery Sherd from Mesa Temple archaeology. Teeth can also be found at Digsites."
	]
	quest.6680F4E9A0D243AC.title: "Don't Move a Muscle"
	quest.6680F4E9A0D243AC.quest_desc: [
		"Experience the Fear effect from an Eater. Fear stops normal movement, so prepare a retreat before approaching."
		"An Eater can destroy an ordinary shield; a Reinforced Shield survives that special shield-breaking attack. Raw Ancient Meat gives an Eater the Alpha effect."
	]
	quest.6AAF0E1C4A9A49A1.title: "Walker: Ice Spike Castle"
	quest.6AAF0E1C4A9A49A1.quest_desc: [
		"Search the Ice Spikes biome for an Ice Spike Castle."
		"Bring a Chisel: this structure's egg finds are inside Suspicious Ice. Enter the structure and wait briefly for automatic detection."
	]
	quest.6829D7D6A40343AD.title: "Walker Egg"
	quest.6829D7D6A40343AD.quest_desc: [
		"Use a Chisel on Suspicious Ice at Ice Spike Castle to find the Walker Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.6CC3749907474F8B.title: "Walker Skull"
	quest.6CC3749907474F8B.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.6366F04A6C4940AF.title: "A Walking Caravan"
	quest.6366F04A6C4940AF.quest_desc: [
		"Prepare a Chest and Saddle for your Walker, then collect a Stroll Pottery Sherd from Ice Spike Castle archaeology. The chest makes this giant useful for hauling supplies."
	]
	quest.6B5014B2199B4915.title: "Strolling Storage"
	quest.6B5014B2199B4915.quest_desc: [
		"Tame a baby Walker with Spore Blossoms before it grows up. Azalea leaves help feed and grow it."
		"Equip your Walker with a Chest to earn Strolling Storage. Keep Spore Blossoms for breeding adults as well."
	]
	quest.62919BB6A6224201.title: "Crusher: Desert Ruins"
	quest.62919BB6A6224201.quest_desc: [
		"Explore deserts for the Ancient Beasts Desert Ruins. Both ruin sizes count; this is not the vanilla Desert Pyramid."
		"Bring a Brush: this structure's egg finds are inside suspicious sand. Enter the structure and wait briefly for automatic detection."
	]
	quest.62FBEB2169584618.title: "Crusher Egg"
	quest.62FBEB2169584618.quest_desc: [
		"Use a Brush on suspicious sand at Desert Ruins to find the Crusher Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.61F97EF3E07A4651.title: "Crusher Skull"
	quest.61F97EF3E07A4651.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.693D27FF55B74811.title: "Spikes and a Stronger Shield"
	quest.693D27FF55B74811.quest_desc: [
		"Collect a Crusher Spike and Spike Pottery Sherd. Upgrade a Shield at a Smithing Table with a Crusher Spike and Ancient Upgrade Smithing Template to make a Reinforced Shield."
	]
	quest.6287D148BA4E4E2E.title: "A Sleeping Recycling Machine"
	quest.6287D148BA4E4E2E.quest_desc: [
		"Use Rafflesia on a calm Crusher when its sleep cooldown is ready. While it sleeps, right-click it with an item supported by the Crusher Crushing recipes in JEI to recycle it."
		"Repeated recycling may wake it and make it attack. A Chisel can harvest a spike, with about five minutes between harvests; taking one can provoke it. Mark this reading hint when ready."
	]
	quest.60A2E2D6226748B2.title: "Glider: Abandoned Village"
	quest.60A2E2D6226748B2.quest_desc: [
		"Explore jungles for the Ancient Beasts Abandoned Village."
		"Bring a Brush: this structure's egg finds are inside suspicious gravel. Enter the structure and wait briefly for automatic detection."
	]
	quest.68F3F8BC3C884D22.title: "Glider Egg"
	quest.68F3F8BC3C884D22.quest_desc: [
		"Use a Brush on suspicious gravel at Abandoned Village to find the Glider Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.6E997FC5C0444CD2.title: "Glider Skull"
	quest.6E997FC5C0444CD2.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.6F2364AECD524601.title: "Feathers into Flight"
	quest.6F2364AECD524601.quest_desc: [
		"Collect a Glider Feather and Fall Pottery Sherd, then craft a Hang Glider from feathers and sticks. Dancing Gliders can drop feathers, and Digsites offer another source."
	]
	quest.675D9C247D894506.title: "Funky Moves"
	quest.675D9C247D894506.quest_desc: [
		"Tame a Glider with Pufferfish; Salmon is its breeding food."
		"Play a music disc in a nearby Jukebox and let it dance. Dancing Gliders occasionally shed feathers, giving you a renewable source for Hang Gliders."
	]
	quest.6B549B47849043CF.title: "Soarer: Ancient Nest"
	quest.6B549B47849043CF.quest_desc: [
		"Search mountain peaks and slopes for an Ancient Nest."
		"Bring a Chisel: this structure's egg finds are inside Suspicious Ice. Enter the structure and wait briefly for automatic detection."
	]
	quest.6444809C880F4D2B.title: "Soarer Egg"
	quest.6444809C880F4D2B.quest_desc: [
		"Use a Chisel on Suspicious Ice at Ancient Nest to find the Soarer Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.6F1ACDF6D47C432F.title: "Soarer Skull"
	quest.6F1ACDF6D47C432F.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.6423977178E049BC.title: "Supplies for a Sky Mount"
	quest.6423977178E049BC.quest_desc: [
		"Catch a Toxlacanth in a water bucket, prepare a Saddle and collect a Beak Pottery Sherd from Ancient Nest archaeology. Keep the fish for your Soarer."
	]
	quest.6F007AF42C044817.title: "First Flight"
	quest.6F007AF42C044817.quest_desc: [
		"Feed a Soarer Toxlacanth to tame it, then equip a Saddle and fly. Pufferfish are used to breed tamed adults."
		"Check the Ancient Beasts Special Ability binding in Controls when learning to use your mounts."
	]
	quest.68BDFF26AB094065.title: "Surfer: Dead Coral"
	quest.68BDFF26AB094065.quest_desc: [
		"Search stony shores for the Dead Coral structure."
		"Bring a Brush: this structure's egg finds are inside suspicious gravel. Enter the structure and wait briefly for automatic detection."
	]
	quest.6EB99977089F41DB.title: "Surfer Egg"
	quest.6EB99977089F41DB.quest_desc: [
		"Use a Brush on suspicious gravel at Dead Coral to find the Surfer Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.61A8B054EDF74523.title: "Surfer Skull"
	quest.61A8B054EDF74523.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.60D30FD181B8472F.title: "Armor for the Water"
	quest.60D30FD181B8472F.quest_desc: [
		"Craft Surfer Armor from Turtle Scutes, collect a Sea Pickle for breeding, and find a Tide Pottery Sherd at Dead Coral."
	]
	quest.696F84144B8C43EF.title: "Maximum Splash"
	quest.696F84144B8C43EF.quest_desc: [
		"Ride a Surfer and perform a jump at maximum power. Watch its oxygen when using its Special Ability."
		"Coral fans change its variant. Naming one silver reveals a special appearance; these are additional discoveries to try after your first jump."
	]
	quest.64A45C8BF7CA404B.title: "Charger: Ruined Castle"
	quest.64A45C8BF7CA404B.quest_desc: [
		"Search plains for a Ruined Castle."
		"Bring a Brush: this structure's egg finds are inside suspicious gravel. Enter the structure and wait briefly for automatic detection."
	]
	quest.678A36EAB91E4812.title: "Charger Egg"
	quest.678A36EAB91E4812.quest_desc: [
		"Use a Brush on suspicious gravel at Ruined Castle to find the Charger Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.6CC56AAC09794596.title: "Charger Skull"
	quest.6CC56AAC09794596.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.6AF6AC0334434174.title: "Armored Cavalry"
	quest.6AF6AC0334434174.quest_desc: [
		"Craft Red Charger Armor, gather Sweet Berries and collect a Horns Pottery Sherd from the Ruined Castle. Sweet Berries improve its temper and heal it."
	]
	quest.6804F50045C54CC8.title: "Charge!"
	quest.6804F50045C54CC8.quest_desc: [
		"Improve a Charger's temper with Sweet Berries, tame it by riding, and equip a Saddle. Use its Special Ability to charge into a target."
		"Glow Berries are used for breeding. Beetroot can provoke a Charger, so keep it out of your hands when approaching a wild one."
	]
	quest.6AB2E65CD61C408D.title: "Raider: Training Outpost"
	quest.6AB2E65CD61C408D.quest_desc: [
		"Search plains for a Training Outpost. Expect pillagers around the structure."
		"Bring a Brush: this structure's egg finds are inside suspicious gravel. Enter the structure and wait briefly for automatic detection."
	]
	quest.61200C6319864E5F.title: "Raider Egg"
	quest.61200C6319864E5F.quest_desc: [
		"Use a Brush on suspicious gravel at Training Outpost to find the Raider Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.661721C992454DE3.title: "Raider Skull"
	quest.661721C992454DE3.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.6C44E80A32234DD2.title: "Three Ancient Calls"
	quest.6C44E80A32234DD2.quest_desc: [
		"Collect a Raider Horn and Loot Pottery Sherd, then craft all three horn upgrades. Fearsome uses Eater Teeth, Shrieking uses Echo Shards and Spectral uses Phantom Membranes; check JEI for the full recipes."
	]
	quest.6017A199911B4706.title: "We Friends Now?"
	quest.6017A199911B4706.quest_desc: [
		"Offer Raw Ancient Meat to an aggressive Raider to pacify it. This earns We Friends Now?"
		"Try blowing all three upgraded horns for the separate Thunder Roar advancement."
	]
	quest.6F8B9A41841D46D2.title: "Snatcher: Primal Log"
	quest.6F8B9A41841D46D2.quest_desc: [
		"Explore old-growth forests and taigas for a Primal Log."
		"Bring a Brush: this structure's egg finds are inside suspicious gravel. Enter the structure and wait briefly for automatic detection."
	]
	quest.66677790E766404B.title: "Snatcher Egg"
	quest.66677790E766404B.quest_desc: [
		"Use a Brush on suspicious gravel at Primal Log to find the Snatcher Egg."
		"Keep the egg in your inventory until this quest registers, then place it or put it in a Nest. Decorative eggs must be made living at the Paleo Table before they can hatch."
		"Mixed Digsites are an alternative source. There, choose the tool by the suspicious block rather than the egg species."
	]
	quest.614AE44602DC4AB5.title: "Snatcher Skull"
	quest.614AE44602DC4AB5.quest_desc: [
		"Find this skull in Digsite archaeology and add it to your collection. Any Digsite biome or size can supply skulls; the finds are random."
		"This is a collection task. The skull stays in your inventory, and you can display it in a museum."
	]
	quest.602B8C0345954060.title: "A Tiny Porter"
	quest.602B8C0345954060.quest_desc: [
		"Prepare a Barrel and Poisonous Potato, then collect a Steal Pottery Sherd from Primal Log archaeology. Poisonous Potatoes are the Snatcher's breeding food."
	]
	quest.6380F1EFF2574E9A.title: "Swiper, Do Swipe"
	quest.6380F1EFF2574E9A.quest_desc: [
		"With your own Snatcher, sneak and interact using a Barrel to equip its storage. Interact without sneaking to take it onto your shoulders."
		"Use a Snatcher to steal from a loot chest to earn its theft advancement. Try a fresh structure chest that still contains generated loot."
	]
	quest.6A874DE5A29C4E2E.title: "Home Museum"
	quest.6A874DE5A29C4E2E.quest_desc: [
		"Complete the ten skull quests and collect every species for the Home Museum advancement. Build a display for your collection."
	]
	quest.6E0C8DDAC2A940B6.title: "Life Will Find a Way"
	quest.6E0C8DDAC2A940B6.quest_desc: [
		"Raise and breed all ten ancient species, including the Sniffer. Different species need different foods: use the mechanics hints and experiment with the supplies in their rows."
	]
	image.6A7D559001E8444F.title: "{\"text\":\"WAN\\u0027S ANCIENT BEASTS\",\"color\":\"#D4CDBE\",\"bold\":true}"
	image.62698633DEAD485F.title: "{\"text\":\"Choose the excavation tool. Follow each beast from its structure to its discoveries.\",\"color\":\"#D4CDBE\",\"bold\":false}"
