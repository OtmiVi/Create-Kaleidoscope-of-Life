	quest.324B7881A70D6BEA.title: "On the Payroll"
	quest.325643FC0C0B7A5C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Wear a \"},{\"text\":\"Straw Hat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and break grass until you find \"},{\"text\":\"Tea Seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Grow tea plants and \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Fresh Tea Leaves\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Drying\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the leaves is the next step toward brewing your first cup.\"}]}"
	]
	quest.325643FC0C0B7A5C.title: "A Tea Garden"
	quest.3260161847AC90E1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"smoke\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when harvesting an \"},{\"text\":\"occupied hive\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.3260161847AC90E1.title: "A Garden for Neighbors"
	quest.32A17B74B48E31B9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Capture\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Ghast\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with an Empty \"},{\"text\":\"Brass Chunk Loader\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then supply rotation and set its loaded range on the value panel.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"larger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"range\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs faster rotation. \"},{\"text\":\"Brass\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" loaders also work on contraptions, where they load a \"},{\"text\":\"3 x 3\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" area without a shaft connection.\"}]}"
	]
	quest.32A63BAA8A5F61AD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Auto-Landing Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" provides automatic landing for your rocket. Include it in the rocket's \"},{\"text\":\"glued structure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before assembly.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Give the destination a \"},{\"text\":\"clear landing area\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and keep the controls reachable. Automatic landing is useful when bringing a heavier rocket down with valuable cargo.\"}]}"
	]
	quest.32A63BAA8A5F61AD.title: "A Softer Landing"
	quest.32B261048B074E97.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Grow your \"},{\"text\":\"Tomato Seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Tomatoes.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a supply for \"},{\"text\":\"Scrambled Eggs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Tomatoes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Borscht and rice bowls.\"}]}"
	]
	quest.32B261048B074E97.title: "Red Harvest"
	quest.32DBFC50EF2DA03A.quest_desc: [
