		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Blaze Enchanter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": Enchantment Industry to enchant equipment.\"}]}"
		"{\"text\":\"Open the Blaze Enchanter quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7AEE5B1EC5B455A4\"}}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Tick the checkmark once you have read this.\"}]}"
	]
	quest.31F52CD7E69B4517.title: "Enchanting Has Moved"
	quest.31F6B24DF0F03C1B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep your \"},{\"text\":\"armour\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipped during exploration and check its \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after combat. Compare protection with your current equipment before replacing a piece.\"}]}"]
