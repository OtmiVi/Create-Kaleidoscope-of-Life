	quest.3467CE92D0994FE3.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a hoe on soil under \"},{\"text\":\"water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to create paddy \"},{\"text\":\"farmland\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Plant Wild Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and let it mature before harvesting \"},{\"text\":\"Rice Panicles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Complete both the flooded-\"},{\"text\":\"farmland\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"-harvest advancements for this quest.\"}]}"
	]
	quest.3467CE92D0994FE3.title: "A Paddy and Its First Harvest"
	quest.34B331B2581F1480.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Complete the \"},{\"text\":\"Shifting Gears Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect small and large cogwheels to change a rotation network. Use the advancement screen for its exact trigger and \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to inspect gear ratios.\"}]}"
	]
	quest.34B331B2581F1480.title: "Change Gear Ratios"
	quest.34B7A2BBC02333B1.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use it at a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Smithing Table\"},{\"text\":\" to make blaze-powered enchanting equipment.\"}]}"
	]
	quest.34B7A2BBC02333B1.title: "Smithing Template"
	quest.34E093D3D00D4C04.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep your \"},{\"text\":\"armour\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipped during exploration and check its \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after combat. Compare protection with your current equipment before replacing a piece.\"}]}"]
	quest.34E093D3D00D4C04.title: "Netherite armor"
	quest.3570B278EDEB55A4.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Solar Panel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" converts sunlight into \"},{\"text\":\"rotational power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Place it where it can receive sunlight and connect its shaft to the machinery you want to run.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Solar conditions vary between destinations and over time. Check the available output before relying on it for \"},{\"text\":\"life support\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or a remote processing line.\"}]}"
	]
	quest.3570B278EDEB55A4.title: "Let the Sun Turn the Shaft"
	quest.3573B0C3B203FBC9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an \"},{\"text\":\"Echo Cake Base\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Molten Echo\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" under a Spout to finish an Echo Cake.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Supply the base from \"},{\"text\":\"heated\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" compacting and keep the filling step connected to your molten-\"},{\"text\":\"echo\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" line.\"}]}"
	]
	quest.3573B0C3B203FBC9.title: "Echo Cake"
	quest.3611499E0688C333.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Computer Rack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" stores \"},{\"text\":\"Targeting Computers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to reduce your rocket's \"},{\"text\":\"fuel cost\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Include the rack in the rocket structure and load computers into it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Rocket Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to review the trip after fitting the rack. Fuel savings are useful on longer routes and leave more room for a return reserve.\"}]}"
	]
	quest.3611499E0688C333.title: "A More Efficient Flight"
	quest.3653A4F5DEB5848D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Coronation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Peony Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.3653A4F5DEB5848D.title: "Coronation"
	quest.3699113CF194603C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Press \"},{\"text\":\"iron ingots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into sheets. Save them for \"},{\"text\":\"machinery\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", fans and other workshop components.\"}]}"]
	quest.3699113CF194603C.title: "Iron Sheet"
	quest.369A0BBDBC1EA479.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Redstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" lets you control machines with levers, \"},{\"text\":\"signals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and sensors. Keep spare dust for workshop controls.\"}]}"]
	quest.369A0BBDBC1EA479.title: "Redstone Dust"
	quest.36A95B3D32196640.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Blasts ores and metal \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"automatic input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in its settings. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.36C73ED6CE9A478B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" entering or leaving the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.370DF11CB7CA9B1D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Wooden and Metal Brackets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" decorate workshop machinery. Use them to support the appearance of a finished \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or pipe run.\"}]}"]
	quest.370DF11CB7CA9B1D.title: "Wooden and Metal Brackets"
	quest.37673ABCE02F2D8C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smelt raw iron and keep a small reserve for buckets, \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the first \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" components.\"}]}"]
	quest.37673ABCE02F2D8C.title: "First iron"
	quest.377F0737509A1E40.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"This engine belongs to the portable equipment branch.\"}]}"
	]
	quest.377F0737509A1E40.title: "Hydraulic Engine"
	quest.37AEDAA5DCD73DFB.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an \"},{\"text\":\"Oil Can\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Oil\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use it on a Wok before adding ingredients.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Watch the \"},{\"text\":\"amount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" remaining in its tooltip and keep a refill near the \"},{\"text\":\"stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.37AEDAA5DCD73DFB.title: "An Oil Can for the Cook"
	quest.37B07006A3AB1EA0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Colorful Pipes\"},{\"text\":\" adds colored versions of \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Fluid Pipes\"},{\"text\":\" and \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Fluid Tanks\"},{\"text\":\", as well as pumps, valves, spouts, drains and other compatible copper machinery.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"pipe or tank\"},{\"text\":\" with a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Dye\"},{\"text\":\" in crafting to recolor it. Match each line to its contents: blue for water, white for milk, brown for chocolate.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Color is a visual guide. Keep different fluids in separate tanks and use \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Smart Fluid Pipes\"},{\"text\":\" when a line needs a filter. Mark this tip complete after reading.\"}]}"
	]
	quest.37B07006A3AB1EA0.title: "Color Your Fluid Network"
	quest.37BBD0F69107DDD9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"toasted\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" flower-cake recipe uses the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"Raw Flower Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" available for the branch and check the finished cake's tooltip before choosing when to eat it.\"}]}"
	]
	quest.37BBD0F69107DDD9.title: "Toasted Flower Cake"
	quest.37C8B239F69E5EB7.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Find a \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". This mod adds \"},{\"text\":\"reputation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", dialogue, hired workers and building.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Start with \"},{\"text\":\"Talk\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then follow the trust and work branches.\"}]}"
	]
	quest.37C8B239F69E5EB7.title: "Meet the Village"
	quest.37DDCD82AF641961.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smelt \"},{\"text\":\"zinc ore\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into ingots. \"},{\"text\":\"Zinc\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is useful for this equipment branch and later for \"},{\"text\":\"Brass\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" production.\"}]}"]
	quest.37DDCD82AF641961.title: "Zinc Ingot"
	quest.380016CD84BA8750.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Pink Petals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Cherry Grove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.381A43D155C8D44B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Put an ingredient on a \"},{\"text\":\"Chopping Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and cut it with a \"},{\"text\":\"Cookery\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" kitchen knife.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Four cuts turn a \"},{\"text\":\"Raw Porkchop\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into three \"},{\"text\":\"Raw Pork Bellies\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can also be cut into \"},{\"text\":\"Raw Noodles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", so keep the board near your other cookware.\"}]}"
	]
	quest.381A43D155C8D44B.title: "A Place to Chop"
	quest.384D57C7926A4C21.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Dark Oak Log\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Dark Forest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.3856839706A473A7.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Echo Shards\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in \"},{\"text\":\"Ancient City\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" loot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save it for the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Echo Create\"},{\"text\":\" processing chain. The \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heated\"},{\"text\":\" recipes use \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Create\"},{\"text\":\" machinery.\"}]}"
	]
	quest.3856839706A473A7.title: "Echo Shard"
	quest.3858CBA666869D72.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Complete a \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" trade using the \"},{\"text\":\"Trade\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" option.\"}]}"]
	quest.3858CBA666869D72.title: "A Fair Trade"
	quest.390F1880AC24A74B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Complete the \"},{\"text\":\"Starcatcher\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" guide collection by catching every listed catch at least once. This unlocks the chance to fish up the \"},{\"text\":\"Trophy\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the \"},{\"text\":\"Older Angler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.390F1880AC24A74B.title: "Master Angler"
	quest.3942FC6D7F2EABD0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Copper\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Diamond\"},{\"text\":\" tier.\"}]}"
	]
	quest.39D1726E5BE6F828.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Glue the \"},{\"text\":\"Thrusters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", fuel tanks, \"},{\"text\":\"Seat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and \"},{\"text\":\"Rocket Controls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into one rocket structure. Fit the Titanium Space Door as your entrance and keep the controls accessible from the seat.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill the tanks before assembly, then check the \"},{\"text\":\"Rocket Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for fuel and heat shielding. Required thrust depends on the rocket\u0027s \"},{\"text\":\"size and weight\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Metal blocks can increase \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heat shielding\"},{\"text\":\". Sit down and use the Rocket Controls to launch once the route and supplies are ready.\"}]}"
	]
	quest.39D1726E5BE6F828.title: "Ready for Liftoff"
	quest.39F6DE533381DD03.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this downgrade to reduce stack \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It is useful when you want smaller buffers or tighter limits on stored \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.3A2EF8EBEDB90C22.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Ghast\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with an Empty Andesite Chunk Loader to capture it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the filled loader with rotation to keep its current chunk loaded. \"},{\"text\":\"Slow\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rotation will not activate it; a comparator can report whether it is working.\"}]}"
	]
	quest.3A80D70586C1874B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Dirt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Plains\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.3A82935B7E8B652F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Temperature Regulator\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" changes the temperature of its surroundings. \"},{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it to open its configuration and set the temperature needed by your setup.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place an \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ice Box\"},{\"text\":\" within the regulated area for freezing and condensation recipes. Connect the required fluid inputs and outputs.\"}]}"
	]
	quest.3A82935B7E8B652F.title: "Control the Cold"
	quest.3A9FDA6CBEEF79B0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Sandstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Desert Pyramid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.3AA7EA5DAD1AE8FB.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Breed\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an animal.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Later\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", try the \"},{\"text\":\"Animal Handling\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" work role.\"}]}"
	]
	quest.3AA7EA5DAD1AE8FB.title: "Neighbors of Every Kind"
	quest.3AB64A78FB2701A8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Ice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Ice Spikes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.3AE82A5CE3BA0BA5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Have\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ten \"},{\"text\":\"villagers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" working in different roles with valid storage and payment.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Clipboard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to fix idle jobs.\"}]}"
	]
	quest.3AE82A5CE3BA0BA5.title: "A Well-Oiled Village"
	quest.3AFF12DA0AD60F58.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Provides a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.3B24329B4B8B46A8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mix copper and zinc in a heated \"},{\"text\":\"Basin\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make \"},{\"text\":\"Brass\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep your \"},{\"text\":\"Blaze Burner\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" fueled while the mixer runs.\"}]}"]
	quest.3B24329B4B8B46A8.title: "Brass Ingot"
	quest.3BE2128BFCE72092.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Titanium Trapdoor\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" gives you a compact hatch for a rocket or station. Place it where you can still reach the cabin and its controls.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Include it in the \"},{\"text\":\"glued structure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when fitting it to a rocket. Test the entrance before assembly so you can board without removing blocks.\"}]}"
	]
	quest.3BE2128BFCE72092.title: "Another Way Into the Cabin"
	quest.3C98262462D5A221.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Selling Bin\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use its interface to check which catches can be sold.\"}]}"]
	quest.3C98262462D5A221.title: "Sell the Surplus"
	quest.3C9ECE6486F81907.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Mechanical Grindstones\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to process \"},{\"text\":\"Nuggets of Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", or deposit your own \"},{\"text\":\"experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through an \"},{\"text\":\"Experience Hatch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Collect the liquid in storage and fill a bucket with a \"},{\"text\":\"Spout\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.3C9ECE6486F81907.title: "Bucket o' Enchanting"
