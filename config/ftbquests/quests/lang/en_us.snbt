		"{\"text\":\"\",\"extra\":[{\"text\":\"Break\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" grass while wearing a \"},{\"text\":\"Straw Hat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to find Chili Seeds.\"}]}"
