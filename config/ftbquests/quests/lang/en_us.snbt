	quest.0B5F2F864AA804F9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Rocket Waypoint\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at a prepared landing site, then \"},{\"text\":\"right-click it with a Space Atlas\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to record its coordinates.\"}]}"
