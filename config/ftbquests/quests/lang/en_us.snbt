	quest.663ABDA70E76261B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a spare \"},{\"text\":\"Blaze Enchanter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": this hidden advancement destroys the machine.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Work\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" under an open sky with no exposed \"},{\"text\":\"Lightning Rod\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" within \"},{\"text\":\"128 blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Supply \"},{\"text\":\"Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and feed the enchanter a \"},{\"text\":\"Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" o' Enchanting to activate Super Enchanting mode.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Set an equipment item in its \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" slot, choose an enchanting level, and start processing a \"},{\"text\":\"Super Enchanting Template\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Without a rod to catch the lightning, the enchanter is destroyed and replaced by a lit \"},{\"text\":\"Blaze Burner\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", granting \"},{\"text\":\"OSHA Violation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
