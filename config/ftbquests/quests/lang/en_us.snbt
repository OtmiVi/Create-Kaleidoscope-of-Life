	quest.0C9B6DB67E464948.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Limited Barrels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dedicate a small number of slots to bulk item \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Choose a layout that matches your workshop's main materials.\"}]}"]
	quest.0D4174672201A7EA.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Labels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" areas easier to recognize. Keep labels consistent across raw materials, processed components and expedition supplies.\"}]}"]
	quest.0D4922724DA846AF.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.0D71D46CD540A033.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Raise\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" every \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" skill to maximum through successful work.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use different roles and check the \"},{\"text\":\"Skills\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" panel.\"}]}"
	]
	quest.0D71D46CD540A033.title: "Master of All Trades"
	quest.0DA7DEABAA66F7D3.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Shortens\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the wait and makes \"},{\"text\":\"legendary fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" more likely to bite.\"}]}"]
	quest.0DA7DEABAA66F7D3.title: "Something Legendary"
	quest.0DD8F486B6DBB504.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Basic\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Gold\"},{\"text\":\" tier.\"}]}"
	]
	quest.0DDC839D3E3C7052.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Share\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" five discovered \"},{\"text\":\"stories\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with villagers.\"}]}"]
	quest.0DDC839D3E3C7052.title: "Keep the Stories Alive"
	quest.0DEE0F0A32566514.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Loves Me Not\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Oxeye Daisy Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.0DEE0F0A32566514.title: "Loves Me Not"
	quest.0E19B7FD3C6ADBFD.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Hold The \"},{\"text\":\"Sunward's\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" day form from sunrise to sunset of one day\"}]}"]
	quest.0E19B7FD3C6ADBFD.title: "Kuafu Chases the Sun"
	quest.0E76A85ED049A798.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hold \"},{\"text\":\"Raw Dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and keep right-click pressed to stretch it into \"},{\"text\":\"Raw Noodles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Alternatively\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", place dough on a \"},{\"text\":\"Chopping Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and cut it four times with a kitchen knife to get three \"},{\"text\":\"Raw Noodles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the noodles for the \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" collection.\"}]}"
	]
	quest.0E76A85ED049A798.title: "Pull Your Own Noodles"
	quest.0E76A99BEAA3A310.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach Fishing Nets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a moving \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" so they pass through open \"},{\"text\":\"water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". The nets catch fish and other \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" along the route; leave storage space aboard for the catch.\"}]}"]
	quest.0E76A99BEAA3A310.title: "Fishing Net"
	quest.0E7ACA21FF037AE7.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" together in a \"},{\"text\":\"Seed Pouch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" while tending your farm. Open its tooltip for the pouch controls.\"}]}"]
	quest.0EB72C4C224E6FD9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Sneak\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and throw a \"},{\"text\":\"Baozi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at a wolf that is missing \"},{\"text\":\"health\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to heal it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"This completes the base \"},{\"text\":\"Cookery Baozi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement. A good meal is better when shared.\"}]}"
	]
	quest.0EB72C4C224E6FD9.title: "Share a Bun"
	quest.0EC16E0ECEE17670.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Belt Connector\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between aligned shafts to create a moving \"},{\"text\":\"belt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Add an \"},{\"text\":\"Andesite Funnel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to transfer \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between the belt and storage.\"}]}"]
	quest.0EC16E0ECEE17670.title: "Belts and Andesite Funnels"
	quest.0EC4467B69DBC4C3.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Land\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"dew flower cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shockwave after falling at least twenty blocks\"}]}"]
	quest.0EC4467B69DBC4C3.title: "From the Sky"
	quest.0F5C6BEE74871EF1.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Warp Scroll\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" provides a single-use trip to an activated \"},{\"text\":\"Waystone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use it for a quick return when you want to keep a reusable \"},{\"text\":\"Warp Stone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" available for later.\"}]}"
	]
	quest.0F8081B4F9E742A6.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Combustion Engine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" burns fuel to produce \"},{\"text\":\"rotational power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Pump fuel into the side \"},{\"text\":\"opposite the shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; the engine starts automatically when its requirements are met.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"It also needs an \"},{\"text\":\"oxidizer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Earth's atmosphere can supply it; elsewhere, provide an oxygenated area or feed oxidizer into the \"},{\"text\":\"bottom\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the engine.\"}]}"
	]
	quest.0F8081B4F9E742A6.title: "Power from Liquid Fuel"
	quest.0F8EFABEF34E7C58.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Nether Wart\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" around fortresses and grow it on \"},{\"text\":\"soul\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"sand\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep part of the harvest for brewing.\"}]}"]
	quest.0F8EFABEF34E7C58.title: "How it grow there?"
	quest.0FAD1CEFA42A4CC8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Pulls nearby \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at \"},{\"text\":\"extended range\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.105191606378BB4E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Take the \"},{\"text\":\"Grapplin Whisk\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" along as a movement tool. Check its controls and practice over safe ground before using it above a drop.\"}]}"]
	quest.105191606378BB4E.title: "Grapplin Whisk"
	quest.10A7B9C415B45AC7.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Drowned\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can provide a \"},{\"text\":\"Trident\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Repair\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and enchant it before relying on it during a long ocean expedition.\"}]}"]
	quest.10A7B9C415B45AC7.title: "Trident"
	quest.10B13E3E1F24330D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Oxygen Detector\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" emits a \"},{\"text\":\"redstone signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when the block directly in front of it is oxygenated. Point it at the area you want to monitor.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect the output to a lamp or your outpost's control circuit. The detector checks \"},{\"text\":\"local oxygenation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; inspect the rest of the occupied area before depending on a single reading.\"}]}"
	]
	quest.10B13E3E1F24330D.title: "Check the Air"
	quest.10F4A2976081820E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"This pack makes \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Netherite\"},{\"text\":\" through \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Create\"},{\"text\":\" processing. Prepare the required heated machinery before spending your scrap.\"}]}"
	]
	quest.10F4A2976081820E.title: "Something bether"
	quest.1120591F2096169C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Makes \"},{\"text\":\"undiscovered catches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" more likely, but hitting \"},{\"text\":\"sweet spots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" brings darkness.\"}]}"]
	quest.1120591F2096169C.title: "What Still Hides"
	quest.112A9739A24D2209.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Revived seeds can become \"},{\"text\":\"Mars Tulip\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Mars Palm\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", or \"},{\"text\":\"Mars Sprout\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" seeds. Keep processing dormant seeds if you are still missing a variety.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Plant them in a prepared growing area and keep a sample of each variety. Their \"},{\"text\":\"flowers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" also have uses in this pack's flower-tea recipes.\"}]}"
	]
	quest.112A9739A24D2209.title: "A Martian Garden"
	quest.11A456CC37B24B37.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Start a \"},{\"text\":\"rubber\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tree near your workshop. Keep room for it to grow and save \"},{\"text\":\"saplings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a renewable \"},{\"text\":\"rubber\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply.\"}]}"]
	quest.11A456CC37B24B37.title: "Rubber Sapling"
	quest.11F8FC84B04CA3F0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"After eating a \"},{\"text\":\"blossom mooncake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", swim \"},{\"text\":\"100 blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through the air without touching ground\"}]}"]
	quest.11F8FC84B04CA3F0.title: "I Would Ride the Wind Home"
	quest.12053A64424FE7CB.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Eyes of Ender\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to locate a stronghold. Bring spare eyes to fill its \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" portal frames.\"}]}"]
	quest.12053A64424FE7CB.title: "Lets find him!"
	quest.123F04DB484F183E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Upgrades\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" vanilla inventories to their sophisticated version\"}]}"]
	quest.1261F51007BC60A6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Check the material and mining tier before replacing your current \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and keep spare materials for repairs or replacements.\"}]}"]
	quest.1261F51007BC60A6.title: "Iron tools"
	quest.1283427227AFFD27.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically uses potions, \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with effects, or milk buckets. Use the \"},{\"text\":\"effect filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to control when it activates. Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.12C124C368FEC77F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Circuits\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" connect your workshop to navigation and life support. Their assembly sequence uses \"},{\"text\":\"Polished Amethyst\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", copper and gold sheets, and the \"},{\"text\":\"Circuit Engraver\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the sequence running until the finished circuit appears. An \"},{\"text\":\"Unfinished Circuit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" still needs processing, and the recipe can also produce scrap.\"}]}"
	]
	quest.12C124C368FEC77F.title: "The First Circuits"
	quest.13343B1B393738AE.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.13370391FD9FC71C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Easily\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" makes your tank interactable with \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" containers.\"}]}"]
	quest.13370391FD9FC71C.title: "Fluid Hatch"
	quest.1347F61EAEA71EB8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smokes \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.13530E4C44B87217.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Copper\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" starts the fluid-handling branch of \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Save ingots for sheets, casings and pipes.\"}]}"]
	quest.13530E4C44B87217.title: "Firt copper"
	quest.13FE7D33D4CA6CE7.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Check the material and mining tier before replacing your current \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and keep spare materials for repairs or replacements.\"}]}"]
	quest.13FE7D33D4CA6CE7.title: "Stone tools"
	quest.140D56A08C937664.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"Raw Flower Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside your tea supplies; it starts the flower-cake branch and can also be thrown to pin a creature.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"This starts the flower-cake branch below the tea circle.\"}]}"
	]
	quest.140D56A08C937664.title: "Raw Flower Cake"
	quest.14F8C1786EB82B7A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Breath\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the \"},{\"text\":\"Ancients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the Torchflower Tea Bag in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.14F8C1786EB82B7A.title: "Breath of the Ancients"
	quest.156058C0D44BC892.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Limestone\"},{\"text\":\" for aquatic processing. Check the accepted ingredient variants before processing your supply.\"}]}"
	]
	quest.156058C0D44BC892.title: "Limestone"
	quest.1618A6824FE7FC0B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 2 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 4.\"}]}"
	]
	quest.166ADD5815474FB2.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A sophisticated \"},{\"text\":\"Laser Defense Unit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" that automatically \"},{\"text\":\"Locks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on to a specified \"},{\"text\":\"mob\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" should it come close.\"}]}"]
	quest.166ADD5815474FB2.title: "Basic Guardian Beam Turret"
	quest.16C38A47D457DF54.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Wither\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" skeleton skulls summon the \"},{\"text\":\"Wither\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", whose defeat provides a \"},{\"text\":\"Nether Star\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Plan an arena before starting the fight.\"}]}"]
	quest.16C38A47D457DF54.title: "I kill'd him!"
	quest.16CDD173EBFB1698.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Compacts \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into their \"},{\"text\":\"compressed variants\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using \"},{\"text\":\"2x2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"3x3\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to limit the materials. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.1709E369451C3C1D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Greatly\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" increases reach distance of the wielder. Can be powered with \"},{\"text\":\"Air Pressure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from a \"},{\"text\":\"Backtank\",\"color\":\"#D6B879\",\"bold\":true}]}"]
	quest.1709E369451C3C1D.title: "Extendo Grip"
	quest.181186E256272E35.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build a working \"},{\"text\":\"Grindstone Drain\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a \"},{\"text\":\"Mechanical Grindstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" above it and supply rotation.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Feed an enchanted item through the setup and stay nearby while its \"},{\"text\":\"enchantments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are removed. \"},{\"text\":\"Witnessing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the disenchanting process grants \"},{\"text\":\"Gone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Foil\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.181186E256272E35.title: "Remove Enchantments"
	quest.186DD501F439D1A4.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" item on a \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to record an ingredient combination for one-click cooking later.\"}]}"
