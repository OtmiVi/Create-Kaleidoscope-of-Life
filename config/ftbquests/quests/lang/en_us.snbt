	quest.2681DF99F0075CF6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Catch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at least \"},{\"text\":\"25 fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in total. This trophy can then be fished up.\"}]}"]
	quest.2681DF99F0075CF6.title: "Copper Trophy"
	quest.26A4E6CE696C4E90.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click the Item Drain\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with one grindstone to make a \"},{\"text\":\"Grindstone Drain\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then place the second grindstone above it and supply rotation.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the setup to remove enchantments or turn \"},{\"text\":\"Nuggets of Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into \"},{\"text\":\"Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.26A4E6CE696C4E90.title: "Mechanical Grindstones and Item Drain"
	quest.26F5EDFCE5206941.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mill \"},{\"text\":\"Wheat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a powered \"},{\"text\":\"Create Millstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to obtain Flour.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Turn the \"},{\"text\":\"Flour\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into \"},{\"text\":\"Raw Dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by washing it with an \"},{\"text\":\"Encased Fan\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" blowing through \"},{\"text\":\"water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Place the flour in the washing air stream and let processing finish.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save some \"},{\"text\":\"dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for steamed buns, \"},{\"text\":\"stuffed dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and noodles.\"}]}"
		"{\"text\":\"Open the quest with Create\\u0027s Millstone\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"449A09FC50B32D81\"}}"
		"{\"text\":\"Open the Encased Fan quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0594598C4D16819F\"}}"
	]
	quest.26F5EDFCE5206941.title: "Flour, Water, Possibilities"
	quest.27107D85E82C0F47.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"This is the starting point for the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tier upgrades. Choose a \"},{\"text\":\"barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or chest and leave room for the \"},{\"text\":\"Controller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" network to grow.\"}]}"]
	quest.27B52733B1A5D4E2.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Provides a portable \"},{\"text\":\"Jukebox\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.27D78DD7D9A83968.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Catch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at least \"},{\"text\":\"200 fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in total, including \"},{\"text\":\"10\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" different \"},{\"text\":\"legendary\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" species. Once both requirements are met, this trophy can be fished up.\"}]}"]
	quest.27D78DD7D9A83968.title: "Emerald Trophy"
	quest.284CC02237165EC2.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"perfect catch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" brings one \"},{\"text\":\"extra fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" alongside your catch.\"}]}"]
	quest.284CC02237165EC2.title: "Two on the Line"
	quest.284F81E957681C0B.quest_desc: [
