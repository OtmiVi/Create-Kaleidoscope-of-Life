	quest.000B689515524AB1.quest_desc: ["Compacts items into their compressed variants Only 2x2 recipes Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.00699E41DD5435D6.quest_desc: [
		"Use a Trial Key on a vault to earn Under Lock and Key."
		"Ordinary and ominous vaults use different keys, so match the key to the vault you found."
	]
	quest.00903C87A134D20F.quest_desc: ["Apply this tier upgrade to a matching Gold storage container to raise it to Netherite tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.00943BF6A742C5FD.quest_desc: ["Speeds up bites and favors fish from cherry groves."]
	quest.00943BF6A742C5FD.title: "A Taste of Cherry"
	quest.00ECFF7D7405A921.quest_desc: ["Shafts carry rotation along a straight axis. Use cogwheels or gearboxes when the machine is not in line with the source."]
	quest.00ECFF7D7405A921.title: "Shaft"
	quest.01055F24A8E676D8.quest_desc: ["Complete ominous trial encounters to obtain keys for ominous vaults. Prepare equipment and food before triggering the harder encounter."]
	quest.01406449A26CC04F.quest_desc: ["Use Echo Upgrade Smithing Templates and Echo Ingots to upgrade matching Netherite equipment. Keep enough materials for the complete set."]
	quest.01406449A26CC04F.title: "Echo Sword and Armor"
	quest.0143614D99A39DAB.quest_desc: ["Install this module to automatically switch to a suitable tool from your backpack when interacting with blocks or entities. Configure its filters and check the assigned key for swapping interaction tools."]
	quest.0172930769CA91D7.quest_desc: ["Build a tank for bulk storage, use an Item Drain to empty containers, and place a Spout above items to fill them. Keep different fluids on separate lines."]
	quest.0172930769CA91D7.title: "Fluid Storage, Draining and Filling"
	quest.017D36B7F519B774.quest_desc: [
		"Break grass while wearing a Straw Hat to find Lettuce Seeds, then plant them on farmland."
		"Grow a steady supply for soups and stuffed dough. Watch for caterpillars when harvesting."
	]
	quest.017D36B7F519B774.title: "Leaves for Lunch"
	quest.01965A016BFD347D.quest_desc: [
		"Release a fish from a bucket into your flooded rice field."
		"Fish help the rice grow and grant the Fish-Rice Symbiosis advancement."
	]
	quest.01965A016BFD347D.title: "Fish Among the Rice"
	quest.01B105DD883B7FC1.quest_desc: [
		"Prepare the White Tulip Tea Bag and brew Absolution."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.01B105DD883B7FC1.title: "Absolution"
	quest.01B52BEE22693FA6.quest_desc: ["Crafting table in an upgrade tab Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.0202C5B83CF0C7A2.quest_desc: ["Combine Fishing Rod and Iron Ingot to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Woodland Mansion. Use it again to return to manual control."]
	quest.0242EC18C51E4903.quest_desc: ["Automatically compresses/decompresses items Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.02913910B8BC7B09.quest_desc: ["Install this stack upgrade in the storage to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.02DE6B0AF3ACE4A0.quest_desc: ["Install this stack upgrade in the backpack to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.03139DD7511FF6E8.quest_desc: ["Makes storage pickup items Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.03C14112270873B7.quest_desc: ["Check the material and mining tier before replacing your current tools, and keep spare materials for repairs or replacements."]
	quest.03C14112270873B7.title: "Netherite tools"
	quest.0451FE3705BED077.quest_desc: ["Smoking food in an upgrade tab Automatically pulls/pushes items Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.049404DD6AEF27A7.quest_desc: [
		"Place a Sniffer Egg somewhere safe to hatch."
		"Moss speeds up hatching. Protect the hatchling, then use the companion quest to learn this pack's taming and riding features."
	]
	quest.057CE0DED0A13A8B.quest_desc: ["Smelting in an upgrade tab Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.0594598C4D16819F.quest_desc: ["Power the fan and place the recipe's processing medium in its airflow. Ponder shows washing, smoking, blasting and haunting arrangements."]
	quest.0594598C4D16819F.title: "Encased Fan"
	quest.05A990050BDBB85E.quest_desc: ["Chassis and Stickers attach parts to contraptions; pulleys and gantries move them. Inspect the attachment range before assembling a large moving build."]
	quest.05A990050BDBB85E.title: "Chassis, Pulleys and Gantries"
	quest.05BC17815B49C91C.quest_desc: ["Drink three different flower drinks within one minute"]
	quest.05BC17815B49C91C.title: "Flowers for Wine"
	quest.066471407CC97D8F.quest_desc: [
		"Reach Respected reputation with one villager: 250 points."
		"Use requests, trade, conversation and preferred gifts."
	]
	quest.066471407CC97D8F.title: "Respect Is Earned"
	quest.06DB9A54534E08AB.quest_desc: ["Upgrade Bases are components for functional storage upgrades. Craft only the modules you need, then install them in the storage's upgrade slots."]
	quest.0749C059A711739E.quest_desc: [
		"Gain the Flatulence effect, then sneak to propel yourself upward."
		"Ascend 1900 blocks from your starting position during the flight to complete this pack-adjusted Cookery advancement."
		"Begin at Y = -60 or higher and remain at or below Y = 3200 when completing the ascent."
	]
	quest.0749C059A711739E.title: "Rocket-Powered Digestion"
	quest.07670213AF28B8EF.quest_desc: ["Pin three different creatures within one second"]
	quest.07670213AF28B8EF.title: "Three Blooms at Once"
	quest.07D28195999FC375.quest_desc: ["Check the material and mining tier before replacing your current tools, and keep spare materials for repairs or replacements."]
	quest.07D28195999FC375.title: "Rose Quartz Tools"
	quest.0833150753998783.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.0833150753998783.title: "Tieguanyin"
	quest.084F2A59DF8F3A06.quest_desc: ["Become Trusted in three different tracked villages."]
	quest.084F2A59DF8F3A06.title: "Village Hopper"
	quest.08F376945FD16964.quest_desc: ["Combine Fishing Rod and Acacia Log to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Savanna. Use it again to return to manual control."]
	quest.09512212C7737B61.quest_desc: ["Restocks backpack from sneak right clicked inventory Has more filtering options Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.096D6806626CD6D4.quest_desc: ["Arrange the Mechanical Crafters in the shape of the recipe, connect their output paths and supply rotation. Slot Covers handle unused positions."]
	quest.096D6806626CD6D4.title: "Mechanical Crafting"
	quest.09C9528550E1FD6B.quest_desc: ["The Heavy Core is a rare reward from ominous vaults. Combine it with a Breeze Rod when you are ready to make a Mace."]
	quest.0A2DAE5EAAE798AE.quest_desc: ["Add the Communicating Vessel to the fluid network. Use its Ponder preview to check the arrangement and connected fluid levels."]
	quest.0A2DAE5EAAE798AE.title: "Communicating Vessel"
	quest.0A64FE9FA8A36805.quest_desc: ["Keep Wood Pulp for paper production. Open its JEI recipes and uses to check the processing steps available in this pack."]
	quest.0A64FE9FA8A36805.title: "Pulp"
	quest.0AC244DE295B190A.quest_desc: ["Set up a Decoration Table and Paintbrush to customize storage colors and materials. Apply the design to your placed storage after testing a sample."]
	quest.0B22C27008D8732E.quest_desc: [
		"Use a skull on a placed Scarecrow to replace its head."
		"This completes The Art of Grafting advancement. Choose a face that suits your farm."
	]
	quest.0B22C27008D8732E.title: "A Change of Face"
	quest.0BDD49E0B7056D1E.quest_desc: [
		"Use a Block of Super Experience to make a Super Enchanting Template. Check JEI for the recipe."
		"Blaze Enchanters and Blaze Forgers in Super Enchanting mode require these upgraded templates instead of normal ones."
	]
	quest.0BDD49E0B7056D1E.title: "Super Enchanting Template"
	quest.0BEBB2510D8435FE.quest_desc: ["Check the material and mining tier before replacing your current tools, and keep spare materials for repairs or replacements."]
	quest.0BEBB2510D8435FE.title: "Diamond tools"
	quest.0BF74A0BE3031662.quest_desc: ["Smelting in an upgrade tab Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.0C8B9821D43ED752.quest_desc: [
		"Killing pigs, piglins or hoglins with a Cookery kitchen knife can provide it."
		"Keep Oil beside your stove: it is the first ingredient added to the wok before stir-frying."
	]
	quest.0C8B9821D43ED752.title: "Oil on the Blade"
	quest.0C9B6DB67E464948.quest_desc: ["Limited Barrels dedicate a small number of slots to bulk item storage. Choose a layout that matches your workshop's main materials."]
	quest.0CD42B19BBFEA7F2.quest_desc: [
		"Craft a List Filter and select the allowed or denied items."
		"Set transfer direction and stock limits in the worker's storage policy."
	]
	quest.0CD42B19BBFEA7F2.title: "Choose What Moves"
	quest.0D4174672201A7EA.quest_desc: ["Use Labels to make storage areas easier to recognize. Keep labels consistent across raw materials, processed components and expedition supplies."]
	quest.0D4922724DA846AF.quest_desc: ["Install this stack upgrade in the backpack to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.0D71D46CD540A033.quest_desc: [
		"Raise every villager skill to maximum through successful work."
		"Use different roles and check the Skills panel."
	]
	quest.0D71D46CD540A033.title: "Master of All Trades"
	quest.0DA7DEABAA66F7D3.quest_desc: ["Shortens the wait and makes legendary fish more likely to bite."]
	quest.0DA7DEABAA66F7D3.title: "Something Legendary"
	quest.0DD8F486B6DBB504.quest_desc: ["Apply this tier upgrade to a matching Basic storage container to raise it to Gold tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.0DDC839D3E3C7052.quest_desc: ["Share five discovered stories with villagers."]
	quest.0DDC839D3E3C7052.title: "Keep the Stories Alive"
	quest.0DEE0F0A32566514.quest_desc: [
		"Prepare the Oxeye Daisy Tea Bag and brew Loves Me Not."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.0DEE0F0A32566514.title: "Loves Me Not"
	quest.0E19B7FD3C6ADBFD.quest_desc: ["Hold The Sunward's day form from sunrise to sunset of one day"]
	quest.0E19B7FD3C6ADBFD.title: "Kuafu Chases the Sun"
	quest.0E76A85ED049A798.quest_desc: [
		"Hold Raw Dough and keep right-click pressed to stretch it into Raw Noodles."
		"Alternatively, place dough on a Chopping Board and cut it four times with a kitchen knife to get three Raw Noodles."
		"Keep the noodles for the Stockpot recipe collection."
	]
	quest.0E76A85ED049A798.title: "Pull Your Own Noodles"
	quest.0E76A99BEAA3A310.quest_desc: ["Craft two Fishing Nets and attach them to a moving Create contraption. They catch fish and other items while passing through open water."]
	quest.0E76A99BEAA3A310.title: "Fishing Net"
	quest.0E7ACA21FF037AE7.quest_desc: ["Keep seeds together in a Seed Pouch while tending your farm. Open its tooltip for the pouch controls."]
	quest.0EB72C4C224E6FD9.quest_desc: [
		"Sneak and throw a Baozi at a wolf that is missing health to heal it."
		"This completes the base Cookery Baozi advancement. A good meal is better when shared."
	]
	quest.0EB72C4C224E6FD9.title: "Share a Bun"
	quest.0EC16E0ECEE17670.quest_desc: ["Use a Belt Connector between aligned shafts to create a moving belt. Add an Andesite Funnel to transfer items between the belt and storage."]
	quest.0EC16E0ECEE17670.title: "Belts and Andesite Funnels"
	quest.0EC4467B69DBC4C3.quest_desc: ["Land a dew flower cake shockwave after falling at least twenty blocks"]
	quest.0EC4467B69DBC4C3.title: "From the Sky"
	quest.0F5C6BEE74871EF1.quest_desc: [
		"Craft a Warp Scroll for a single-use trip to an activated Waystone."
		"Use it when you need a quick return and want to keep the reusable Warp Stone for another trip."
	]
	quest.0F8EFABEF34E7C58.quest_desc: ["Look for Nether Wart around fortresses and grow it on soul sand. Keep part of the harvest for brewing."]
	quest.0F8EFABEF34E7C58.title: "How it grow there?"
