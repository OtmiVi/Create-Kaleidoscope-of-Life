		"{\"text\":\"Barrel\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A7E00000000002B\"}}"
		"{\"text\":\"Bottles and Tap\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A7E00000000002E\"}}"
	]
	quest.6A7F00000000005F.title: "Honglan in the Cellar"
	quest.6A7F000000000063.quest_desc: [
