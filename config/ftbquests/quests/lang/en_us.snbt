	quest.22B9B33AB325C110.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an \"},{\"text\":\"Experience Hatch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to your experience storage. \"},{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to deposit experience; sneak-right-click to withdraw it. \"},{\"text\":\"Adjust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" amounts on its scroll panel.\"}]}"]
