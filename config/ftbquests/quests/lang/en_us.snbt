	]
	quest.33D03300FCBE74B5.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically picks up nearby \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.33FFC4F03C4643E8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep your \"},{\"text\":\"armour\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipped during exploration and check its \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after combat. Compare protection with your current equipment before replacing a piece.\"}]}"]
