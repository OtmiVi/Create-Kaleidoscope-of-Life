	quest.3112827E9ACCF62F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically feeds the player using \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when \"},{\"text\":\"automatic feeding\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" should activate. Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
