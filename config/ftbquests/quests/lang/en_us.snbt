	quest.49CDABAC95866A38.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Lunar Sapphire Crystal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses \"},{\"text\":\"Polished Lunar Sapphire\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and is a component of the \"},{\"text\":\"Auto-Landing Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep spare polished sapphire for the other navigation parts.\"}]}"
