	quest.6A7F00000000006D.title: "A Bed for Echoes"
	quest.6A7F000000000075.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can use a \"},{\"text\":\"Soul Sail\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"reap\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" weakened creatures.\"}]}"]
	quest.6A7F000000000075.title: "A Soul for the Taking"
	quest.6A80000000000002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Crimson Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Crimson Forest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep part of the \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for salads and kabobs, and save a sample for the \"},{\"text\":\"Nether Agronomist\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement.\"}]}"
	]
	quest.6A80000000000002.title: "A Harvest in Hell"
	quest.6A80000000000005.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Warped Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Warped Forest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The fruit supplies salads, kabobs and the \"},{\"text\":\"Warped Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" branch. Keep a sample for the \"},{\"text\":\"Nether Agronomist\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement.\"}]}"
	]
	quest.6A80000000000005.title: "Something Blue"
	quest.6A80000000000008.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mysterious Poison Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is found in the \"},{\"text\":\"Soul Sand Valley\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep it separate from ordinary fruit and check the tooltip of dishes using it before eating them.\"}]}"
	]
	quest.6A80000000000008.title: "A Risky Little Fruit"
	quest.6A8000000000000B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Grow chili seeds on \"},{\"text\":\"Soul Soil\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Soul Peppers.\"}]}"]
	quest.6A8000000000000B.title: "Heat from the Soul"
	quest.6A8000000000000E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Crimson Salad\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Warped Salad and Fruit Platter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and are served in Bowls.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve some fruit for the separate \"},{\"text\":\"Warped Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" so your first \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can supply both meals and dessert.\"}]}"
	]
	quest.6A8000000000000E.title: "A Brighter Kind of Nether"
	quest.6A80000000000014.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"These \"},{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" kabobs use the \"},{\"text\":\"Wok and Sticks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as serving carriers.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Sticks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the \"},{\"text\":\"stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and compare the fruit and meat combinations before starting a batch.\"}]}"
	]
	quest.6A80000000000014.title: "Four Sticks, Four Flavors"
	quest.6A8000000000001E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Harvest \"},{\"text\":\"Nether Wart\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to find \"},{\"text\":\"2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Nether Caterpillars.\"}]}"]
	quest.6A8000000000001E.title: "A Little Nether Protein"
	quest.6A80000000000021.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Nether Caterpillar Sashimi and Caramel Nether Caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok and Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save a serving of the caramel dish for its \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" instead of eating the entire batch.\"}]}"
	]
	quest.6A80000000000021.title: "Three Ways to Serve a Bug"
	quest.6A80000000000026.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Eat all three \"},{\"text\":\"Nether Caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dishes.\"}]}"]
	quest.6A80000000000026.title: "A Bug Banquet"
	quest.6A80000000000029.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Crimson Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Warped Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Mysterious Poison Fruit and Soul Pepper\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in your inventory to complete the Nether Agronomist advancement.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a sample of every crop when returning from an expedition so one \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can supply several kitchen branches.\"}]}"
	]
	quest.6A80000000000029.title: "Nether Agronomist"
	quest.6A8000000000002C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hoglins\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply \"},{\"text\":\"Tusks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Hide and Ham for the Nether equipment and kitchen branches.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve \"},{\"text\":\"Tusks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for special \"},{\"text\":\"serving containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and equipment, and keep \"},{\"text\":\"Ham\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for roasting and slicing.\"}]}"
	]
	quest.6A8000000000002C.title: "A Hoglin's Pantry"
	quest.6A80000000000031.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Roast Ham\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a furnace, smoker or campfire, and use a \"},{\"text\":\"Chopping Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the slicing route.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Roujiamo and Ham Yogurt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" available for the yogurt and save slices for the other \"},{\"text\":\"ham\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dishes.\"}]}"
	]
	quest.6A80000000000031.title: "Bring Home the Ham"
	quest.6A80000000000037.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Piglin Brutes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply \"},{\"text\":\"Gilded Fragments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the fragments with the \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Gilded Barbaric Roast\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" so a \"},{\"text\":\"rare\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" drop is not spent before the kitchen needs it.\"}]}"
	]
	quest.6A80000000000037.title: "The Brute's Share"
	quest.6A8000000000003A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hoglin Tusk Braised Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Golden Roast and Gilded Barbaric Roast\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the Wok.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The tusk dish is served in a \"},{\"text\":\"Hoglin Tusk\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; the other roasts use \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep the required carrier ready before cooking.\"}]}"
	]
	quest.6A8000000000003A.title: "A Feast for the Bold"
	quest.6A8000000000003F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the \"},{\"text\":\"Primitive Machete\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready when exploring the \"},{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and compare its combat attributes with your current weapon.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check its \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before a long trip; its \"},{\"text\":\"Hoglin Tusk and Netherite\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" components are worth protecting.\"}]}"
	]
	quest.6A8000000000003F.title: "The Power of the Hog"
	quest.6A80000000000042.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Raw Strider Meat and Strider Rock Shells\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from your \"},{\"text\":\"Strider-related\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" gathering trips.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Separate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the meat for roasting from the shells needed by the next \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" branch.\"}]}"
	]
	quest.6A80000000000042.title: "A Kitchen on Hot Feet"
	quest.6A80000000000046.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Strider Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has furnace, smoker and campfire cooking routes. Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Braised Strider and Strider Nether Wart Stew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for those \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dishes and reserve Nether Wart for the stew.\"}]}"
	]
	quest.6A80000000000046.title: "Strider for Supper"
	quest.6A8000000000004B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Strider Shell Stir Fry and Soul Strider Kabob\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The stir fry is served in a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", while the kabob uses a \"},{\"text\":\"Stick\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep both carriers in the kitchen pantry.\"}]}"
	]
	quest.6A8000000000004B.title: "Shells and Skewers"
	quest.6A8000000000004F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Ghast Hide and Ghast Tentacles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from your \"},{\"text\":\"Ghast\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" encounters.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Tentacles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply roast, kabob, pasta and pudding \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Separate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" food ingredients from the hide when returning to the base.\"}]}"
	]
	quest.6A8000000000004F.title: "A Taste of the Clouds"
	quest.6A80000000000053.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Roasted Ghast Tentacles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use a furnace, smoker or campfire. The kabob, pasta and pudding use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Sticks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the kabobs and \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for pasta and pudding so every batch can be collected.\"}]}"
	]
	quest.6A80000000000053.title: "Clouds on the Menu"
	quest.6A80000000000059.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Poisonous Ghast Roast\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a Bowl for serving.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep its unusual \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" separate from your ordinary roast supplies and check the finished \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s tooltip before eating.\"}]}"
	]
	quest.6A80000000000059.title: "A Dangerous Roast"
	quest.6A8000000000005C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve \"},{\"text\":\"Raw Piglin Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from \"},{\"text\":\"Piglins\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the Nether kitchen branch.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cook\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it through its heating routes and keep part of the supply for the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dishes.\"}]}"
	]
	quest.6A8000000000005C.title: "A Different Cut"
	quest.6A8000000000005F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cook Piglin Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through a furnace, smoker, campfire or its \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" route.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Warped Hoglin Tenderloin Stew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is also a \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dish despite its name. Keep a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the stove for serving.\"}]}"
	]
	quest.6A8000000000005F.title: "Meat for the Warped Pot"
	quest.6A80000000000066.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Wither Skeletons\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply \"},{\"text\":\"Wither Ribs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for Wither Bone Soup.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"That soup needs a \"},{\"text\":\"Lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" base in the \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", so prepare the pot and serving \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before bringing the ribs to the \"},{\"text\":\"stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A80000000000066.title: "Remains of the Undead"
	quest.6A80000000000069.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Blaze Soup and Wither Bone Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" need \"},{\"text\":\"Lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as their \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" base. Magma Cream Soup uses Water instead.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Finish and empty one soup before changing the base. Keep \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for all three dishes.\"}]}"
	]
	quest.6A80000000000069.title: "A Fortress Full of Soup"
	quest.6A8000000000006E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Magma Cream Stir Fry and Crimson Magma Stew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and are served in \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save part of the stir fry for its \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" version; the \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dish uses the cooked meal as an ingredient.\"}]}"
	]
	quest.6A8000000000006E.title: "A Very Hot Wok"
	quest.6A80000000000073.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Lava-Roasted Chicken and Nether Fries Platter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for the fries and leave access to the \"},{\"text\":\"stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving each finished dish.\"}]}"
	]
	quest.6A80000000000073.title: "Straight from the Fire"
	quest.6A80000000000077.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Magma Cream Pudding and Lava Jelly\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and are served in Bowls.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep dessert \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and empty \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the stove to make repeat servings easier.\"}]}"
	]
	quest.6A80000000000077.title: "Sweet Heat"
	quest.6A8000000000007B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Soul Lamb Chop\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Soul Glazed Roast and Soul Pepper Stir Fry\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok and Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a supply of \"},{\"text\":\"Soul Pepper\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for this branch instead of using every pepper in soup.\"}]}"
	]
	quest.6A8000000000007B.title: "A Little Soul in the Wok"
	quest.6A80000000000080.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Finish \"},{\"text\":\"Soul Stir Fry Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect it with a Bowl.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save a serving for \"},{\"text\":\"Soul Stir Fry Meat Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" so the second \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has its cooked \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready.\"}]}"
	]
	quest.6A80000000000080.title: "Two Bowls of Heat"
	quest.6A80000000000084.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Poisonous Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses a \"},{\"text\":\"Water-filled Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a Bowl for serving.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check the \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s tooltip before eating and keep its \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" separate from your ordinary soup supplies.\"}]}"
	]
	quest.6A80000000000084.title: "Soups with a Strange Aftertaste"
	quest.6A80000000000089.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Spicy Pot and Mapo Tofu\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok and Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a serving of \"},{\"text\":\"Spicy Pot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Spicy Pot Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" instead of consuming the entire first batch.\"}]}"
	]
	quest.6A80000000000089.title: "The Spicy Corner"
	quest.6A8000000000008E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Chongqing Noodles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Luosifen and Spicy Hoglin Ramen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use a Water-filled Stockpot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add the correct \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for one dish at a time and keep \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready to serve the completed soup.\"}]}"
	]
	quest.6A8000000000008E.title: "Three Bowls of Noodles"
	quest.6A80000000000093.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Braised Lion Head\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Braised Pork Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Couples Lung Slice and Garlic Oysters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the Wok and Bowls.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep each \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" together in the pantry to avoid mixing different batches at the \"},{\"text\":\"stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A80000000000093.title: "A Few House Specials"
	quest.6A80000000000099.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Both dishes use a \"},{\"text\":\"Water-filled Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", but their \"},{\"text\":\"serving containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" differ.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pepper Pork Belly Chicken Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses a \"},{\"text\":\"Flower Pot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; \"},{\"text\":\"Sauerkraut Fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses a Bowl. Keep the right container beside the pot.\"}]}"
	]
	quest.6A80000000000099.title: "Comfort by the Fire"
	quest.6A8000000000009D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Star Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is used in the \"},{\"text\":\"Nether's\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" special dishes and can also repair damaged equipment.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep some available for \"},{\"text\":\"Soul Return Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the \"},{\"text\":\"Star Stew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" branch instead of spending the whole supply on one use.\"}]}"
	]
	quest.6A8000000000009D.title: "A Pinch of Starlight"
	quest.6A800000000000A0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Soul Return Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Star Ghast Pasta and Star Stew Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Star Stew uses a Water-filled Stockpot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Star Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" available for the whole branch. \"},{\"text\":\"Soul Return Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" returns you to your death point when eaten, so save it for the journey you need.\"}]}"
	]
	quest.6A800000000000A0.title: "Dinner Under the Stars"
	quest.6A800000000000A6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Eat all four \"},{\"text\":\"Star Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dishes.\"}]}"]
	quest.6A800000000000A6.title: "A Feast of Starlight"
	quest.6A800000000000A9.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Eat a \"},{\"text\":\"Star Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dish to gain \"},{\"text\":\"Star Blessing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A800000000000A9.title: "Blessed by the Stars"
	quest.6A800000000000AC.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Nether Stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as the \"},{\"text\":\"heat source\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beneath your cookware.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Leave space to load the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect dishes without standing beside an exposed \"},{\"text\":\"lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" source.\"}]}"
	]
	quest.6A800000000000AC.title: "A Hearth of Blackstone"
	quest.6A800000000000AF.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Find a \"},{\"text\":\"Ghast Pendant\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an unopened \"},{\"text\":\"Bastion Treasure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" chest.\"}]}"]
	quest.6A800000000000AF.title: "A Sunny Day Charm"
	quest.6A800000000000B2.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep arrows in your \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" while using the \"},{\"text\":\"Blowgun\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hold right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"charge\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the shot, then release to fire. \"},{\"text\":\"Practice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the timing before using it against a moving target.\"}]}"
	]
	quest.6A800000000000B2.title: "A Breath of Trouble"
	quest.6A800000000000B9.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can use \"},{\"text\":\"Star Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to repair damaged equipment.\"}]}"]
	quest.6A800000000000B9.title: "A Little Dust Goes a Long Way"
	quest.6A81000000000002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cut Chorus Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" twice on a Chopping Board to make Chorus Seeds. Collect \"},{\"text\":\"2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"Chopping Board\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381A43D155C8D44B\"}}"
	]
	quest.6A81000000000002.title: "Seeds at the Edge of the World"
	quest.6A81000000000005.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Shears\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on Chorus Flowers and collect \"},{\"text\":\"2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Chorus Petals.\"}]}"]
	quest.6A81000000000005.title: "A Flower from the End"
	quest.6A8100000000000C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Chorus Pasta\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Chorus Flower Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; the soup needs a Water base and a Bowl for serving.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Chorus Seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" available for the cookie \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" instead of turning the entire \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into cooked dishes.\"}]}"
	]
	quest.6A8100000000000C.title: "Chorus for Dinner"
	quest.6A81000000000010.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Harvest \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Ender Mint\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from End Stone.\"}]}"]
	quest.6A81000000000010.title: "A Fresh Breath of the End"
	quest.6A81000000000013.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ender Mint\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supplies this dessert branch. \"},{\"text\":\"Candy\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and mousse use ingredient assembly, while \"},{\"text\":\"Dragon Head\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Sauce\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is finished in a Wok.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving and reserve some \"},{\"text\":\"mint\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for later drinks and sauces.\"}]}"
	]
	quest.6A81000000000013.title: "Fresh and Sweet"
	quest.6A81000000000017.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Water-filled Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Mint Noodle Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for Mint Sauce Shulker Meat.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"-bowl version uses the cooked meat dish, so save a serving instead of eating the entire first batch.\"}]}"
	]
	quest.6A81000000000017.title: "Mint on the Menu"
	quest.6A8100000000001C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"text\":\"Dream Berries\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beneath \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" islands and keep a safe route back to solid ground.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save some for the dessert branch, including \"},{\"text\":\"Dragon Egg Ice Cream\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", instead of eating the entire \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A8100000000001C.title: "A Dream Beneath the Islands"
	quest.6A8100000000001F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Finish \"},{\"text\":\"End Salad\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect it with a Bowl.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep its \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the same pantry section as your other \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" produce to make repeat batches easier.\"}]}"
	]
	quest.6A8100000000001F.title: "A Bowl from Another World"
	quest.6A81000000000022.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Gain the Dream\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" effect from \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ingredients or dishes.\"}]}"]
	quest.6A81000000000022.title: "A Little Dreaming"
	quest.6A81000000000025.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Kill Endermen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a kitchen knife and collect \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Optic Nerves.\"}]}"]
	quest.6A81000000000025.title: "Eye for an Ingredient"
	quest.6A81000000000028.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Optic Nerve Sweet and Sour Pork\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and keep a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready to collect it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve \"},{\"text\":\"Optic Nerves\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from your \"},{\"text\":\"Endermen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" trips for this branch rather than using every drop in other dishes.\"}]}"
	]
	quest.6A81000000000028.title: "A Different Kind of Sweet and Sour"
	quest.6A8100000000002B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Defeat Shulkers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Shulker Meat.\"}]}"]
	quest.6A8100000000002B.title: "A Meal Inside a Shell"
	quest.6A8100000000002E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Wok's Stuffed Shulker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses a \"},{\"text\":\"Shulker Shell\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as its serving container. \"},{\"text\":\"Shulker Shell Stew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" instead uses a \"},{\"text\":\"Water-filled Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a Bowl.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the ice-cream \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" separate from the hot cookware; that dessert uses an assembly \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A8100000000002E.title: "A Shell Full of Supper"
	quest.6A81000000000033.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Kill Endermites\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a kitchen knife and collect \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Raw Endermite Meat.\"}]}"]
