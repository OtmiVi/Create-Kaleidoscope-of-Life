	quest.02913910B8BC7B09.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
