	quest.22C6644CC2675898.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Lullaby\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Poppy Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
