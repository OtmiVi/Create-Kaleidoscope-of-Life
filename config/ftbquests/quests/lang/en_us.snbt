	quest.000B689515524AB1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Compacts \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into their \"},{\"text\":\"compressed variants\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using \"},{\"text\":\"2x2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.005DDF316BF8DA75.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Name Tag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a creature to give it a recognisable name.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Names\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" help distinguish animals and companions when several share the same pen or base.\"}]}"
	]
	quest.00699E41DD5435D6.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Trial Key\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a vault to earn \"},{\"text\":\"Under Lock and Key\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ordinary\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and ominous vaults use different keys, so match the key to the \"},{\"text\":\"vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" you found.\"}]}"
	]
	quest.00903C87A134D20F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Gold\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Netherite\"},{\"text\":\" tier.\"}]}"
	]
	quest.00943BF6A742C5FD.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Speeds up \"},{\"text\":\"bites\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and favors fish from \"},{\"text\":\"cherry groves\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.00943BF6A742C5FD.title: "A Taste of Cherry"
	quest.00B5AEE5731A79FB.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Supply the \"},{\"text\":\"Oxygen Sealer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Oxygen from behind\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"rotational power from below\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It oxygenates the surrounding area while supplied.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep its fluid and power connections running before relying on the area for air. A \"},{\"text\":\"Large Fan\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can extend its coverage; use an Oxygen Detector to check a location.\"}]}"
	]
	quest.00B5AEE5731A79FB.title: "Air for the Outpost"
	quest.00ECFF7D7405A921.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Shafts\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" carry rotation along a straight axis. Use cogwheels or gearboxes when the machine is not in line with the source.\"}]}"]
	quest.00ECFF7D7405A921.title: "Shaft"
	quest.00EDE56ACDFF2C93.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Feed \"},{\"text\":\"Hydrogen Gas\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into an \"},{\"text\":\"Ice Box\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" cooled to \"},{\"text\":\"-253 C or below\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". The condensation recipe produces \"},{\"text\":\"Liquid Hydrogen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the \"},{\"text\":\"cooling setup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" running and pipe the product into suitable storage. Check the \"},{\"text\":\"required temperature\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" if the gas is not changing into liquid.\"}]}"
	]
	quest.00EDE56ACDFF2C93.title: "Hydrogen at Minus 253"
	quest.01055F24A8E676D8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Complete ominous trial encounters to obtain keys for ominous vaults. Prepare equipment and \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before triggering the harder encounter.\"}]}"]
	quest.01406449A26CC04F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Echo Upgrade Smithing Templates and Echo Ingots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to upgrade matching \"},{\"text\":\"Netherite\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipment. Keep enough materials for the \"},{\"text\":\"complete set\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.01406449A26CC04F.title: "Echo Sword and Armor"
	quest.0143614D99A39DAB.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this module to automatically switch to a suitable tool from your \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when interacting with \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or entities. \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and check the assigned key for swapping interaction \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.0172930769CA91D7.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a tank for bulk \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", use an \"},{\"text\":\"Item Drain\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to empty containers, and place a \"},{\"text\":\"Spout\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" above \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to fill them. Keep different fluids on separate lines.\"}]}"]
	quest.0172930769CA91D7.title: "Fluid Storage, Draining and Filling"
	quest.017D36B7F519B774.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Break\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" grass while wearing a \"},{\"text\":\"Straw Hat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to find \"},{\"text\":\"Lettuce Seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then plant them on farmland.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Grow a steady supply for soups and \"},{\"text\":\"stuffed dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Watch for caterpillars when harvesting.\"}]}"
	]
	quest.017D36B7F519B774.title: "Leaves for Lunch"
	quest.01965A016BFD347D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Release\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a fish from a bucket into your flooded \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" field.\"}]}"
