	image.435757B30DF8A658.title: "{\"text\":\"Grow, press and serve.\",\"color\":\"#A9C58C\",\"bold\":false}"
	image.49908939FC7D8F6B.title: "{\"text\":\"FIELD TO FEAST\",\"color\":\"#A9C58C\",\"bold\":true}"
	image.4D47B69BD37DFAE4.title: "{\"text\":\"Pipes, boilers and steam.\",\"color\":\"#D6B879\",\"bold\":false}"
	image.4FC194006040298D.title: "{\"text\":\"Prismarine power. Ocean machinery.\",\"color\":\"#D6B879\",\"bold\":false}"
	image.512A1013A006892A.title: "{\"text\":\"Collect XP. Upgrade your gear.\",\"color\":\"#D6B879\",\"bold\":false}"
	image.5927C139695E7C06.title: "{\"text\":\"BRASS ERA\",\"color\":\"#D6B879\",\"bold\":true}"
	image.592F8FE87BADE3C2.title: "{\"text\":\"VILLAGERS \\u0026 COMMUNITY\",\"color\":\"#D4CDBE\",\"bold\":true}"
	image.6077AA23ACE94F9B.title: "{\"text\":\"FISH MENUS\",\"color\":\"#A9C58C\",\"bold\":false}"
	image.608875ECB80D40D4.title: "{\"text\":\"Find every template. Choose your own style.\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.610A08441D2B404F.title: "{\"text\":\"Choose your tackle. Build your collection.\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.620B0E8E5223446B.title: "{\"text\":\"BOBBERS\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.62408E3F641F21AD.title: "{\"text\":\"Power your first machines.\",\"color\":\"#D6B879\",\"bold\":false}"
	image.64C40F1352EC417D.title: "{\"text\":\"BAIT \\u0026 WORMS\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.656AB8959102481C.title: "{\"text\":\"TOOLS, SHELLS \\u0026 DISPLAYS\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.65FE2585ACEB408B.title: "{\"text\":\"One good catch. A whole new menu.\",\"color\":\"#A9C58C\",\"bold\":false}"
	image.661A5FB8CB0E4FAE.title: "{\"text\":\"HOOKS\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.6629A890DD63445B.title: "{\"text\":\"FROM CATCH TO PLATE\",\"color\":\"#A9C58C\",\"bold\":true}"
	image.66A366C4A4AF47F5.title: "{\"text\":\"MAKE THE ROD YOUR OWN\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.67C393FBF9E348BE.title: "{\"text\":\"TACKLE TEMPLATES\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.68710DF8EA8945D9.title: "{\"text\":\"THE TROPHY LINE\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.68DECC8CDC4646A3.title: "{\"text\":\"ROD \\u0026 TACKLE SKINS\",\"color\":\"#D4CDBE\",\"bold\":true}"
	image.6A088259B650496E.title: "{\"text\":\"Find a way back home.\",\"color\":\"#D4CDBE\",\"bold\":false}"
	image.6C0AEF58700F493C.title: "{\"text\":\"FILLETS\",\"color\":\"#A9C58C\",\"bold\":false}"
	image.6CB4FC885BC5138F.title: "{\"text\":\"FILTERS \\u0026 LOGISTICS\",\"color\":\"#D4CDBE\",\"bold\":false}"
