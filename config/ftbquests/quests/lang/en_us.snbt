	quest.0BA06CFB7E4CF916.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Targeting Computer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is used in navigation equipment. Its assembly sequence combines \"},{\"text\":\"Polished Diamond\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Hardened Precision Mechanisms, circuits, and engraving steps.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Spare computers can be stored in a \"},{\"text\":\"Computer Rack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on your rocket to reduce its \"},{\"text\":\"fuel cost\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check the station's route information after changing the rocket's equipment.\"}]}"
	]
