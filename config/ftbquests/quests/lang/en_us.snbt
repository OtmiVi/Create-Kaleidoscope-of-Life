	quest.2E284F5F1E2C5E8B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this downgrade to reduce stack \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It is useful when you want smaller buffers or tighter limits on stored \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
