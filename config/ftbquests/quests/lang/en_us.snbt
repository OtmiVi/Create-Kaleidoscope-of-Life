	quest.03139DD7511FF6E8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically picks up nearby \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.033FE8289CB8DD46.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hydrocarbon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is a rocket fuel. Transfer it into \"},{\"text\":\"Fluid Tanks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" that belong to the glued rocket structure before assembly.\"}]}"
