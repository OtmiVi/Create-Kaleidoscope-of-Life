	quest.4C736C29248A426E.title: "Friendly Competition"
	quest.4C8BA6D3AB53C9EE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"crops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to harvest them and remove weeds.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep it with your farming \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as your vegetable beds and \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" fields expand.\"}]}"
	]
	quest.4C8BA6D3AB53C9EE.title: "A Cleaner Harvest"
	quest.4CE6CAC38213C268.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Cookery\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" knives prepare ingredients on the \"},{\"text\":\"Chopping Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Higher-tier\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" knives make useful upgrades as you spend more time in the kitchen.\"}]}"]
	quest.4CE6CAC38213C268.title: "A Blade for the Chef"
	quest.4D28FAA1A4E7E1AC.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The first \"},{\"text\":\"Titanium Ingot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" comes at the end of a processing sequence built around a \"},{\"text\":\"Sturdy Sheet\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It passes through lava filling, pressing, \"},{\"text\":\"Titanium Tetrachloride\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" filling, another pressing step, and water filling.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The intermediate item must finish the entire sequence before it becomes a usable ingot.\"}]}"
	]
	quest.4D28FAA1A4E7E1AC.title: "Your First Titanium"
	quest.4DB5312EFD5053BB.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Lightning Rod\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" near a \"},{\"text\":\"Blaze Enchanter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" under an open sky.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Supply \"},{\"text\":\"Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and feed the enchanter a \"},{\"text\":\"Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" o' \"},{\"text\":\"Enchanting\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to activate \"},{\"text\":\"Super Enchanting\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"mode\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set an equipment item, such as a pickaxe, in its filter slot and choose an enchanting level.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Process Super Enchanting Templates\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" until a result includes a \"},{\"text\":\"treasure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" enchantment, such as \"},{\"text\":\"Mending\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". This grants \"},{\"text\":\"Probability Spike\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". You may need several attempts.\"}]}"
	]
	quest.4DB5312EFD5053BB.title: "Treasure Enchantments with Lightning"
	quest.4E6536570DDAD4B9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"This ancient creature may look like it pays taxes to nobody... and that's because it doesn't.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Give a \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Pitcher Pod\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to tame it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Once you've earned its trust, you can:\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Equip a \"},{\"text\":\"Saddle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — yes, you can ride the giant mossy dinosaur.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Chest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — because apparently your dinosaur is also a backpack.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add a \"},{\"text\":\"Carpet\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — all \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" colors work, because fashion is important even when you're extinct.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Its chest provides \"},{\"text\":\"25\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" slots, making your new prehistoric friend surprisingly useful on long adventures.\"}]}"
	]
	quest.4E6536570DDAD4B9.title: "A Sniffer Companion"
	quest.4EABF4A050EC94CD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"May Kiss\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Lily\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the \"},{\"text\":\"Valley Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.4EABF4A050EC94CD.title: "May Kiss"
	quest.4ECC51DB18B1540D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Scarecrow\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside your \"},{\"text\":\"crops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to protect the surrounding farmland.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with suitable heads, lanterns or \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to decorate it.\"}]}"
	]
	quest.4ECC51DB18B1540D.title: "Someone to Watch the Crops"
	quest.4EEF51C72C7FA08B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the Heat \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Engine\"},{\"text\":\" for compatible portable equipment. Prepare its required tank before upgrading your equipment.\"}]}"
	]
	quest.4EEF51C72C7FA08B.title: "Heat Engine"
	quest.4EF046487566D3A7.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Include the \"},{\"text\":\"Interplanetary Navigator\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in your rocket when travelling to \"},{\"text\":\"other planets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Trips to moons do not require it.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The navigator does not replace \"},{\"text\":\"astronomical research\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use your Space Atlas and the Rocket Station to check that the destination is unlocked and that the rocket meets its travel requirements.\"}]}"
	]
	quest.4EF046487566D3A7.title: "Beyond Earth's Neighbourhood"
	quest.4EF30842961B514C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Enter the Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through a lit \"},{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" portal.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bring \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", spare \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a way to relight the portal. Record the entrance before exploring.\"}]}"
	]
	quest.4EF30842961B514C.title: "There is hot"
	quest.4F7A0DB004A895AA.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Transports\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" further and faster than \"},{\"text\":\"Mechanical Pumps\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", can be encased with Copper Casing\"}]}"]
	quest.4F7A0DB004A895AA.title: "Pumps and Redstone Valves"
	quest.4F914EAA5FC2FD3F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew The \"},{\"text\":\"Unnoticed\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Azure Bluet Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.4F914EAA5FC2FD3F.title: "The Unnoticed"
	quest.4FA6F8DB9FB7E44D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Copper Casings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are used for \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" machinery. Make a small batch before building pumps and \"},{\"text\":\"tanks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.4FA6F8DB9FB7E44D.title: "Copper Casing"
	quest.4FB5C6F97628D84D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Copper\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Gold\"},{\"text\":\" tier.\"}]}"
	]
	quest.4FC62F5A745262F5.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Brass Casings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" support the precision stage of \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep a batch for \"},{\"text\":\"Mechanical Crafters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and more advanced workshop machinery.\"}]}"]
	quest.4FC62F5A745262F5.title: "Brass Casing"
	quest.4FC8B0B6D84E9EE0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between your source and destination. A powered \"},{\"text\":\"Mechanical Pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supplies the direction and flow for the line.\"}]}"]
	quest.4FC8B0B6D84E9EE0.title: "Fluid Pipe"
	quest.4FE7E5CB1B9402CD.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Complete quests for ten different \"},{\"text\":\"villagers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the same village.\"}]}"]
	quest.4FE7E5CB1B9402CD.title: "The People's Champion"
	quest.4FE8D62B58B25DBC.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Serve \"},{\"text\":\"Flower Tea\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from your tea setup and keep an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for the next serving.\"}]}"]
	quest.4FE8D62B58B25DBC.title: "Flower Tea"
	quest.5001800E8FE5FA4F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Fish Radar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to inspect fishing conditions and plan your next catch.\"}]}"]
	quest.5001800E8FE5FA4F.title: "Read the Water"
	quest.504ADAA47E732AB6.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"This tank supports the portable equipment branch. Compare its \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"capacity\"},{\"text\":\" before making the next tier.\"}]}"
	]
	quest.504ADAA47E732AB6.title: "Medium Filling Tank"
	quest.50F3EC97A6D95660.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Prepare \"},{\"text\":\"heat-resistant equipment\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before visiting \"},{\"text\":\"Venus\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check your suit, oxygen supply, return fuel, and rocket's \"},{\"text\":\"heat shielding\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before departure.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Plan short trips from a prepared landing area while gathering resources. Bring the equipment needed for a \"},{\"text\":\"protected outpost\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before attempting a longer stay.\"}]}"
	]
	quest.50F3EC97A6D95660.title: "Into the Heat of Venus"
	quest.515534D45D82489F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Wear \"},{\"text\":\"all four pieces\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the Iron Space Suit before entering an airless environment. The chestpiece holds your \"},{\"text\":\"Oxygen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply; fill it at an \"},{\"text\":\"Oxygen Filler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before departure.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Watch the remaining oxygen while exploring and leave enough for the journey back. This suit provides \"},{\"text\":\"insulation\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", but hotter destinations call for \"},{\"text\":\"heat-resistant equipment\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.515534D45D82489F.title: "A Breath of Your Own"
	quest.51554766CA897553.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Fish Plaque\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to display a catch on the wall. \"},{\"text\":\"Match\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the wood variant to the room or use different woods to group your collection.\"}]}"]
	quest.51554766CA897553.title: "A Catch for the Wall"
	quest.5161081A58AD5C77.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can use \"},{\"text\":\"trial key\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to  reset \"},{\"text\":\"vault\",\"color\":\"#D6B879\",\"bold\":true}]}"]
	quest.5161081A58AD5C77.title: "Reuse key"
	quest.5166ACCCD8F53010.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew The \"},{\"text\":\"Prussian Leap\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Cornflower Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.5166ACCCD8F53010.title: "The Prussian Leap"
	quest.517CAFE33962A58E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Look for blazes in \"},{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" fortresses. \"},{\"text\":\"Rods\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" become blaze powder for brewing and \"},{\"text\":\"Eyes of Ender\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.517CAFE33962A58E.title: "Some hot rods"
	quest.518102CB0AC51869.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.51D70276D620DD81.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Keep your \"},{\"text\":\"armour\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipped during exploration and check its \"},{\"text\":\"durability\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after combat. Compare protection with your current equipment before replacing a piece.\"}]}"]
	quest.51D70276D620DD81.title: "Iron armor"
	quest.51FB462DA31CB755.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Set the ejector's destination before supplying \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep its landing area clear and use \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to inspect the trajectory setup.\"}]}"]
	quest.51FB462DA31CB755.title: "Weighted Ejector"
	quest.5200A63BBA47114A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Let a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sniffer\"},{\"text\":\" search suitable ground, and grow the recovered \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"seeds\"},{\"text\":\" before harvesting the flowers.\"}]}"
	]
	quest.525F9C43C7D2E378.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Hire\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a worker through \"},{\"text\":\"Recruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or Hire.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Assign\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a reachable work area, tools, storage and payment. Check \"},{\"text\":\"Clipboard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" diagnostics if work stops. \"},{\"text\":\"Self-check\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": tick when done.\"}]}"
	]
	quest.525F9C43C7D2E378.title: "Hire Your First Worker"
	quest.5267880823A110B8.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Martian Steel Space Suit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" provides \"},{\"text\":\"heat resistance\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as well as insulation and oxygen sealing. Wear the \"},{\"text\":\"complete set\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before visiting a hostile destination.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill its chestpiece at the \"},{\"text\":\"Oxygen Filler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and check the remaining supply before launch. Upgraded armour still needs oxygen and a way back to your rocket.\"}]}"
	]
	quest.5267880823A110B8.title: "Dress for Hotter Worlds"
	quest.52BBE1F320D98911.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Provides a portable \"},{\"text\":\"Jukebox\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with support for additional music \"},{\"text\":\"discs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Open its \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose \"},{\"text\":\"playback\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" options. Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.52CBF69BE2AB6465.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 1 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 5.\"}]}"
	]
	quest.530872E6174F2B8B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Equip the \"},{\"text\":\"Exoskeleton Chestplate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and inspect its operating requirements. Check the assigned controls before testing its movement features.\"}]}"]
	quest.530872E6174F2B8B.title: "Netherite Exoskeleton"
	quest.533F256CE5FF18DA.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smokes \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"automatic input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in its settings. Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.534757936CD06941.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Blasts ores and metal \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
	quest.535376AC4DDE123D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A windmill is a renewable source of rotation for your workshop.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Assemble\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sails around a \"},{\"text\":\"Windmill Bearing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", check that the structure can rotate, and connect its \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to your machines. Complete this information quest manually.\"}]}"
	]
	quest.535376AC4DDE123D.title: "Windmill Setup"
	quest.5353C969A2D50CB7.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Install the \"},{\"text\":\"Omega Stack Upgrade\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a compatible \"},{\"text\":\"Sophisticated Backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to expand the \"},{\"text\":\"amount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" version separate from \"},{\"text\":\"Sophisticated Storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" modules and check the new \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before loading an expedition supply.\"}]}"
	]
	quest.535855FF6D033C77.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Super Glue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" joins \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into a \"},{\"text\":\"contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use the bearing, piston or \"},{\"text\":\"Cart Assembler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" suited to the movement you want, and leave its route clear.\"}]}"]
	quest.535855FF6D033C77.title: "Build Moving Contraptions"
	quest.5366AD37EA36D995.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Provides a portable \"},{\"text\":\"Jukebox\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.543C2519A43A09F0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Starter Tier\"},{\"text\":\" stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 3.\"}]}"
	]
	quest.544B48464E5D2C71.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Choose the \"},{\"text\":\"Moon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as your destination and check the rocket's fuel and your suit's \"},{\"text\":\"Oxygen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before launch. Bring the supplies needed to depart again.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Set foot on the surface\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to earn the advancement. Once landed, look for \"},{\"text\":\"Lunar Sapphire\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and keep track of your rocket's location.\"}]}"
	]
	quest.544B48464E5D2C71.title: "One Small Step"
	quest.5476426B444157D0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Compacts \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into their \"},{\"text\":\"compressed variants\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using \"},{\"text\":\"2x2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.54CDCEC18486F91D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically feeds the player using \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when \"},{\"text\":\"automatic feeding\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" should activate. Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.550BCB5EA87CE32E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Autumn Serenade\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Orange Tulip Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.550BCB5EA87CE32E.title: "Autumn Serenade"
	quest.553658BD42F3F7FE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 1 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 3.\"}]}"
	]
	quest.553CCE4F4F33FBCD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 1 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 1 Plus.\"}]}"
	]
	quest.5561E25A984A8C55.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Ripen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"50\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" crops within one Vernal Awakening\"}]}"]
	quest.5561E25A984A8C55.title: "Believe in the Whole Spring"
	quest.557B800D64D59710.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 1 \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Plus\"},{\"text\":\" stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 3.\"}]}"
	]
	quest.55B40D3BAB1FA6A5.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Valve Handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" provides manual rotation; a \"},{\"text\":\"Fluid Valve\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" controls a \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" line. Check the valve state before starting the pump.\"}]}"]
	quest.55B40D3BAB1FA6A5.title: "Fluid Valves and Handles"
	quest.55D6541D605E5BCC.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Restocks the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from an \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" you \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.56944AF4479395C5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Starter Tier\"},{\"text\":\" stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 4.\"}]}"
	]
	quest.572F0A52E3B4C07F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Finish cutting an ingredient on a \"},{\"text\":\"Chopping Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a \"},{\"text\":\"Cookery\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" kitchen knife.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Continue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" cutting until the ingredient changes into its prepared result. This grants the chopping advancement.\"}]}"
	]
	quest.572F0A52E3B4C07F.title: "Chop, Chop, Chop!"
	quest.57993FFBF672E682.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Set the item to copy in its \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"filter\"},{\"text\":\" slot, supply the required \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"fluid\"},{\"text\":\", and feed blank \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"items\"},{\"text\":\" underneath it. It can copy books, rename \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"items\"},{\"text\":\", and more.\"}]}"
	]
	quest.57993FFBF672E682.title: "Printer"
	quest.57CFEF7965C2F8C2.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mine Nether Quartz\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for machinery and redstone components. It also feeds the \"},{\"text\":\"Rose Quartz\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" branch of \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.57CFEF7965C2F8C2.title: "Nether Quartz"
	quest.5938C2A162743DC7.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Encased Chain Drives\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" share rotation between connected units. \"},{\"text\":\"Gearboxes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" help route the same network around corners.\"}]}"]
	quest.5938C2A162743DC7.title: "Gearboxes and Chain Drives"
	quest.595F2FF6E6A6425F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Break\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" grass while wearing a \"},{\"text\":\"Straw Hat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to find Wild Rice.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Prepare flooded \"},{\"text\":\"farmland\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before planting it. \"},{\"text\":\"Mature\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rice plants provide \"},{\"text\":\"Rice Panicles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for your kitchen.\"}]}"
	]
	quest.595F2FF6E6A6425F.title: "Find Wild Rice"
	quest.5985D87670983A7A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pay\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"10,000 emeralds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in wages through Payment Boxes.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Optional\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" settlement goal.\"}]}"
	]
	quest.5985D87670983A7A.title: "An Emerald Economy"
	quest.5993A0F3FAA25498.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"For the upgrade branches in this chapter, use a compatible \"},{\"text\":\"Sophisticated Backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Open its \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and inspect its \"},{\"text\":\"upgrade slots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before crafting modules.\"}]}"]
	quest.59A23E744C86727F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Large Water Wheel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs more room around its axle. Set up flowing \"},{\"text\":\"water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and connect its rotation to your workshop.\"}]}"]
	quest.59A23E744C86727F.title: "Large Water Wheel"
	quest.59D5DA0147D54A30.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tungsten Ore\"},{\"text\":\" on \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mercury\"},{\"text\":\" and process the raw material into ingots.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Tungsten Blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and tungsten cladding provide the strongest of Northstar\u0027s three heat-shielding tiers. The ingot is also used in the \"},{\"text\":\"Rocket Waypoint\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.59D5DA0147D54A30.title: "Tungsten from Mercury"
	quest.5B0FA1FF4D71B700.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Harvest \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Lettuce\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and keep one \"},{\"text\":\"Caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Caterpillars have a chance to appear when you harvest lettuce.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Lettuce\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is useful in soups and \"},{\"text\":\"stuffed dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". The \"},{\"text\":\"caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can become a treat for a baby chicken.\"}]}"
	]
	quest.5B0FA1FF4D71B700.title: "An Unexpected Garden Guest"
	quest.5B18D1B9AA2FFC2A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use them to replace wooden \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and build a furnace. The task accepts its listed material tag.\"}]}"]
	quest.5B18D1B9AA2FFC2A.title: "Stone age"
	quest.5B284C6EAAB96805.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Allows your fishing tackle to survive \"},{\"text\":\"lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and reach \"},{\"text\":\"lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" catches.\"}]}"]
	quest.5B284C6EAAB96805.title: "Fishing in Lava"
	quest.5B337FE46BEC0A30.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Slimeballs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are useful for sticky pistons and \"},{\"text\":\"Super Glue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep a stack near the \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" workbench.\"}]}"]
	quest.5BCDC4A61F7A3413.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by processing Rice Panicles in a powered Create Millstone.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Feed the panicles into the top of the \"},{\"text\":\"millstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and supply rotation. Each panicle gives two \"},{\"text\":\"Rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", with a chance for one more.\"}]}"
		"{\"text\":\"Open the quest with Create\\u0027s Millstone\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"449A09FC50B32D81\"}}"
	]
	quest.5BCDC4A61F7A3413.title: "From Panicle to Grain"
	quest.5BEEA73118C314D0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Gold\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" equipment wears out quickly, so reserve your gold for the \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and equipment you actually need.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"This is an information quest. Read the advice, then complete its checkmark manually.\"}]}"
	]
	quest.5BEEA73118C314D0.title: "Better gold"
	quest.5C05217D7F061B19.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Gold\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is useful for \"},{\"text\":\"golden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", redstone components and later alloys. Keep some for your workshop.\"}]}"]
	quest.5C05217D7F061B19.title: "First gold"
	quest.5C184812CBA507FD.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Search End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" cities for shulkers. Two shells and a chest make portable shulker \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.5C184812CBA507FD.title: "Some bodes"
	quest.5C3E81FDED808200.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.5C5517B276FCD993.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"rare\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Elder Guardian\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" drop that is useful in constructing even better sophisticated \"},{\"text\":\"Laser Defense Systems\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as well as other useful gadgets.\"}]}"]
	quest.5C5517B276FCD993.title: "Elder Guardian Beam Capacitor"
	quest.5C73A308C37AA0C1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Sea Pickle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Warm Ocean\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.5C7B63F20EA5E2B1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Cross\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"50 blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of open water in one unbroken Rosy Stride\"}]}"]
	quest.5C7B63F20EA5E2B1.title: "Walk on Water"
	quest.5CBA5B8B8355E796.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect \"},{\"text\":\"100,000 mB\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of \"},{\"text\":\"Molten Echo\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the fluid task.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The installed mixing \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses \"},{\"text\":\"Echo Shards\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a \"},{\"text\":\"superheated\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Basin\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Prepare a reliable shard supply and enough tank capacity before running the batch.\"}]}"
	]
	quest.5CBA5B8B8355E796.title: "Molten Echo"
	quest.5CD0E5FACB3D13F2.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Moves \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and adjacent \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"input and output sides\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the connection. Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.5D86D49820763D05.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Complete \"},{\"text\":\"requests\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or assignments for three related \"},{\"text\":\"villagers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Profile and Family\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to find their relatives.\"}]}"
	]
	quest.5D86D49820763D05.title: "Family Business"
	quest.5DAC077462DE4567.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Its crafting grid uses \"},{\"text\":\"Iron Sheets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a \"},{\"text\":\"Shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on top, \"},{\"text\":\"Iron Sheets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" around a \"},{\"text\":\"Cogwheel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the middle, and Magma Blocks around a Campfire on the bottom.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Load suitable \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the spit with redstone to cook. Turn the \"},{\"text\":\"redstone signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" off before removing the food.\"}]}"
	]
	quest.5DAC077462DE4567.title: "Turning Up the Roast"
	quest.5DE7D88D11E26952.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Worm\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" bait reduces the wait for a bite. Compare ordinary \"},{\"text\":\"Worms\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Almighty Worms and Seeking Worms\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before a trip.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The upgraded worms favour \"},{\"text\":\"live fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"undiscovered catches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", so choose according to the collection you are working on.\"}]}"
	]
	quest.5DE7D88D11E26952.title: "A Better Bite"
	quest.5DF30D479544B885.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"This tank supports the portable equipment branch. Compare its \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"capacity\"},{\"text\":\" before making the next tier.\"}]}"
	]
	quest.5DF30D479544B885.title: "Small Filling Tank"
	quest.5E135F02750C499F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Lower the hose into a \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" source and connect a \"},{\"text\":\"pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check the supply and destination before starting a large transfer.\"}]}"]
	quest.5E135F02750C499F.title: "Hose Pulley"
	quest.5E5A5EBC3FCB5F63.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" entering or leaving the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.5EB9C24D71733512.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Convert an existing \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 3 stack upgrade into \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Tier\"},{\"text\":\" 4.\"}]}"
	]
	quest.5F137B0C41D5025D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Dormant Martian Sapling\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can be revived through a sequence of \"},{\"text\":\"Water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and enhanced Healing, Strength, and Regeneration potion filling steps.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Run the sequence \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"twice\"},{\"text\":\" to obtain a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Coiler Sapling\"},{\"text\":\". Let the intermediate sapling finish every step.\"}]}"
	]
