	quest.2E34DBBA8552B3A7.quest_desc: ["Convert an existing Tier 1 stack upgrade into Tier 2. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.2E9FA72B8E45D381.quest_desc: ["Glowstone dust and glow ink are useful for lighting and decoration. Collect glowstone in the Nether and glow ink from glow squids."]
	quest.2E9FA72B8E45D381.title: "Lets glow"
	quest.2F2D3AD96BA287FD.quest_desc: ["Collect Sap with a Treetap, or process Rubber Logs in a Millstone or Crushing Wheels. Smelt the Sap into Rubber, or compare the Basin recipes in JEI."]
	quest.2F2D3AD96BA287FD.title: "Sap"
	quest.2F64C6BB58AEFED6.quest_desc: ["Automatically swaps item in player's hand for the one effective on the block/entity when these are left clicked. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.2F6C209015C5AE79.quest_desc: ["Place a Starcatcher's Display to show off your fishing collection."]
	quest.2F6C209015C5AE79.title: "The Angler's Display"
	quest.2FA0A34A470CBB4C.quest_desc: ["Makes storage pickup items Has more filtering options Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.2FE6370E7E54AC5C.quest_desc: ["Install this stack upgrade in the storage to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.2FE82AEBE415E7C6.quest_desc: ["Filters items piped in and/or out of storage Has more filtering options Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.302793E330894EA8.quest_desc: ["Voids items selected in filter Has more filtering options Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.30622D9F1018E73D.quest_desc: [
		"The vanilla Brewing Stand does not brew potions and its interface is disabled. Its crafting recipe is removed. Stands found in the world remain decorative blocks and cleric workstations."
		"Brew potions with a Mechanical Mixer over a Basin. Check JEI for ingredients and heating requirements."
		"{\"text\":\"Open the Mechanical Mixer quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"20F032D0D2DD5D12\"}}"
		"Tick the checkmark once you have read this."
	]
	quest.30622D9F1018E73D.title: "Potions Use Create"
	quest.30BAD4A8F5EA495E.quest_desc: [
		"Vanilla anvils repair equipment and rename items. Repair with the correct material or combine two matching pieces of equipment. Renaming alone costs one experience level; renaming during a repair adds one level."
		"Repairs keep the first item's enchantments. Enchantments from the second item are never transferred or upgraded, and enchanted books cannot be applied."
		"Use a Blaze Forger to combine or apply enchantments."
		"{\"text\":\"Open the Blaze Forger quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"218B6C60AB1E94C1\"}}"
		"Tick the checkmark once you have read this."
	]
	quest.30BAD4A8F5EA495E.title: "Anvils: Repair and Rename"
	quest.3112827E9ACCF62F.quest_desc: ["Feeds player with food from backpack's inventory More options for when food gets fed to player Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.31333469FE4F552C.quest_desc: ["Convert an existing Tier 1 Plus stack upgrade into Tier 4. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.3179FAFC15A4BD3D.quest_desc: ["Apply this tier upgrade to a matching Basic storage container to raise it to Netherite tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.31A8F6CD2AEC9561.quest_desc: [
		"Check JEI for its recipe. Feed it to a Blaze Enchanter or Blaze Forger to activate Super Enchanting mode."
		"Keep supplying Liquid Experience, and place a Lightning Rod nearby before processing anything."
	]
	quest.31A8F6CD2AEC9561.title: "Cake o' Enchanting"
	quest.31C9CF030EAE9B98.quest_desc: [
		"Ask about gift preferences, then give a preferred item."
		"Check their reaction. Repeating the same gift gives less reputation."
	]
	quest.31C9CF030EAE9B98.title: "A Gift They Actually Like"
	quest.31F52CD7E69B4517.quest_desc: [
		"The vanilla Enchanting Table can still be crafted and placed, but its enchanting interface is disabled."
		"Use a Blaze Enchanter from Create: Enchantment Industry to enchant equipment."
		"{\"text\":\"Open the Blaze Enchanter quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7AEE5B1EC5B455A4\"}}"
		"Tick the checkmark once you have read this."
	]
	quest.31F52CD7E69B4517.title: "Enchanting Has Moved"
	quest.31F6B24DF0F03C1B.quest_desc: ["Craft every armor piece shown in the task and keep the complete set together. Equip it before the next expedition and check durability after combat."]
	quest.31F6B24DF0F03C1B.title: "Zinc Armor"
	quest.31FA5E78F5F3B499.quest_desc: ["Use the rewards to decorate a village meeting place."]
	quest.31FA5E78F5F3B499.title: "A Welcoming Corner"
	quest.3231F96980C158AD.quest_desc: ["Use coal for furnace fuel and torches. Light the route home before exploring deeper caves."]
	quest.3231F96980C158AD.title: "Get some heat"
	quest.324B7881A70D6BEA.quest_desc: [
		"Pay 1,000 emeralds in wages through Payment Boxes."
		"Optional long-term goal."
	]
	quest.324B7881A70D6BEA.title: "On the Payroll"
	quest.325643FC0C0B7A5C.quest_desc: [
		"Wear a Straw Hat and break grass until you find Tea Seeds."
		"Grow tea plants and harvest Fresh Tea Leaves. Drying the leaves is the next step toward brewing your first cup."
	]
	quest.325643FC0C0B7A5C.title: "A Tea Garden"
	quest.3260161847AC90E1.quest_desc: ["Use smoke when harvesting an occupied hive."]
	quest.3260161847AC90E1.title: "A Garden for Neighbors"
	quest.32B261048B074E97.quest_desc: [
		"Grow your Tomato Seeds and collect 16 Tomatoes."
		"Keep a supply for Scrambled Eggs with Tomatoes, Borscht and rice bowls."
	]
	quest.32B261048B074E97.title: "Red Harvest"
	quest.32DBFC50EF2DA03A.quest_desc: ["This tank supports the portable equipment branch. Check its JEI uses for compatible engines or equipment and compare its capacity before making the next tier."]
	quest.32DBFC50EF2DA03A.title: "Small Fueling Tank"
	quest.33168DDC01DE24BA.quest_desc: ["An advanced proxy block for fluid containers with filtering capabilities that restricts which fluids can pass through"]
	quest.33168DDC01DE24BA.title: "Smart Fluid Interfaces and Outlets"
	quest.331F655A447D9BC3.quest_desc: [
		"Place the pot over a lit heat source."
		"Add the correct broth first, then the ingredients. Close the lid and wait for cooking to finish. Opening the lid pauses cooking."
		"Lift the lid and serve with the required container. Most soups use Bowls; certain dishes use Flower Pots. Water, milk and lava bases lead to different recipes."
	]
	quest.331F655A447D9BC3.title: "Soup Needs a Lid"
	quest.3349195917161F45.quest_desc: ["Apply this tier upgrade to a matching Copper storage container to raise it to Iron tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.33D03300FCBE74B5.quest_desc: ["Makes backpack pickup items Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.33FFC4F03C4643E8.quest_desc: ["Craft every armor piece shown in the task and keep the complete set together. Equip it before the next expedition and check durability after combat."]
	quest.33FFC4F03C4643E8.title: "Diamond armor"
	quest.342F2C0639E8DC32.quest_desc: ["Turtles drop scutes as babies grow into adults. Protect eggs and hatchlings while waiting for them to mature."]
	quest.342F2C0639E8DC32.title: "TMNT!"
	quest.344B774B8B7F9F85.quest_desc: ["Let Echo of the End answer a killing blow for you"]
	quest.344B774B8B7F9F85.title: "Cheated Death"
	quest.3467CE92D0994FE3.quest_desc: [
		"Use a hoe on soil under water to create paddy farmland. Plant Wild Rice and let it mature before harvesting Rice Panicles."
		"Complete both the flooded-farmland and rice-harvest advancements for this quest."
	]
	quest.3467CE92D0994FE3.title: "A Paddy and Its First Harvest"
	quest.34B331B2581F1480.quest_desc: [
		"Complete the Shifting Gears Create advancement."
		"Connect small and large cogwheels to change a rotation network. Use the advancement screen for its exact trigger and Ponder to inspect gear ratios."
	]
	quest.34B331B2581F1480.title: "Change Gear Ratios"
	quest.34B7A2BBC02333B1.quest_desc: ["Use it at a Smithing Table to make blaze-powered enchanting equipment. Check JEI for the ingredients."]
	quest.34B7A2BBC02333B1.title: "Smithing Template"
	quest.34E093D3D00D4C04.quest_desc: ["Craft every armor piece shown in the task and keep the complete set together. Equip it before the next expedition and check durability after combat."]
	quest.34E093D3D00D4C04.title: "Netherite armor"
	quest.3573B0C3B203FBC9.quest_desc: [
		"Make an Echo Cake Base, then fill it with Molten Echo to obtain an Echo Cake."
		"The base uses heated compacting with egg, sugar and Sculk Flour. The finished cake is made under a Spout; check JEI for the exact amounts."
	]
	quest.3573B0C3B203FBC9.title: "Echo Cake"
	quest.3653A4F5DEB5848D.quest_desc: [
		"Prepare the Peony Tea Bag and brew Coronation."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.3653A4F5DEB5848D.title: "Coronation"
	quest.3699113CF194603C.quest_desc: ["Press iron ingots into sheets. Save them for machinery, fans and other workshop components."]
	quest.3699113CF194603C.title: "Iron Sheet"
	quest.369A0BBDBC1EA479.quest_desc: ["Redstone lets you control machines with levers, signals and sensors. Keep spare dust for workshop controls."]
	quest.369A0BBDBC1EA479.title: "Redstone Dust"
	quest.36A95B3D32196640.quest_desc: ["Blasting ores and metal stuff in an upgrade tab Automatically pulls/pushes items Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.36C73ED6CE9A478B.quest_desc: ["Filters items piped in and/or out of backpack Has more filtering options Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.370DF11CB7CA9B1D.quest_desc: ["Wooden and Metal Brackets decorate workshop machinery. Use them to support the appearance of a finished shaft or pipe run."]
	quest.370DF11CB7CA9B1D.title: "Wooden and Metal Brackets"
	quest.37673ABCE02F2D8C.quest_desc: ["Smelt raw iron and keep a small reserve for buckets, tools and the first Create components."]
	quest.37673ABCE02F2D8C.title: "First iron"
	quest.377F0737509A1E40.quest_desc: ["This engine belongs to the portable equipment branch. Check JEI uses to see which equipment and tanks it supports."]
	quest.377F0737509A1E40.title: "Hydraulic Engine"
	quest.37AEDAA5DCD73DFB.quest_desc: [
		"Craft an Oil Can and fill it with Oil."
		"Use the filled can on a wok to add oil before cooking. The item tooltip shows how much oil remains."
	]
	quest.37AEDAA5DCD73DFB.title: "An Oil Can for the Cook"
	quest.37B07006A3AB1EA0.quest_desc: [
		"Plan fluid lines with a clear source, pump and destination."
		"Use separate tanks or filtered lines for different fluids, and inspect pump direction before starting the machinery. Complete this information quest manually."
	]
	quest.37B07006A3AB1EA0.title: "Colored Fluid Pipes"
	quest.37BBD0F69107DDD9.title: "Toasted Flower Cake"
	quest.37C8B239F69E5EB7.quest_desc: [
		"Find a villager. This mod adds reputation, dialogue, hired workers and building."
		"Start with Talk, then follow the trust and work branches."
	]
	quest.37C8B239F69E5EB7.title: "Meet the Village"
	quest.37DDCD82AF641961.quest_desc: ["Smelt zinc ore into ingots. Zinc is useful for this equipment branch and later for Brass production."]
	quest.37DDCD82AF641961.title: "Zinc Ingot"
	quest.380016CD84BA8750.quest_desc: ["Combine Fishing Rod and Pink Petals to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Cherry Grove. Use it again to return to manual control."]
	quest.381A43D155C8D44B.quest_desc: [
		"Craft and place a Chopping Board. Put a suitable ingredient on it, then cut it with a Cookery kitchen knife."
		"For example, four cuts turn a Raw Porkchop into three Raw Pork Bellies. Cutting dough is another way to prepare Raw Noodles."
	]
	quest.381A43D155C8D44B.title: "A Place to Chop"
	quest.384D57C7926A4C21.quest_desc: ["Combine Fishing Rod and Dark Oak Log to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Dark Forest. Use it again to return to manual control."]
	quest.3856839706A473A7.quest_desc: [
		"Look for Echo Shards in Ancient City loot."
		"Save it for the Echo Create processing chain. The heated recipes use Create machinery, so check JEI before spending a rare shard."
	]
	quest.3856839706A473A7.title: "Echo Shard"
	quest.3858CBA666869D72.quest_desc: ["Complete a villager trade using the Trade option."]
	quest.3858CBA666869D72.title: "A Fair Trade"
	quest.390F1880AC24A74B.quest_desc: ["Finish the trophy progression and obtain the Trophy of the Older Angler."]
	quest.390F1880AC24A74B.title: "Master Angler"
	quest.3942FC6D7F2EABD0.quest_desc: ["Apply this tier upgrade to a matching Copper storage container to raise it to Diamond tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.39F6DE533381DD03.quest_desc: ["Install this downgrade to reduce stack capacity in the storage. It is useful when you want smaller buffers or tighter limits on stored ingredients."]
	quest.3A80D70586C1874B.quest_desc: ["Combine Fishing Rod and Dirt to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Plains. Use it again to return to manual control."]
	quest.3A9FDA6CBEEF79B0.quest_desc: ["Combine Fishing Rod and Sandstone to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Desert Pyramid. Use it again to return to manual control."]
	quest.3AA7EA5DAD1AE8FB.quest_desc: [
		"Breed an animal."
		"Later, try the Animal Handling work role."
	]
	quest.3AA7EA5DAD1AE8FB.title: "Neighbors of Every Kind"
	quest.3AB64A78FB2701A8.quest_desc: ["Combine Fishing Rod and Ice to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Ice Spikes. Use it again to return to manual control."]
	quest.3AE82A5CE3BA0BA5.quest_desc: [
		"Have ten villagers working in different roles with valid storage and payment."
		"Use the Clipboard to fix idle jobs."
	]
	quest.3AE82A5CE3BA0BA5.title: "A Well-Oiled Village"
	quest.3AFF12DA0AD60F58.quest_desc: ["Smithing Table in an upgrade tab Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.3B24329B4B8B46A8.quest_desc: ["Mix copper and zinc in a heated Basin to make Brass. Keep your Blaze Burner fueled while the mixer runs."]
	quest.3B24329B4B8B46A8.title: "Brass Ingot"
	quest.3C98262462D5A221.quest_desc: ["Place a Selling Bin and use its interface to check which catches can be sold."]
	quest.3C98262462D5A221.title: "Sell the Surplus"
	quest.3C9ECE6486F81907.quest_desc: ["Use Mechanical Grindstones to process Nuggets of Experience, or deposit your own experience through an Experience Hatch. Collect the liquid in storage and fill a bucket with a Spout."]
	quest.3C9ECE6486F81907.title: "Bucket o' Enchanting"
	quest.3CA8D351650A36E1.quest_desc: ["Keep your rod, bait and tackle together. Any color of Tackle Box completes this quest."]
	quest.3CA8D351650A36E1.title: "Everything in One Box"
	quest.3CE44311899D723E.quest_desc: ["The Brush uncovers items in suspicious sand and gravel; the Spyglass helps inspect distant landmarks. Bring both on exploration trips."]
	quest.3CE44311899D723E.title: "Additional tools"
	quest.3D1707A7126817AA.quest_desc: ["Pack storage with Packing Tape before moving it with its contents. Check the packed state before breaking the block."]
	quest.3D50343FF5435045.quest_desc: ["Stonecutter in an upgrade tab Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.3D6CE534E2E35B95.quest_desc: ["Combine Fishing Rod and Mud to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Mangrove Swamp. Use it again to return to manual control."]
	quest.3D8E5877B1DDB989.quest_desc: [
		"Place a Lightning Rod on a Block of Experience under an open sky and let lightning strike it. Collect the resulting Block of Super Experience."
		"Natural lightning only has a chance to transform the block. Lightning produced by Super Enchanting guarantees the transformation."
	]
	quest.3D8E5877B1DDB989.title: "Block of Super Experience"
	quest.3DA2C9898CC3CF37.quest_desc: ["Combine Fishing Rod and Gravel to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Deep Ocean. Use it again to return to manual control."]
	quest.3DC5D5F823216033.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.3DC5D5F823216033.title: "Dong Ding Oolong Tea"
	quest.3DE01069F66D40DC.quest_desc: [
		"The vanilla Grindstone can still be crafted, placed and used as a villager workstation, but its interface is disabled. Repairing two tools in the crafting grid is also disabled; use an anvil for repairs."
		"Use Mechanical Grindstones from Create: Enchantment Industry to remove enchantments. Follow the linked quest to build a Grindstone Drain."
		"{\"text\":\"Open the Mechanical Grindstone quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"26A4E6CE696C4E90\"}}"
		"Tick the checkmark once you have read this."
	]
	quest.3DE01069F66D40DC.title: "Disenchanting Uses Create"
	quest.3E0EA003CE92277D.quest_desc: [
		"This quest requires both Spirit-Taking and Spiritual Return."
		"Attach an Experience Hatch to experience storage. While you have some experience, right-click the hatch to deposit it and earn Spirit-Taking."
		"Then sneak-right-click the hatch to withdraw stored experience and earn Spiritual Return."
	]
	quest.3E0EA003CE92277D.title: "Deposit and Withdraw Experience"
	quest.3E4AAB0CA62EC7A5.quest_desc: ["Apply this tier upgrade to a matching Copper storage container to raise it to Netherite tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.3EB63084D4EADE95.quest_desc: [
		"Prepare all eight wok dishes in this collection."
		"A full table of meat dishes and homestyle favorites is a fine way to show how far your cooking has come."
	]
	quest.3EB63084D4EADE95.title: "A Wok Full of Possibilities"
	quest.3EB8DF8E935FFAB2.quest_desc: ["Craft every armor piece shown in the task and keep the complete set together. Equip it before the next expedition and check durability after combat."]
	quest.3EB8DF8E935FFAB2.title: "Beam Reactor Helmet"
	quest.3EBFA9E79DA28C74.quest_desc: ["Chutes move items vertically; Portable Storage Interfaces transfer items between a moving contraption and a stationary inventory. Plan the unloading point before building the contraption."]
	quest.3EBFA9E79DA28C74.title: "Chutes and Portable Storage Interfaces"
	quest.3F0E3ACDF96118E0.quest_desc: ["Convert an existing Tier 3 stack upgrade into Tier 4. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.3F59E2A7EA323266.quest_desc: ["Install this downgrade to reduce stack capacity in the backpack. It is useful when you want smaller buffers or tighter limits on stored ingredients."]
	quest.3F7CB76FAFCB60BB.quest_desc: ["Upgrade the diving equipment through the recipes shown in JEI. Keep the Backtank charged and check each piece's tooltip before entering hazardous areas."]
	quest.3F7CB76FAFCB60BB.title: "Netherite Diving Equipment"
	quest.3F868482803DAB14.quest_desc: ["Pulls items from block on top and/or pushes them to block below Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.3FEB945757AABD91.quest_desc: ["Blasting ores and metal stuff in an upgrade tab Automatically pulls/pushes items Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.4072B9308C60E030.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.4072B9308C60E030.title: "Wheat Aroma Oolong Tea"
	quest.407B72483A170B38.quest_desc: ["Check the material and mining tier before replacing your current tools, and keep spare materials for repairs or replacements."]
	quest.407B72483A170B38.title: "Golden tools"
	quest.409497BFC3A95AA2.quest_desc: ["Used to configure interaction points for Mechanical Arm, Mechanical Pipette, Ejector Depot, Packager, Re-packager, Package Frogport and Postbox"]
	quest.409497BFC3A95AA2.title: "Conductor's Baton"
	quest.40A6565625187BB7.quest_desc: ["Combine Fishing Rod and Brown Mushroom to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Mushroom Fields. Use it again to return to manual control."]
	quest.40CF4CF2C6070E83.quest_desc: ["Check the material and mining tier before replacing your current tools, and keep spare materials for repairs or replacements."]
	quest.40CF4CF2C6070E83.title: "Copper tools"
	quest.410136DBD81826AE.quest_desc: ["Stonecutter in an upgrade tab Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.414BD8183FC1DB59.quest_desc: ["Use Smart Fluid Pipes to filter a line. The Fluid Interface and Copper Tap add access points for containers and handling."]
	quest.414BD8183FC1DB59.title: "Fluid Filtering and Interfaces"
	quest.4163A6E3669BF1FE.quest_desc: ["Magnets items into backpack at range Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.41A20ACB13164437.quest_desc: [
		"Craft and place a Stove, then light it with Flint and Steel."
		"Place your cookware directly above it. The Wok, Stockpot, Steamer and Teapot all need a suitable heat source to work."
	]
	quest.41A20ACB13164437.title: "Light the Kitchen Stove"
	quest.41C9346D96132773.quest_desc: ["Magnets items into storage at range Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.41D5081374637198.quest_desc: [
		"Backpack upgrades add portable processing, collection and storage functions."
		"The pack includes Create integrations. Check JEI and the installed upgrade's controls when combining a backpack with workshop machinery. Complete this information quest manually."
	]
	quest.42098B324D18C982.quest_desc: ["Feed a Blaze Cake to a Blaze Burner when a recipe requires superheating. Prepare the other ingredients before starting the short heating window."]
	quest.42098B324D18C982.title: "Blaze Cake"
	quest.42408D30E9E3D5AA.quest_desc: [
		"Craft two Warp Plates for a direct travel connection."
		"Bind their Attuned Shards to the intended destinations. Test the connection before building around the plates."
	]
	quest.424CEB02A965702F.quest_desc: ["Install this stack upgrade in the backpack to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.4282DF8E765BC5A3.quest_desc: ["This portable engine is a crafting component for Create Stuff & Additions equipment. Check JEI uses to distinguish its recipes from Create's boiler-mounted engine."]
	quest.4282DF8E765BC5A3.title: "Steam Engine"
	quest.43107C302A84BCD3.quest_desc: ["Equip a villager with all four Netherite armor pieces."]
	quest.43107C302A84BCD3.title: "Cover Them in Debris"
	quest.43480626E3969730.quest_desc: [
		"Prepare the Red Tulip Tea Bag and brew Crimson Heartbeat."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.43480626E3969730.title: "Crimson Heartbeat"
	quest.4385CF0674440B79.quest_desc: ["Use the Treetap on a sap-bearing section of a Rubber Log to collect Sap. Harvesting turns that section into a dry log; look for another sap-bearing section when continuing collection."]
	quest.4385CF0674440B79.title: "Treetap"
	quest.43C3C2B27CBC81BB.quest_desc: ["Attach the engine to a heated, water-filled Fluid Tank boiler, connect its output to a shaft and run the setup. Check the advancement screen for the exact trigger."]
	quest.43C3C2B27CBC81BB.title: "Steam Engine Power"
	quest.4412073CF62DE5A0.quest_desc: ["Pin a creature with a thrown raw flower cake"]
	quest.4412073CF62DE5A0.title: "A Flower Blooms in an Instant"
	quest.4422717366FCA8B5.quest_desc: ["Attach the whistle to a boiler setup. Inspect its Ponder scene before arranging the steam connection and sound control."]
	quest.4422717366FCA8B5.title: "Steam Whistle"
	quest.449A09FC50B32D81.quest_desc: ["These blocks cover drilling, sawing, harvesting, ploughing and milling. Use Ponder on each machine to check its working face and rotation requirements."]
	quest.449A09FC50B32D81.title: "Drilling, Sawing, Harvesting and Milling"
	quest.44ACA092F075A53A.quest_desc: ["A Clutch can stop rotation with redstone, while a Gearshift reverses it. Use the controls before connecting a moving contraption."]
	quest.44ACA092F075A53A.title: "Clutches and Gearshifts"
	quest.44B5B724B77BA445.quest_desc: ["An uncommon Guardian drop that is useful in constructing sophisticated Laser Defense Systems."]
	quest.44B5B724B77BA445.title: "Guardian Beam Capacitor"
	quest.456D272E7E8BA723.quest_desc: ["Its special effects are explored in the separate achievement group."]
	quest.456D272E7E8BA723.title: "Dew Flower Cake"
	quest.4575562F00370907.quest_desc: [
		"Craft a Warp Stone and activate at least one useful Waystone destination."
		"Hold use to charge the stone and choose a destination. Keep it accessible while exploring."
	]
	quest.45E055006C565687.quest_desc: ["Super Packing Tape serves the same moving workflow as ordinary Packing Tape. Compare remaining uses in its tooltip before a large relocation."]
	quest.45F6C4E6B990D7E1.quest_desc: [
		"Prepare all six rice dishes in this collection."
		"A simple bowl of rice can become a satisfying meal in many different ways."
	]
	quest.45F6C4E6B990D7E1.title: "Everything Goes with Rice"
	quest.45F96D7285E43614.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.45F96D7285E43614.title: "Sakura Fubuki"
	quest.465BA3AEA3A3CBA6.quest_desc: ["Combine Fishing Rod and Red Tulip to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Flower Forest. Use it again to return to manual control."]
	quest.466C27AF96C42B6F.quest_desc: ["Convert an existing Tier 4 stack upgrade into Tier 5. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.467C8D49D8B06F28.quest_desc: [
		"Prepare the Allium Tea Bag and brew Fire Waltz."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.467C8D49D8B06F28.title: "Fire Waltz"
	quest.468E483F6C1824A1.quest_desc: [
		"Prepare the Wither Rose Tea Bag and brew Les Fleurs du Mal."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.468E483F6C1824A1.title: "Les Fleurs du Mal"
	quest.46E5C078BBA7DBA0.quest_desc: [
		"Prepare all four dishes in this Stockpot collection."
		"A few hearty pots of food will keep your kitchen busy and your guests well fed."
	]
	quest.46E5C078BBA7DBA0.title: "Four Hearty Pots"
	quest.46E5C8D3EB55E094.quest_desc: [
		"Craft a Grease Crock and fill it with Oil."
		"Right-click it with a Kitchen Spatula to coat the tool, then use the spatula on your wok to add oil."
	]
	quest.46E5C8D3EB55E094.title: "Keep the Grease Close"
	quest.4708422455C5A9D2.quest_desc: ["Roll three double drops within one Voracious Urn"]
	quest.4708422455C5A9D2.title: "Greed Without End"
	quest.4774F2251BA09C98.quest_desc: [
		"Add a reference item and choose its properties."
		"Use Match Any or Match All to control filtering."
	]
	quest.4774F2251BA09C98.title: "Filter by Properties"
	quest.47F237EC52750253.quest_desc: ["Combine Fishing Rod and Mossy Cobblestone to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Jungle Pyramid. Use it again to return to manual control."]
	quest.4883D2EDD94068B0.quest_desc: ["Combine Fishing Rod and Bamboo to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Bamboo Jungle. Use it again to return to manual control."]
	quest.4884F241917CF638.quest_desc: ["Combine Fishing Rod and Terracotta to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Badlands. Use it again to return to manual control."]
	quest.48BC7D32720211EC.quest_desc: ["Equip this Jetpack Chestplate and check its fuel or fluid requirements in the tooltip. Set the flight controls and test a short takeoff over safe ground."]
	quest.48BC7D32720211EC.title: "Netherite Jetpack"
	quest.4915E8EEF2C80B5F.quest_desc: ["Compacts items into their compressed variants Both 2x2 and 3x3 recipes with more filtering options Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.4947927209839467.quest_desc: ["Convert an existing Starter Tier stack upgrade into Tier 2. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.496A3712165EAE4F.quest_desc: ["Buried treasure can contain a Heart of the Sea, while Nautilus Shells are found through fishing and other sources. Save them for conduit-related recipes."]
	quest.496A3712165EAE4F.title: "Conduit Ingredients"
	quest.49AE28A4543EF4CB.quest_desc: ["Crafting table in an upgrade tab Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.49C623B7E769A901.quest_desc: ["Convert an existing Tier 1 Plus stack upgrade into Tier 2. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.4AC4AD33A0A1C6F5.quest_desc: ["Increases the chance of hooking a golden fish."]
	quest.4AC4AD33A0A1C6F5.title: "A Golden Bite"
	quest.4BA7892EA25F733A.quest_desc: [
		"Place a Teapot on a suitable heat source. Add the liquid and tea ingredient required for the tea you want to brew."
		"Wait until brewing finishes, then serve with Empty Cups. Add liquid and ingredients while the teapot is in its preparation stage."
	]
	quest.4BA7892EA25F733A.title: "Put the Kettle On"
	quest.4BC316F0759BB2A5.quest_desc: [
		"Craft a Portal Scroll to open a temporary travel portal."
		"Hold use, select an activated Waystone and leave enough clear space for the portal to appear. The scroll is consumed when the portal opens."
	]
	quest.4BF0577D3CEC56AF.quest_desc: ["This tank supports the portable equipment branch. Check its JEI uses for compatible engines or equipment and compare its capacity before making the next tier."]
	quest.4BF0577D3CEC56AF.title: "Medium Fueling Tank"
	quest.4C14663895EEEF52.quest_desc: [
		"Prepare the Pink Tulip Tea Bag and brew Rosy Stride."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.4C14663895EEEF52.title: "Rosy Stride"
	quest.4C21BD4944CBDC53.quest_desc: ["Taste every available Flora flower drink."]
	quest.4C21BD4944CBDC53.title: "A Garden in Full Bloom"
	quest.4C4599A10BE1B633.quest_desc: [
		"Your Sniffer has discovered cosplay."
		"Right-click a tamed Sniffer with certain items to completely change its appearance. These variants are purely cosmetic, so choose your favorite or collect the whole prehistoric wardrobe."
		"Available cosplays:"
		"Acacia — Acacia Leaves"
		"Sculk — Echo Shard"
		"Cherry — Pink Petals"
		"Cold — Snowball"
		"Desert — Sand"
		"Desert Pyramid — Sandstone"
		"Ender — Popped Chorus Fruit"
		"Jungle — Cocoa Beans"
		"Mushroom — Mycelium"
		"Nether — Crimson Roots"
		"Swamp — Mangrove Propagule"
		"And, of course, there is always the classic Default Sniffer for those who refuse to participate in cosplay."
		"Find your favorite look... or collect them all. Your Sniffer didn't survive extinction just to have one outfit."
	]
	quest.4C4599A10BE1B633.title: "Sniffer Cosplay Convention"
	quest.4C6AD6CB9F99191D.quest_desc: ["These blocks are used to make Enchanting Templates and can be transformed into Blocks of Super Experience by lightning. Check JEI for the recipe."]
	quest.4C6AD6CB9F99191D.title: "Block of Experience"
	quest.4C736C29248A426E.quest_desc: ["Choose Duel, select a loadout and wager, then win the non-lethal fight."]
	quest.4C736C29248A426E.title: "Friendly Competition"
	quest.4C8BA6D3AB53C9EE.quest_desc: [
		"Right-click crops to harvest them and remove weeds."
		"Keep it with your farming tools as your vegetable beds and rice fields expand."
	]
	quest.4C8BA6D3AB53C9EE.title: "A Cleaner Harvest"
	quest.4CE6CAC38213C268.quest_desc: ["Cookery knives prepare ingredients on the Chopping Board. Higher-tier knives make useful upgrades as you spend more time in the kitchen."]
	quest.4CE6CAC38213C268.title: "A Blade for the Chef"
	quest.4DB5312EFD5053BB.quest_desc: [
		"Place a Lightning Rod near a Blaze Enchanter under an open sky."
		"Supply Liquid Experience and feed the enchanter a Cake o' Enchanting to activate Super Enchanting mode. Set an equipment item, such as a pickaxe, in its filter slot and choose an enchanting level."
		"Process Super Enchanting Templates until a result includes a treasure enchantment, such as Mending. This grants Probability Spike. You may need several attempts."
	]
	quest.4DB5312EFD5053BB.title: "Treasure Enchantments with Lightning"
	quest.4E6536570DDAD4B9.quest_desc: [
		"This ancient creature may look like it pays taxes to nobody... and that's because it doesn't."
		"Give a Sniffer a Pitcher Pod to tame it."
		"Once you've earned its trust, you can:"
		"Equip a Saddle — yes, you can ride the giant mossy dinosaur."
		"Attach a Chest — because apparently your dinosaur is also a backpack."
		"Add a Carpet — all 16 colors work, because fashion is important even when you're extinct."
		"Its chest provides 25 storage slots, making your new prehistoric friend surprisingly useful on long adventures."
	]
	quest.4E6536570DDAD4B9.title: "A Sniffer Companion"
	quest.4EABF4A050EC94CD.quest_desc: [
		"Prepare the Lily of the Valley Tea Bag and brew May Kiss."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.4EABF4A050EC94CD.title: "May Kiss"
	quest.4ECC51DB18B1540D.quest_desc: [
		"Craft and place a Scarecrow to protect the surrounding farmland."
		"Right-click it with suitable heads, lanterns or tools to decorate your new field guardian."
	]
	quest.4ECC51DB18B1540D.title: "Someone to Watch the Crops"
	quest.4EEF51C72C7FA08B.quest_desc: ["Keep the Heat Engine for the compatible portable equipment recipes shown in JEI. Prepare its required tank before upgrading your equipment."]
	quest.4EEF51C72C7FA08B.title: "Heat Engine"
	quest.4EF30842961B514C.quest_desc: [
		"Enter the Nether through a lit Nether portal."
		"Bring food, spare blocks and a way to relight the portal. Record the entrance before exploring."
	]
	quest.4EF30842961B514C.title: "There is hot"
	quest.4F7A0DB004A895AA.quest_desc: ["Transports further and faster than Mechanical Pumps, can be encased with Copper Casing"]
	quest.4F7A0DB004A895AA.title: "Pumps and Redstone Valves"
	quest.4F914EAA5FC2FD3F.quest_desc: [
		"Prepare the Azure Bluet Tea Bag and brew The Unnoticed."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.4F914EAA5FC2FD3F.title: "The Unnoticed"
	quest.4FA6F8DB9FB7E44D.quest_desc: ["Copper Casings are used for fluid machinery. Make a small batch before building pumps and tanks."]
	quest.4FA6F8DB9FB7E44D.title: "Copper Casing"
	quest.4FB5C6F97628D84D.quest_desc: ["Apply this tier upgrade to a matching Copper storage container to raise it to Gold tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.4FC62F5A745262F5.quest_desc: ["Brass Casings support the precision stage of Create. Keep a batch for Mechanical Crafters and more advanced workshop machinery."]
	quest.4FC62F5A745262F5.title: "Brass Casing"
	quest.4FC8B0B6D84E9EE0.quest_desc: ["Connect pipes between your source and destination. A powered Mechanical Pump supplies the direction and flow for the line."]
	quest.4FC8B0B6D84E9EE0.title: "Fluid Pipe"
	quest.4FE7E5CB1B9402CD.quest_desc: ["Complete quests for ten different villagers in the same village."]
	quest.4FE7E5CB1B9402CD.title: "The People's Champion"
	quest.4FE8D62B58B25DBC.quest_desc: ["Prepare a cup of Flower Tea for your tasting collection."]
	quest.4FE8D62B58B25DBC.title: "Flower Tea"
	quest.5001800E8FE5FA4F.quest_desc: ["Use the Fish Radar to inspect fishing conditions and plan your next catch."]
	quest.5001800E8FE5FA4F.title: "Read the Water"
	quest.504ADAA47E732AB6.quest_desc: ["This tank supports the portable equipment branch. Check its JEI uses for compatible engines or equipment and compare its capacity before making the next tier."]
	quest.504ADAA47E732AB6.title: "Medium Filling Tank"
	quest.51181E7058AA394E.quest_desc: [
		"A Cookery Iron Kitchen Knife can be crafted from three Iron Ingots and a Stick."
		"Cookery kitchen knives cut ingredients on a Chopping Board. They can also provide Oil when used to kill pigs, piglins or hoglins."
	]
	quest.51181E7058AA394E.title: "Every Kitchen Needs a Knife"
	quest.51554766CA897553.quest_desc: ["Make a Fish Plaque to display a catch. Any wood variant counts."]
	quest.51554766CA897553.title: "A Catch for the Wall"
	quest.5161081A58AD5C77.quest_desc: ["You can use trial key to  reset vault"]
	quest.5161081A58AD5C77.title: "Reuse key"
	quest.5166ACCCD8F53010.quest_desc: [
		"Prepare the Cornflower Tea Bag and brew The Prussian Leap."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.5166ACCCD8F53010.title: "The Prussian Leap"
	quest.517CAFE33962A58E.quest_desc: ["Look for blazes in Nether fortresses. Rods become blaze powder for brewing and Eyes of Ender."]
	quest.517CAFE33962A58E.title: "Some hot rods"
	quest.518102CB0AC51869.quest_desc: ["Install this stack upgrade in the backpack to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.51D70276D620DD81.quest_desc: ["Craft every armor piece shown in the task and keep the complete set together. Equip it before the next expedition and check durability after combat."]
	quest.51D70276D620DD81.title: "Iron armor"
	quest.51FB462DA31CB755.quest_desc: ["Set the ejector's destination before supplying items. Keep its landing area clear and use Ponder to inspect the trajectory setup."]
	quest.51FB462DA31CB755.title: "Weighted Ejector"
	quest.5200A63BBA47114A.quest_desc: ["Let a Sniffer search suitable ground, and grow the recovered seeds before harvesting the flowers. Check JEI for the Ancient Sapling's available sources."]
	quest.525F9C43C7D2E378.quest_desc: [
		"Hire a worker through Recruit or Hire."
		"Assign a reachable work area, tools, storage and payment. Check Clipboard diagnostics if work stops. Self-check: tick when done."
	]
	quest.525F9C43C7D2E378.title: "Hire Your First Worker"
	quest.52BBE1F320D98911.quest_desc: ["Portable Jukebox with support for more music discs Also more playback options Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.52CBF69BE2AB6465.quest_desc: ["Convert an existing Tier 1 stack upgrade into Tier 5. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.530872E6174F2B8B.quest_desc: ["Equip the Exoskeleton Chestplate and inspect its operating requirements. Check the assigned controls before testing its movement features."]
	quest.530872E6174F2B8B.title: "Netherite Exoskeleton"
	quest.533F256CE5FF18DA.quest_desc: ["Smoking food in an upgrade tab Automatically pulls/pushes items Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.534757936CD06941.quest_desc: ["Blasting ores and metal stuff in an upgrade tab Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.535376AC4DDE123D.quest_desc: [
		"A windmill is a renewable source of rotation for your workshop."
		"Assemble sails around a Windmill Bearing, check that the structure can rotate, and connect its output to your machines. Complete this information quest manually."
	]
	quest.535376AC4DDE123D.title: "Windmill Setup"
	quest.535855FF6D033C77.quest_desc: ["Super Glue joins blocks into a contraption. Use the bearing, piston or Cart Assembler suited to the movement you want, and leave its route clear."]
	quest.535855FF6D033C77.title: "Build Moving Contraptions"
	quest.5366AD37EA36D995.quest_desc: ["Portable Jukebox Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.543C2519A43A09F0.quest_desc: ["Convert an existing Starter Tier stack upgrade into Tier 3. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.5476426B444157D0.quest_desc: ["Compacts items into their compressed variants Only 2x2 recipes Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.54CDCEC18486F91D.quest_desc: ["Feeds player with food from storage's inventory More options for when food gets fed to player Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.550BCB5EA87CE32E.quest_desc: [
		"Prepare the Orange Tulip Tea Bag and brew Autumn Serenade."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.550BCB5EA87CE32E.title: "Autumn Serenade"
	quest.553658BD42F3F7FE.quest_desc: ["Convert an existing Tier 1 stack upgrade into Tier 3. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.553CCE4F4F33FBCD.quest_desc: ["Convert an existing Tier 1 stack upgrade into Tier 1 Plus. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.5561E25A984A8C55.quest_desc: ["Ripen 50 crops within one Vernal Awakening"]
	quest.5561E25A984A8C55.title: "Believe in the Whole Spring"
	quest.557B800D64D59710.quest_desc: ["Convert an existing Tier 1 Plus stack upgrade into Tier 3. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.55B40D3BAB1FA6A5.quest_desc: ["A Valve Handle provides manual rotation; a Fluid Valve controls a fluid line. Check the valve state before starting the pump."]
	quest.55B40D3BAB1FA6A5.title: "Fluid Valves and Handles"
	quest.55D6541D605E5BCC.quest_desc: ["Restocks backpack from sneak right clicked inventory Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.56944AF4479395C5.quest_desc: ["Convert an existing Starter Tier stack upgrade into Tier 4. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.572F0A52E3B4C07F.quest_desc: [
		"Finish cutting an ingredient on a Chopping Board with a Cookery kitchen knife."
		"Continue cutting until the ingredient changes into its prepared result. This grants the chopping advancement."
	]
	quest.572F0A52E3B4C07F.title: "Chop, Chop, Chop!"
	quest.57993FFBF672E682.quest_desc: ["Set the item to copy in its filter slot, supply the required fluid, and feed blank items underneath it. It can copy books, rename items, and more. Check JEI for printing recipes."]
	quest.57993FFBF672E682.title: "Printer"
	quest.57CFEF7965C2F8C2.quest_desc: ["Mine Nether Quartz for machinery and redstone components. It also feeds the Rose Quartz branch of Create."]
	quest.57CFEF7965C2F8C2.title: "Nether Quartz"
	quest.5938C2A162743DC7.quest_desc: ["Encased Chain Drives share rotation between connected units. Gearboxes help route the same network around corners."]
	quest.5938C2A162743DC7.title: "Gearboxes and Chain Drives"
	quest.595F2FF6E6A6425F.quest_desc: [
		"Break grass while wearing a Straw Hat to find Wild Rice."
		"Prepare flooded farmland before planting it. Mature rice plants provide Rice Panicles for your kitchen."
	]
	quest.595F2FF6E6A6425F.title: "Find Wild Rice"
	quest.5985D87670983A7A.quest_desc: [
		"Pay 10,000 emeralds in wages through Payment Boxes."
		"Optional settlement goal."
	]
	quest.5985D87670983A7A.title: "An Emerald Economy"
	quest.5993A0F3FAA25498.quest_desc: ["For the upgrade branches in this chapter, use a compatible Sophisticated Backpack. Open its inventory and inspect its upgrade slots before crafting modules."]
	quest.59A23E744C86727F.quest_desc: ["The Large Water Wheel needs more room around its axle. Set up flowing water and connect its rotation to your workshop."]
	quest.59A23E744C86727F.title: "Large Water Wheel"
	quest.5B0FA1FF4D71B700.quest_desc: [
		"Harvest 16 Lettuce and keep one Caterpillar. Caterpillars have a chance to appear when you harvest lettuce."
		"Lettuce is useful in soups and stuffed dough. The caterpillar can become a treat for a baby chicken."
	]
	quest.5B0FA1FF4D71B700.title: "An Unexpected Garden Guest"
	quest.5B18D1B9AA2FFC2A.quest_desc: ["Use them to replace wooden tools and build a furnace. The task accepts its listed material tag."]
	quest.5B18D1B9AA2FFC2A.title: "Stone age"
	quest.5B284C6EAAB96805.quest_desc: ["Allows your fishing tackle to survive lava and reach lava catches."]
	quest.5B284C6EAAB96805.title: "Fishing in Lava"
	quest.5B337FE46BEC0A30.quest_desc: ["Slimeballs are useful for sticky pistons and Super Glue. Keep a stack near the Create workbench."]
	quest.5BCDC4A61F7A3413.quest_desc: [
		"Collect 16 Rice by processing Rice Panicles in a powered Create Millstone."
		"Feed the panicles into the top of the millstone and supply rotation. Each panicle gives two Rice, with a chance for one more."
		"{\"text\":\"Open the quest with Create\\u0027s Millstone\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"449A09FC50B32D81\"}}"
	]
	quest.5BCDC4A61F7A3413.title: "From Panicle to Grain"
	quest.5BEEA73118C314D0.quest_desc: [
		"Gold equipment wears out quickly, so reserve your gold for the recipes and equipment you actually need."
		"This is an information quest. Read the advice, then complete its checkmark manually."
	]
	quest.5BEEA73118C314D0.title: "Better gold"
	quest.5C05217D7F061B19.quest_desc: ["Gold is useful for golden food, redstone components and later alloys. Keep some for your workshop."]
	quest.5C05217D7F061B19.title: "First gold"
	quest.5C184812CBA507FD.quest_desc: ["Search End cities for shulkers. Two shells and a chest make portable shulker storage."]
	quest.5C184812CBA507FD.title: "Some bodes"
	quest.5C3E81FDED808200.quest_desc: ["Install this stack upgrade in the backpack to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.5C5517B276FCD993.quest_desc: ["A rare Elder Guardian drop that is useful in constructing even better sophisticated Laser Defense Systems as well as other useful gadgets."]
	quest.5C5517B276FCD993.title: "Elder Guardian Beam Capacitor"
	quest.5C73A308C37AA0C1.quest_desc: ["Combine Fishing Rod and Sea Pickle to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Warm Ocean. Use it again to return to manual control."]
	quest.5C7B63F20EA5E2B1.quest_desc: ["Cross 50 blocks of open water in one unbroken Rosy Stride"]
	quest.5C7B63F20EA5E2B1.title: "Walk on Water"
	quest.5CBA5B8B8355E796.quest_desc: [
		"Collect 100,000 mB of Molten Echo for the fluid task."
		"The installed mixing recipe uses Echo Shards in a superheated Basin. Prepare a reliable shard supply and enough tank capacity before running the batch."
	]
	quest.5CBA5B8B8355E796.title: "Molten Echo"
	quest.5CD0E5FACB3D13F2.quest_desc: ["Moves items between storage and adjacent blocks Faster, configurable input/output from any side Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings."]
	quest.5D86D49820763D05.quest_desc: [
		"Complete requests or assignments for three related villagers."
		"Use Profile and Family to find their relatives."
	]
	quest.5D86D49820763D05.title: "Family Business"
	quest.5DAC077462DE4567.quest_desc: [
		"Its crafting grid uses Iron Sheets and a Shaft on top, Iron Sheets around a Cogwheel in the middle, and Magma Blocks around a Campfire on the bottom."
		"Load suitable food and power the spit with redstone to cook. Turn the redstone signal off before removing the food."
	]
	quest.5DAC077462DE4567.title: "Turning Up the Roast"
	quest.5DE7D88D11E26952.quest_desc: ["Prepare Worms, Almighty Worms and Seeking Worms. They reduce the wait; upgraded worms favor live fish or undiscovered catches."]
	quest.5DE7D88D11E26952.title: "A Better Bite"
