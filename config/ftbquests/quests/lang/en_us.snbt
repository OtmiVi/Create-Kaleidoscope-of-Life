	quest.19F0BF2F1153A49E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a matching pair to transfer \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between a moving \"},{\"text\":\"contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and stationary \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Align\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the interfaces at the contraption's stopping point.\"}]}"]
