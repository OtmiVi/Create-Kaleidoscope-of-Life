	quest.28571EE231DBEE76.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Refills selected item stacks in the player's \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.2872F18473170474.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Spiky Shells\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are components in the aquatic equipment branch. Reserve part of your supply for those \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rather than mixing them with decorative shells.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Gather the required materials before starting the next machine.\"}]}"
