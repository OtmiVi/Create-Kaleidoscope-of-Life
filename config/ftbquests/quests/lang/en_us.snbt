	quest.2F2D3AD96BA287FD.title: "Sap"
	quest.2F64C6BB58AEFED6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically swaps item in player's hand for the one effective on the \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"/entity when these are left clicked. Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.2F6C209015C5AE79.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Starcatcher's Display\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to show off your fishing collection.\"}]}"]
	quest.2F6C209015C5AE79.title: "The Angler's Display"
	quest.2FA0A34A470CBB4C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically picks up nearby \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.2FABE9AB55E34CB9.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Ice Box\"},{\"text\":\" is useful for food as well as industrial fluids. Use its freezing recipes to prepare vanilla, chocolate and strawberry ice cream.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the box at the recipe\u0027s required \"},{\"text\":\"temperature\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then use the matching filling or serving steps. Each flavour has its own ingredients.\"}]}"
	]
	quest.2FABE9AB55E34CB9.title: "Something Cold After the Flight"
	quest.2FE6370E7E54AC5C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.2FE82AEBE415E7C6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" entering or leaving the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.302793E330894EA8.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Voids \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" selected by its \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.30622D9F1018E73D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The vanilla \"},{\"text\":\"Brewing Stand\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" does not brew potions and its interface is disabled. Its crafting \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is removed. \"},{\"text\":\"Stands\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" found in the world remain decorative \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and cleric workstations.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew potions with a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mechanical Mixer\"},{\"text\":\" over a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Basin\"},{\"text\":\".\"}]}"
		"{\"text\":\"Open the Mechanical Mixer quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"20F032D0D2DD5D12\"}}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Tick the checkmark once you have read this.\"}]}"
	]
	quest.30622D9F1018E73D.title: "Potions Use Create"
	quest.30BAD4A8F5EA495E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Vanilla\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" anvils repair equipment and rename \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Repair\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the correct material or combine two matching pieces of equipment. \"},{\"text\":\"Renaming\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" alone costs one \"},{\"text\":\"experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" level; renaming during a repair adds one level.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Repairs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" keep the first item's \"},{\"text\":\"enchantments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Enchantments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the second item are never transferred or upgraded, and enchanted books cannot be applied.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Blaze Forger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to combine or apply \"},{\"text\":\"enchantments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"Open the Blaze Forger quest\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"218B6C60AB1E94C1\"}}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Tick the checkmark once you have read this.\"}]}"
	]
