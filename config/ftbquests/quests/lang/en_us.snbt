	quest.2A7E83771DD008F5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Enter the End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to complete the matching \"},{\"text\":\"Minecraft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement.\"}]}"
