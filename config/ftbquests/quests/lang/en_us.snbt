	quest.2A7E83771DD008F5.title: "The end?"
	quest.2B9A324817876B67.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a supply of \"},{\"text\":\"Titanium Ingots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the machines ahead. Press some into \"},{\"text\":\"Titanium Sheets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and reserve others for components and larger assemblies.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"working processing line\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is more useful than a single batch: rocket parts and life-support equipment share this material.\"}]}"
	]
	quest.2B9A324817876B67.title: "Titanium for the Workshop"
	quest.2BA36221D25AD34E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew First \"},{\"text\":\"Bloom\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Blue Orchid Tea Bag\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a heated Teapot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Serve this flower tea from your heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.2BA36221D25AD34E.title: "First Bloom"
	quest.2BA90D7AD57CB9BC.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.2BC50E5B7C28B81C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Sharestones\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" connect to other \"},{\"text\":\"Sharestones\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the same color. Use separate colors for different travel networks.\"}]}"]
	quest.2C3F068874FAC666.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Copper Magnet\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as a gathering aid. Check its tooltip and assigned controls before taking it mining.\"}]}"]
	quest.2C8A918580A3ACF0.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" two \"},{\"text\":\"Crushing Wheels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with their working gap between them and rotate them toward the gap. Use \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to check a safe item \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" arrangement.\"}]}"]
	quest.2C8A918580A3ACF0.title: "Crushing Wheel"
	quest.2CA89C5CD1750808.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically uses potions, \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with effects, or milk buckets. Use the \"},{\"text\":\"effect filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to control when it activates. Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available \"},{\"text\":\"settings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.2CB0422A1E4C20A0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Enter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Trial Chamber\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and earn the Trial(s) Edition advancement.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Look for its copper and tuff rooms underground. Bring \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and light sources for the combat encounters.\"}]}"
	]
	quest.2D100A94F7E38C73.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Stop\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"5\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" projectiles with a single Hanami Tale\"}]}"]
	quest.2D100A94F7E38C73.title: "Shield of Petals"
