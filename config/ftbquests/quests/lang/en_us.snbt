	quest.6DA5A56C1215A7BE.quest_desc: ["Obtain a Heap of Experience from Create: Stuff & Additions. Check JEI for its recipe and uses."]
	quest.6DA5A56C1215A7BE.title: "A Heap of Knowledge"
	quest.6F0B94B4E9F14856.quest_desc: [
		"Feed a Caterpillar to a baby chicken to complete the High-Quality Protein advancement."
		"Use a chick rather than an adult chicken. Save a caterpillar from your lettuce harvest for this task."
	]
	quest.6F0B94B4E9F14856.title: "Protein for a Little Chick"
	quest.6F1B12DD98D4F81E.title: "Better enchant"
	quest.6F846C8AA00B0321.quest_desc: [
		"Wear a Straw Hat and break grass to obtain Tomato Seeds."
		"Plant and grow them on farmland. Keep the ripe tomatoes for stir-fries, soups and rice bowls."
	]
	quest.6F846C8AA00B0321.title: "Tomatoes Start Small"
	quest.71DEA555C859C16F.title: "Get wood"
	quest.7204A1D376F3D7F6.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.7204A1D376F3D7F6.title: "Butter Tea"
	quest.733FCF269775E418.quest_desc: [
		"Craft a Wok and Kitchen Spatula. Place the wok directly over a lit Stove or another suitable heat source."
		"Add Oil, then the recipe ingredients. Stir with the spatula until cooking finishes; wrong ingredients or waiting too long can spoil the dish."
		"Use the required serving container, usually a Bowl, to collect the result. For dishes without a container, sneak-right-click with the Kitchen Spatula."
	]
	quest.733FCF269775E418.title: "Your First Wok"
	quest.735DF7ABE693CD2A.title: "Royale food"
	quest.74B6DA366E71A547.quest_desc: [
		"Prepare Bamboo Tube Rice in your Steamer."
		"A meal packed in bamboo is ready for a well-earned break after a day in the fields."
	]
	quest.74B6DA366E71A547.title: "Lunch in a Bamboo Tube"
	quest.754CDEB099E74278.title: "Let's drink it"
	quest.775F114D30179638.quest_desc: [
		"Craft a Bamboo Tray and lay Fresh Tea Leaves on it to dry."
		"Collect 4 Dried Tea Leaves. These are used to prepare tea ingredients for your Teapot."
	]
	quest.775F114D30179638.title: "Leaves on the Drying Tray"
	quest.780AF722C380D38C.title: "Copper armor"
	quest.78902351B2D4C08A.quest_desc: ["Hold every available Flora flower drink in your inventory at once."]
	quest.78902351B2D4C08A.title: "The Complete Bouquet"
	quest.79D85F0CE7026A9C.quest_desc: [
		"Prepare Baozi in your Steamer."
		"These filled buns are a hearty addition to your menu. Save one to share with a hungry wolf."
	]
	quest.79D85F0CE7026A9C.title: "Something Good Inside"
	quest.7A3DD8F510A38490.quest_desc: ["Obtain all four Experience tools: the Sword, Axe, Shovel, and Pickaxe. Check JEI for their recipes."]
	quest.7A3DD8F510A38490.title: "Tools of Experience"
	quest.7AEE5B1EC5B455A4.quest_desc: ["Obtain a Blaze Enchanter and supply it with Liquid Experience. Set the enchanting level on its panel, then give it an unenchanted item."]
	quest.7AEE5B1EC5B455A4.title: "An Enchanter with a Temper"
	quest.7B5B424C06E2A5B6.quest_desc: [
		"Prepare the Pink Petals Tea Bag and brew Hanami Tale."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.7B5B424C06E2A5B6.title: "Hanami Tale"
	quest.7C43EF073F6FD620.quest_desc: [
		"Prepare the Dandelion Tea Bag and brew When the Wind Rises."
