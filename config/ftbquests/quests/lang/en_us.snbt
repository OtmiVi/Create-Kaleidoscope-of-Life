	quest.7CAB79FFAFE796AC.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.7CAB79FFAFE796AC.title: "Biluochun"
	quest.7CEA7321A4EC1BC8.quest_desc: [
		"Place a Steamer on a lit Stove or another suitable heat source. Insert ingredients from the top before adding another layer."
		"With an empty hand, sneak-right-click the top steamer to close its lid and start cooking. One heat source supports up to eight layers."
		"Once the food is ready, sneak-right-click with an empty hand to open the lid, then right-click to collect it. Work down through a stack from the top."
	]
	quest.7CEA7321A4EC1BC8.title: "A Stack of Steamers"
	quest.7D19D2E0346C7CD1.title: "I can fly!"
	quest.7E9DA9380C835EAD.quest_desc: [
