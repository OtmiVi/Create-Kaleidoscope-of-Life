	quest.33168DDC01DE24BA.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"An advanced proxy \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" containers with filtering capabilities that restricts which \"},{\"text\":\"fluids\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can pass through\"}]}"]
	quest.33168DDC01DE24BA.title: "Smart Fluid Interfaces and Outlets"
	quest.331F655A447D9BC3.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place the pot over a lit \"},{\"text\":\"heat source\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add the correct broth first, then the \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Close\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the lid and wait for cooking to finish. \"},{\"text\":\"Opening\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the lid pauses cooking.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Lift\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the lid and serve with the required container. \"},{\"text\":\"Most\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" soups use \"},{\"text\":\"Bowls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; certain dishes use \"},{\"text\":\"Flower Pots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Water, milk and lava bases lead to different recipes.\"}]}"
	]
