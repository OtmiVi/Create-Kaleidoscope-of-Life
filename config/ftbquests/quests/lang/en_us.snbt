	quest.2F2D3AD96BA287FD.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sap\"},{\"text\":\" with a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Treetap\"},{\"text\":\", or process \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Rubber Logs\"},{\"text\":\" in a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Millstone\"},{\"text\":\" or Crushing Wheels. Smelt the \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Sap\"},{\"text\":\" into Rubber.\"}]}"
