	quest.4BA7892EA25F733A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a suitable \"},{\"text\":\"heat source\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Add the liquid and tea ingredient required for the tea you want to brew.\"}]}"
