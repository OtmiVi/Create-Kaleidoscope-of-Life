	quest.7AFCEE30B9303CBB.title: "Windmill Power"
	quest.7B0BEFF95776E04A.quest_desc: ["Equip this Jetpack Chestplate and check its fuel or fluid requirements in the tooltip. Set the flight controls and test a short takeoff over safe ground."]
	quest.7B0BEFF95776E04A.title: "Brass Jetpack"
	quest.7B363CADBD78324F.quest_desc: ["Equip the Diving Helmet, Diving Boots and a charged Backtank for underwater work. Refill the Backtank with rotation before a long dive."]
	quest.7B363CADBD78324F.title: "Copper Diving Equipment"
	quest.7B3EA954508CB5B4.quest_desc: ["Combine Fishing Rod and Melon Slice to make this locator rod. Mount a tamed Sniffer and use the rod to search toward Jungle. Use it again to return to manual control."]
	quest.7B5B424C06E2A5B6.quest_desc: [
		"Prepare the Pink Petals Tea Bag and brew Hanami Tale."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.7B5B424C06E2A5B6.title: "Hanami Tale"
	quest.7B6E92020E49F2EA.quest_desc: ["Equip this Jetpack Chestplate and check its fuel or fluid requirements in the tooltip. Set the flight controls and test a short takeoff over safe ground."]
	quest.7B6E92020E49F2EA.title: "Copper Jetpack"
	quest.7C43EF073F6FD620.quest_desc: [
		"Prepare the Dandelion Tea Bag and brew When the Wind Rises."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.7C43EF073F6FD620.title: "When the Wind Rises"
	quest.7CAB79FFAFE796AC.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.7CAB79FFAFE796AC.title: "Biluochun"
	quest.7CEA7321A4EC1BC8.quest_desc: [
		"Place a Steamer on a lit Stove or another suitable heat source. Insert ingredients from the top before adding another layer."
		"With an empty hand, sneak-right-click the top steamer to close its lid and start cooking. One heat source supports up to eight layers."
		"Once the food is ready, sneak-right-click with an empty hand to open the lid, then right-click to collect it. Work down through a stack from the top."
	]
	quest.7CEA7321A4EC1BC8.title: "A Stack of Steamers"
	quest.7D19D2E0346C7CD1.quest_desc: ["Look for an End ship. Equip the Elytra in your chest slot and keep a safe landing area for your first flight."]
	quest.7D19D2E0346C7CD1.title: "I can fly!"
	quest.7D32965F710B9731.quest_desc: ["Attach Steam Engines to a heated water-filled tank boiler and connect their pistons to shafts. Water supply and heat determine the boiler's usable output."]
	quest.7D32965F710B9731.title: "Steam Engine"
	quest.7D4C5CDB75DDCA92.quest_desc: ["Deposits items from backpack into sneak right clicked inventory Has more filtering options Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.7E9412EFB84F58A1.quest_desc: [
		"Craft a Blank Scroll and bind it to a Waystone."
		"Keep a bound scroll ready for an emergency return from a long expedition."
	]
	quest.7E9DA9380C835EAD.quest_desc: [
		"Prepare the Rose Bush Tea Bag and brew Tender Thorns."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.7E9DA9380C835EAD.title: "Tender Thorns"
	quest.7EA2911A0D2B15A7.quest_desc: ["Install this stack upgrade in the storage to increase the number of items held per slot. Compare the tier and capacity shown in its tooltip before choosing the upgrade."]
	quest.7EA62972543C8A9F.quest_desc: [
		"Craft a Recipe Filter and select a supported worker recipe."
		"It controls processing, not storage access or ingredient supply."
	]
	quest.7EA62972543C8A9F.title: "Give Exact Instructions"
	quest.7F455226B9BF72FE.quest_desc: ["Apply this tier upgrade to a matching Iron storage container to raise it to Gold tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.7F55FA09B39D0603.quest_desc: [
		"Check JEI for its recipe."
		"Set an equipment item in the Blaze Enchanter's filter slot, then give it the blank template to write compatible enchantments onto it. A Blaze Forger can apply them to equipment."
	]
	quest.7F55FA09B39D0603.title: "Enchanting Template"
