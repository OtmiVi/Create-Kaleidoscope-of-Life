	quest.4C4599A10BE1B633.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Your \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has discovered cosplay.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with certain \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to completely change its appearance. These variants are purely cosmetic, so choose your favorite or collect the whole prehistoric wardrobe.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Available cosplays:\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Acacia\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Acacia Leaves\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Sculk\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Echo Shard\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cherry\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Pink Petals\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cold\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Snowball\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Desert\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Sand\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Desert Pyramid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Sandstone\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ender\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Popped Chorus Fruit\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Jungle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Cocoa Beans\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mushroom\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Mycelium\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Crimson Roots\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Swamp\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" — \"},{\"text\":\"Mangrove Propagule\",\"color\":\"#D6B879\",\"bold\":true}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"And, of course, there is always the classic \"},{\"text\":\"Default Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for those who refuse to participate in cosplay.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Find your favorite look... or collect them all. Your \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" didn't survive extinction just to have one outfit.\"}]}"
	]
