	]
	quest.467C8D49D8B06F28.title: "Fire Waltz"
	quest.468E483F6C1824A1.quest_desc: [
		"Prepare the Wither Rose Tea Bag and brew Les Fleurs du Mal."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.468E483F6C1824A1.title: "Les Fleurs du Mal"
	quest.46E5C078BBA7DBA0.quest_desc: [
		"Prepare all four dishes in this Stockpot collection."
		"A few hearty pots of food will keep your kitchen busy and your guests well fed."
	]
	quest.46E5C078BBA7DBA0.title: "Four Hearty Pots"
	quest.46E5C8D3EB55E094.quest_desc: [
		"Craft a Grease Crock and fill it with Oil."
		"Right-click it with a Kitchen Spatula to coat the tool, then use the spatula on your wok to add oil."
	]
	quest.46E5C8D3EB55E094.title: "Keep the Grease Close"
	quest.4708422455C5A9D2.quest_desc: ["Roll three double drops within one Voracious Urn"]
	quest.4708422455C5A9D2.title: "Greed Without End"
	quest.4BA7892EA25F733A.quest_desc: [
		"Place a Teapot on a suitable heat source. Add the liquid and tea ingredient required for the tea you want to brew."
		"Wait until brewing finishes, then serve with Empty Cups. Add liquid and ingredients while the teapot is in its preparation stage."
	]
	quest.4BA7892EA25F733A.title: "Put the Kettle On"
	quest.4C14663895EEEF52.quest_desc: [
		"Prepare the Pink Tulip Tea Bag and brew Rosy Stride."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.4C14663895EEEF52.title: "Rosy Stride"
	quest.4C21BD4944CBDC53.quest_desc: ["Taste every available Flora flower drink."]
	quest.4C21BD4944CBDC53.title: "A Garden in Full Bloom"
	quest.4C4599A10BE1B633.quest_desc: [
		"Your Sniffer has discovered cosplay."
		""
		"Right-click a tamed Sniffer with certain items to completely change its appearance. These variants are purely cosmetic, so choose your favorite or collect the whole prehistoric wardrobe."
		""
		"Available cosplays:"
		""
		"Acacia — Acacia Leaves"
		"Sculk — Echo Shard"
		"Cherry — Pink Petals"
		"Cold — Snowball"
		"Desert — Sand"
		"Desert Pyramid — Sandstone"
		"Ender — Popped Chorus Fruit"
		"Jungle — Cocoa Beans"
		"Mushroom — Mycelium"
		"Nether — Crimson Roots"
		"Swamp — Mangrove Propagule"
		""
		"And, of course, there is always the classic Default Sniffer for those who refuse to participate in cosplay."
		""
		"Find your favorite look... or collect them all. Your Sniffer didn't survive extinction just to have one outfit."
	]
	quest.4C4599A10BE1B633.title: "Sniffer Cosplay Convention"
	quest.4C6AD6CB9F99191D.quest_desc: ["Obtain a Block of Experience. These blocks are used to make Enchanting Templates and can be transformed into Blocks of Super Experience by lightning. Check JEI for the recipe."]
	quest.4C6AD6CB9F99191D.title: "Experience, Compacted"
	quest.4C8BA6D3AB53C9EE.quest_desc: [
		"Craft a Sickle. Right-click crops to harvest them and remove weeds."
		"Keep it with your farming tools as your vegetable beds and rice fields expand."
	]
	quest.4C8BA6D3AB53C9EE.title: "A Cleaner Harvest"
	quest.4CE6CAC38213C268.quest_desc: [
		"Obtain a kitchen knife accepted by this task and keep it ready at your cooking station."
		"Cookery knives prepare ingredients on the Chopping Board. Higher-tier knives make useful upgrades as you spend more time in the kitchen."
	]
	quest.4CE6CAC38213C268.title: "A Blade for the Chef"
	quest.4DB5312EFD5053BB.quest_desc: [
		"Obtain a Lightning Rod for this quest and place it near a Blaze Enchanter under an open sky."
		"Supply Liquid Experience and feed the enchanter a Cake o' Enchanting to activate Super Enchanting mode. Set an equipment item, such as a pickaxe, in its filter slot and choose an enchanting level."
		"Process Super Enchanting Templates until a result includes a treasure enchantment, such as Mending. This grants Probability Spike. You may need several attempts."
	]
	quest.4DB5312EFD5053BB.title: "A Treasure in the Odds"
	quest.4E6536570DDAD4B9.quest_desc: [
		"This ancient creature may look like it pays taxes to nobody... and that's because it doesn't."
		""
		"Give a Sniffer a Pitcher Pod to tame it."
		""
		"Once you've earned its trust, you can:"
		""
		"Equip a Saddle — yes, you can ride the giant mossy dinosaur."
		"Attach a Chest — because apparently your dinosaur is also a backpack."
		"Add a Carpet — all 16 colors work, because fashion is important even when you're extinct."
		""
		"Its chest provides 25 storage slots, making your new prehistoric friend surprisingly useful on long adventures."
	]
	quest.4E6536570DDAD4B9.title: "A Sniffer Companion"
	quest.4EABF4A050EC94CD.quest_desc: [
		"Prepare the Lily of the Valley Tea Bag and brew May Kiss."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.4EABF4A050EC94CD.title: "May Kiss"
	quest.4ECC51DB18B1540D.quest_desc: [
		"Craft and place a Scarecrow to protect the surrounding farmland."
		"Right-click it with suitable heads, lanterns or tools to decorate your new field guardian."
	]
	quest.4ECC51DB18B1540D.title: "Someone to Watch the Crops"
	quest.4EF30842961B514C.title: "There is hot"
	quest.4F914EAA5FC2FD3F.quest_desc: [
		"Prepare the Azure Bluet Tea Bag and brew The Unnoticed."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.4F914EAA5FC2FD3F.title: "The Unnoticed"
	quest.4FE8D62B58B25DBC.quest_desc: ["Prepare a cup of Flower Tea for your tasting collection."]
	quest.4FE8D62B58B25DBC.title: "Flower Tea"
	quest.51181E7058AA394E.quest_desc: [
		"Obtain a kitchen knife accepted by this task. A Cookery Iron Kitchen Knife can be crafted from three Iron Ingots and a Stick."
		"Cookery kitchen knives cut ingredients on a Chopping Board. They can also provide Oil when used to kill pigs, piglins or hoglins."
	]
	quest.51181E7058AA394E.title: "Every Kitchen Needs a Knife"
	quest.5161081A58AD5C77.quest_desc: ["You can use trial key to  reset vault"]
	quest.5161081A58AD5C77.title: "Reuse key"
	quest.5166ACCCD8F53010.quest_desc: [
		"Prepare the Cornflower Tea Bag and brew The Prussian Leap."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.5166ACCCD8F53010.title: "The Prussian Leap"
	quest.517CAFE33962A58E.title: "Some hot rods"
	quest.51D70276D620DD81.title: "Iron armor"
	quest.550BCB5EA87CE32E.quest_desc: [
		"Prepare the Orange Tulip Tea Bag and brew Autumn Serenade."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.550BCB5EA87CE32E.title: "Autumn Serenade"
	quest.5561E25A984A8C55.quest_desc: ["Ripen 50 crops within one Vernal Awakening"]
	quest.5561E25A984A8C55.title: "Believe in the Whole Spring"
	quest.572F0A52E3B4C07F.quest_desc: [
		"Finish cutting an ingredient on a Chopping Board with a Cookery kitchen knife."
		"Continue cutting until the ingredient changes into its prepared result. This grants the chopping advancement."
	]
	quest.572F0A52E3B4C07F.title: "Chop, Chop, Chop!"
	quest.57993FFBF672E682.quest_desc: ["Obtain a Printer. Set the item to copy in its filter slot, supply the required fluid, and feed blank items underneath it. It can copy books, rename items, and more. Check JEI for printing recipes."]
	quest.57993FFBF672E682.title: "The Magic Copy Shop"
	quest.57CFEF7965C2F8C2.title: "Some white stuf"
	quest.595F2FF6E6A6425F.quest_desc: [
		"Break grass while wearing a Straw Hat to find Wild Rice."
		"Prepare flooded farmland before planting it. Mature rice plants provide Rice Panicles for your kitchen."
	]
	quest.595F2FF6E6A6425F.title: "Find Wild Rice"
	quest.5B07B986302DE4A7.title: "Fire and Water"
	quest.5B0FA1FF4D71B700.quest_desc: [
		"Harvest 16 Lettuce and keep one Caterpillar. Caterpillars have a chance to appear when you harvest lettuce."
		"Lettuce is useful in soups and stuffed dough. The caterpillar can become a treat for a baby chicken."
	]
	quest.5B0FA1FF4D71B700.title: "An Unexpected Garden Guest"
	quest.5B18D1B9AA2FFC2A.title: "Stone age"
	quest.5BCDC4A61F7A3413.quest_desc: [
		"Collect 16 Rice by processing Rice Panicles in a powered Create Millstone."
		"Feed the panicles into the top of the millstone and supply rotation. Each panicle gives two Rice, with a chance for one more."
		""
		"{\"text\":\"Open the quest with Create\\u0027s Millstone\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"449A09FC50B32D81\"}}"
	]
	quest.5BCDC4A61F7A3413.title: "From Panicle to Grain"
	quest.5BEEA73118C314D0.title: "Better gold"
	quest.5C05217D7F061B19.title: "First gold"
	quest.5C184812CBA507FD.title: "Some bodes"
	quest.5C7B63F20EA5E2B1.quest_desc: ["Cross 50 blocks of open water in one unbroken Rosy Stride"]
	quest.5C7B63F20EA5E2B1.title: "Walk on Water"
	quest.5DAC077462DE4567.quest_desc: [
		"Craft a Shawarma Spit. Its crafting grid uses Iron Sheets and a Shaft on top, Iron Sheets around a Cogwheel in the middle, and Magma Blocks around a Campfire on the bottom."
		"Load suitable food and power the spit with redstone to cook. Turn the redstone signal off before removing the food."
	]
	quest.5DAC077462DE4567.title: "Turning Up the Roast"
	quest.5FBCB143DBF47BD2.quest_desc: ["Obtain a cup of Mystery Tea for the more unusual end of your collection."]
	quest.5FBCB143DBF47BD2.title: "Mystery Tea"
	quest.5FF517ECD284B19A.quest_desc: [
		"Prepare the Sunflower Tea Bag and brew The Sunward."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.5FF517ECD284B19A.title: "The Sunward"
	quest.6159EBCB14058ADE.quest_desc: ["Drink a First Bloom on an empty hunger bar"]
	quest.6159EBCB14058ADE.title: "Coffee Is Our Bread"
	quest.626BEE24D4EAE1D4.quest_desc: [
		"Prepare all four wok specialties in this collection."
		"Crispy rolls, spicy dishes and stuffed peppers bring a little variety to the dinner table."
	]
	quest.626BEE24D4EAE1D4.title: "Crispy, Spicy, Delicious"
	quest.62B1E27D756BCE91.quest_desc: [
		"Drink Lullaby at night to receive a Blossom Mooncake."
		"Enjoy it with your tea, or use its Floating effect for the air-swimming achievement."
	]
	quest.62B1E27D756BCE91.title: "A Mooncake with Your Lullaby"
	quest.63959D56376D9898.quest_desc: ["Drink your first flower drink"]
	quest.63959D56376D9898.title: "First Sip"
	quest.645892F182BAC7E8.quest_desc: [
		"Prepare Cooked Rice in your Stockpot."
		"Keep a few portions ready for the rice dishes further along this branch."
	]
	quest.645892F182BAC7E8.title: "A Bowl of Rice"
	quest.64BA735081D86131.title: "Get some prismarine"
	quest.65772ABCF259B164.quest_desc: [
		"Prepare the Pitcher Plant Tea Bag and brew The Voracious Urn."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.65772ABCF259B164.title: "The Voracious Urn"
	quest.65D2F27DFF313DB0.quest_desc: [
		"Prepare Mantou in your Steamer."
		"Soft steamed buns make a simple first meal from your new cookware."
	]
	quest.65D2F27DFF313DB0.title: "Steam Does the Work"
	quest.663ABDA70E76261B.quest_desc: [
		"Use a spare Blaze Enchanter: this hidden advancement destroys the machine."
		"Work under an open sky with no exposed Lightning Rod within 128 blocks. Supply Liquid Experience and feed the enchanter a Cake o' Enchanting to activate Super Enchanting mode."
		"Set an equipment item in its filter slot, choose an enchanting level, and start processing a Super Enchanting Template. Without a rod to catch the lightning, the enchanter is destroyed and replaced by a lit Blaze Burner, granting OSHA Violation."
	]
	quest.663ABDA70E76261B.title: "OSHA Violation"
	quest.665547A2097D3C1F.quest_desc: ["Obtain an Experience Lantern. It collects nearby experience orbs and can absorb experience from players. The more experience it stores, the brighter it glows."]
	quest.665547A2097D3C1F.title: "A Bright Idea"
	quest.66DC3AFFE849F91F.quest_desc: [
		"Supply a Blaze Forger with Liquid Experience and switch its side panel to Extract Mode."
		"Give it an enchanted item, book, or template together with a blank Enchanting Template. Extracting an enchantment into the blank template grants Magic Unbinding."
	]
	quest.66DC3AFFE849F91F.title: "Unbind the Magic"
	quest.68CDC9FEC7D1C545.quest_desc: [
		"Supply a Blaze Enchanter with Liquid Experience and set an enchanting level on its panel."
		"Give it an unenchanted tool, weapon, or piece of armor and let it finish enchanting. This grants Blazing Enchantment."
	]
	quest.68CDC9FEC7D1C545.title: "Blazing Enchantment"
	quest.68D2C737BAB62DEE.title: "Lets enchant"
	quest.69F6289F71DC379E.title: "Golden armor"
	quest.6A09757C266B3F48.quest_desc: [
		"Pump Liquid Experience through Create Fluid Pipes. Break a section so the liquid leaks from an open pipe end."
		"Stand in the leaking experience to absorb it and earn the hidden advancement A Shower Experience. Keep the pump running so experience continues to flow."
	]
	quest.6A09757C266B3F48.title: "A Shower of Experience"
	quest.6A7E000000000002.quest_desc: [
		"Find a Grapevine hanging from an oak tree and break it by hand to bring it home."
		"Your tavern begins in the vineyard. Grow grapes, press juice, brew a cellar of drinks, then bring Create into the business."
	]
	quest.6A7E000000000002.title: "A Tavern Starts with a Vine"
	quest.6A7E000000000005.quest_desc: [
		"Craft 8 Trellises and plant your Grapevine on one placed one block above the soil."
		"Vines grow upward first, then spread across neighboring trellises. Leave air beneath the fruit-bearing trellises so grapes can form."
		"Harvest ripe grapes with Shears for 2-3 grapes instead of the usual 1-2."
	]
	quest.6A7E000000000005.title: "Room for One More Vine"
	quest.6A7E000000000008.quest_desc: [
		"Harvest 16 Grapes from your trellises."
		"Use dirt or grass beneath the trellis for ordinary grapes. Keep some fruit for your first juice and some for later batches."
	]
	quest.6A7E000000000008.title: "The First Harvest"
	quest.6A7E00000000000B.quest_desc: [
		"Grow and collect 8 Ice Grapes using ice or snow beneath the trellis."
		"The vineyard needs space below its trellises to bear fruit. Check the crop season as well as the ground when growth seems slow."
	]
	quest.6A7E00000000000B.title: "A Vineyard on Ice"
	quest.6A7E00000000000E.quest_desc: [
		"Use netherrack or a magma block beneath the trellis and collect 8 Gold Grapes."
		"These grapes make the golden juice used for Honey Wine, Miner's Star and other warm-colored brews."
	]
	quest.6A7E00000000000E.title: "A Warmer Vintage"
	quest.6A7E000000000011.quest_desc: [
		"Collect 4 Green Grapes while harvesting your vineyard."
		"Green Grapes are a chance drop from harvesting grapes. Keep harvesting your existing vines to find them."
	]
	quest.6A7E000000000011.title: "A Lucky Bunch"
	quest.6A7E000000000014.quest_desc: ["You can grow grapes on Trellises."]
	quest.6A7E000000000014.title: "Leaves Are Not a Vineyard"
	quest.6A7E00000000001A.quest_desc: [
		"Craft a Pressing Tub and place it flat on the ground."
		"Add pressable fruit, then jump on the tub repeatedly to turn it into juice. The tub holds one type of item at a time."
		"Keep an empty bucket ready to collect the juice."
	]
	quest.6A7E00000000001A.title: "Put Your Feet to Work"
	quest.6A7E00000000001D.quest_desc: [
		"Collect a Grape Bucket from your Pressing Tub."
		"The juice is the starting fluid for Wine, Champagne, Brandy, Carignan and Sakura Wine. Save it for your first brewing barrel."
	]
	quest.6A7E00000000001D.title: "A Bucket of the Vineyard"
	quest.6A7E000000000023.quest_desc: [
		"Collect Ice Grape, Gold Grape, Green Grape, Sweet Berries and Glow Berries Buckets to complete your juice pantry."
		"Together with ordinary grape juice, these supply six different colored brewing bases. Check JEI for each pressing recipe."
	]
	quest.6A7E000000000023.title: "Six Colors on Tap"
	quest.6A7E00000000002B.quest_desc: [
		"Craft a Tavern Barrel and open its lid."
		"Fill the barrel with the recipe's fluid first, then add any required ingredients and close the lid to start brewing."
		"The Tavern Barrel is a separate block from the ordinary Minecraft Barrel. Check its Ponder scene for the setup."
	]
	quest.6A7E00000000002B.title: "Something Is Brewing"
	quest.6A7E00000000002E.quest_desc: [
		"Craft an Empty Bottle and a Tap for your tavern."
		"Place the recipe's empty container beneath the barrel's tap, then right-click the tap to bottle the drink."
		"Wine recipes use Tavern Empty Bottles. Keep a supply beside the cellar."
	]
	quest.6A7E00000000002E.title: "Ready to Serve"
	quest.6A7E000000000032.quest_desc: [
		"Brew Wine from ordinary grape juice, then bottle it."
		"Check the barrel's brewing progress before serving. Leaving it to age improves its brew level."
		"Save several bottles at Fine quality or better if you want to use them in cocktails."
	]
	quest.6A7E000000000032.title: "The House Wine"
	quest.6A7E000000000036.quest_desc: ["You can brew drinks by filling a Barrel, adding ingredients and closing its lid."]
	quest.6A7E000000000036.title: "Fluid First, Ingredients Second"
	quest.6A7E000000000039.quest_desc: ["You can leave drinks in the Barrel longer to improve their quality."]
	quest.6A7E000000000039.title: "Give It Time"
	quest.6A7E00000000003C.quest_desc: [
		"Brew Champagne, Brandy, Carignan and Sakura Wine."
		"All four begin with ordinary grape juice. Their added ingredients are Sugar, Apple, Sweet Berries and Pink Petals respectively."
		"Fill each barrel with juice before adding its ingredient."
	]
	quest.6A7E00000000003C.title: "The Orchard Flight"
	quest.6A7E000000000043.quest_desc: [
		"Brew Ice Wine, Mother Snow, Polaris Sweet White and Sherry."
		"All use Ice Grape Juice. Ice Wine needs no extra ingredient; Mother Snow adds Ice, Polaris adds Packed Ice, and Sherry adds Blue Ice."
	]
	quest.6A7E000000000043.title: "A Cellar Full of Winter"
	quest.6A7E00000000004A.quest_desc: [
		"Brew Honey Wine, Miner's Star, Madame Shexiang and Sunset Glow."
		"Start with Gold Grape Juice. Add Honeycomb, Iron Nugget, Gold Nugget or Blaze Powder respectively."
	]
	quest.6A7E00000000004A.title: "The Golden Shelf"
	quest.6A7E000000000051.quest_desc: [
		"Brew Plum Wine, Sweet Berry Wine and Red Queen from Sweet Berries Juice."
		"Use Sugar for Plum Wine, Sweet Berries for Sweet Berry Wine, and Redstone Dust for Red Queen."
	]
	quest.6A7E000000000051.title: "Berries in the Cellar"
	quest.6A7E000000000057.quest_desc: [
		"Brew Riesling Dry White and Sauvignon Blanc Dry White with Green Grape Juice."
		"Riesling needs Gunpowder and Sugar. Sauvignon Blanc needs Sugar Cane and Sugar."
		"These drinks supply the green ingredient group for your shaker."
	]
	quest.6A7E000000000057.title: "Good Things Come in Green"
	quest.6A7E00000000005C.quest_desc: [
		"Brew Luminous Bride and Glowflower Brew from Glow Berries Juice."
		"Add a Glow Ink Sac for Luminous Bride or Glowstone Dust for Glowflower Brew. Both belong to the yellow cocktail ingredient group."
	]
	quest.6A7E00000000005C.title: "A Little Light in Every Bottle"
	quest.6A7E000000000061.quest_desc: [
		"Brew Vodka, Whiskey and Rum using water as the starting fluid."
		"Add Potato for Vodka, Wheat for Whiskey, or Sugar Cane for Rum."
		"These drinks belong to the white cocktail ingredient group."
	]
	quest.6A7E000000000061.title: "Clear Beginnings"
	quest.6A7E000000000067.quest_desc: [
		"Craft a Shaker and an Empty Glassware."
		"Prepare at least three drinks of Fine quality or better. Cocktail recipes choose ingredients by color group; check JEI for the combinations."
		"Save Empty Glassware for serving your finished cocktails."
	]
	quest.6A7E000000000067.title: "Shake Up the Menu"
	quest.6A7E00000000006B.quest_desc: ["You can mix three Fine-quality drinks in a Shaker to make cocktails."]
	quest.6A7E00000000006B.title: "Three Drinks and a Little Patience"
	quest.6A7E00000000006E.quest_desc: [
		"Prepare Allium Garden, Brass Heart and Emerald."
		"Allium Garden uses three light-purple ingredients, Brass Heart uses three gold ingredients, and Emerald uses three green ingredients."
		"Each brewing ingredient must be Fine quality or better."
	]
	quest.6A7E00000000006E.title: "One Color, Three Measures"
	quest.6A7E000000000074.quest_desc: [
		"Prepare Mojito, Grasshopper and White Lady."
		"Mojito: white + white + green. Grasshopper: green + green + white. White Lady: white + green + yellow."
		"Check JEI for matching bottles and let every brewing ingredient reach Fine quality."
	]
	quest.6A7E000000000074.title: "Something Fresh"
	quest.6A7E00000000007A.quest_desc: [
		"Prepare Bloody Mary, Godfather and Screwdriver."
		"Bloody Mary: red + red + red. Godfather: red + red + gold. Screwdriver: yellow + yellow + gold."
		"Keep a separate shelf for each ingredient color to make the next order easier."
	]
	quest.6A7E00000000007A.title: "A Bold Little Menu"
	quest.6A7E000000000080.quest_desc: [
		"Prepare Depth Charge, Nether Special and Sculk Special."
		"Depth Charge: blue + light purple + white. Nether Special: red + green + blue. Sculk Special: blue + blue + light purple."
		"Use Fine-quality ingredients or better for every recipe."
	]
	quest.6A7E000000000080.title: "A Round for the Adventurers"
	quest.6A7E000000000086.quest_desc: [
		"Craft a Bar Counter, Bar Cabinet and four Brown Bar Stools."
		"Set up a serving area for your kitchen and cellar. Leave yourself room to reach the barrels and bottle storage."
	]
	quest.6A7E000000000086.title: "A Place to Pull Up a Stool"
	quest.6A7E00000000008B.quest_desc: [
		"Craft a Glass Bar Cabinet, Cellar Cabinet, Tilted Rack and Glassware Holder."
		"Keep serving containers near the bar and display your collection on racks. Check a rack's accepted bottle shape if a drink will not fit."
	]
	quest.6A7E00000000008B.title: "Bottles Deserve a Shelf"
	quest.6A7E000000000091.quest_desc: [
		"Craft a Chalkboard, Table and Bell Pendant Lamp."
		"Give your tavern a menu and a cozy corner. This branch is for making the place feel like home."
	]
	quest.6A7E000000000091.title: "Tonight's Specials"
	quest.6A7E000000000096.quest_desc: [
		"You can use a Mechanical Press and Basin to make grape juice."
		"{\"text\":\"Mechanical Press\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6431C7321BFC0EFB\"}}"
		"{\"text\":\"Basin\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"257A57B87BB76486\"}}"
	]
	quest.6A7E000000000096.title: "Let the Press Do the Stomping"
	quest.6A7E00000000009A.quest_desc: [
		"You can use pipes and a pump to send juice into tanks."
		"{\"text\":\"Fluid Pipes\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4FC8B0B6D84E9EE0\"}}"
		"{\"text\":\"Mechanical Pump\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"74952DAF91A29B22\"}}"
		"{\"text\":\"Fluid Tanks\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0172930769CA91D7\"}}"
	]
	quest.6A7E00000000009A.title: "From Vineyard to Cellar"
