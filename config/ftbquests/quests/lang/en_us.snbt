		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Mechanical Grindstones\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": \"},{\"text\":\"Enchantment Industry\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to remove enchantments. Follow the linked quest to build a Grindstone Drain.\"}]}"
