	quest.017D36B7F519B774.quest_desc: [
		"Obtain Lettuce Seeds by breaking grass while wearing a Straw Hat, then plant them on farmland."
		"Grow a steady supply for soups and stuffed dough. Watch for caterpillars when harvesting."
	]
	quest.017D36B7F519B774.title: "Leaves for Lunch"
	quest.01965A016BFD347D.quest_desc: [
		"Release a fish from a bucket into your flooded rice field."
		"Fish help the rice grow and grant the Fish-Rice Symbiosis advancement."
	]
	quest.01965A016BFD347D.title: "Fish Among the Rice"
	quest.01B105DD883B7FC1.quest_desc: [
		"Prepare the White Tulip Tea Bag and brew Absolution."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.01B105DD883B7FC1.title: "Absolution"
	quest.03C14112270873B7.title: "Netherite tools"
	quest.05BC17815B49C91C.quest_desc: ["Drink three different flower drinks within one minute"]
	quest.05BC17815B49C91C.title: "Flowers for Wine"
	quest.0749C059A711739E.quest_desc: [
		"Gain the Flatulence effect, then sneak to propel yourself upward."
		"Ascend 1900 blocks from your starting position during the flight to complete this pack-adjusted Cookery advancement."
		"Begin at Y = -60 or higher and remain at or below Y = 3200 when completing the ascent."
	]
	quest.0749C059A711739E.title: "Rocket-Powered Digestion"
	quest.07670213AF28B8EF.quest_desc: ["Pin three different creatures within one second"]
	quest.07670213AF28B8EF.title: "Three Blooms at Once"
	quest.0833150753998783.quest_desc: [
		"Prepare the tea bag and its matching brewed tea to complete this tasting."
		"Keep a cup ready beside your Teapot."
	]
	quest.0833150753998783.title: "Tieguanyin"
	quest.0B22C27008D8732E.quest_desc: [
		"Use a skull on a placed Scarecrow to replace its head."
		"This completes The Art of Grafting advancement. Choose a face that suits your farm."
	]
	quest.0B22C27008D8732E.title: "A Change of Face"
	quest.0BDD49E0B7056D1E.quest_desc: [
		"Obtain a Super Enchanting Template using a Block of Super Experience. Check JEI for its recipe."
		"Blaze Enchanters and Blaze Forgers in Super Enchanting mode require these upgraded templates instead of normal ones."
	]
	quest.0BDD49E0B7056D1E.title: "A Supernatural Blueprint"
	quest.0BEBB2510D8435FE.title: "Diamond tools"
	quest.0C8B9821D43ED752.quest_desc: [
		"Collect 8 Oil. Killing pigs, piglins or hoglins with a Cookery kitchen knife can provide it."
		"Keep Oil beside your stove: it is the first ingredient added to the wok before stir-frying."
	]
	quest.0C8B9821D43ED752.title: "Oil on the Blade"
	quest.0DEE0F0A32566514.quest_desc: [
		"Prepare the Oxeye Daisy Tea Bag and brew Loves Me Not."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.0DEE0F0A32566514.title: "Loves Me Not"
	quest.0E19B7FD3C6ADBFD.quest_desc: ["Hold The Sunward's day form from sunrise to sunset of one day"]
	quest.0E19B7FD3C6ADBFD.title: "Kuafu Chases the Sun"
	quest.0E76A85ED049A798.quest_desc: [
		"Hold Raw Dough and keep right-click pressed to stretch it into Raw Noodles."
		"Alternatively, place dough on a Chopping Board and cut it four times with a kitchen knife to get three Raw Noodles."
		"Keep the noodles for the Stockpot recipe collection."
	]
	quest.0E76A85ED049A798.title: "Pull Your Own Noodles"
	quest.0EB72C4C224E6FD9.quest_desc: [
		"Sneak and throw a Baozi at a wolf that is missing health to heal it."
		"This completes the base Cookery Baozi advancement. A good meal is better when shared."
	]
	quest.0EB72C4C224E6FD9.title: "Share a Bun"
	quest.0EC4467B69DBC4C3.quest_desc: ["Land a dew flower cake shockwave after falling at least twenty blocks"]
	quest.0EC4467B69DBC4C3.title: "From the Sky"
	quest.0F8EFABEF34E7C58.title: "How it grow there?"
	quest.10F4A2976081820E.title: "Something bether"
	quest.11F8FC84B04CA3F0.quest_desc: ["After eating a blossom mooncake, swim 100 blocks through the air without touching ground"]
	quest.11F8FC84B04CA3F0.title: "I Would Ride the Wind Home"
	quest.12053A64424FE7CB.title: "Lets find him!"
	quest.1261F51007BC60A6.title: "Iron tools"
	quest.13530E4C44B87217.title: "Firt copper"
