	quest.65D2F27DFF313DB0.title: "Steam Does the Work"
	quest.65E25F0A71E2205A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install this stack upgrade in the \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to increase the number of \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" held per slot. Compare the tier and \"},{\"text\":\"capacity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" shown in its tooltip before choosing the upgrade.\"}]}"]
	quest.6610822C3C6CCC41.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smelts \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"automatic input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in its settings. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.661CB3E22019FCB5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Rocket Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" assembles your rocket and lets you choose its \"},{\"text\":\"destination\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Right-click it to open the controls and provide your \"},{\"text\":\"Space Atlas\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Review the displayed \"},{\"text\":\"fuel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"heat shielding\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" requirements before launch. Use the station's information to adjust the rocket for the selected route.\"}]}"
	]
