	quest.7254CD613193123A.title: "Andesite Exoskeleton"
	quest.733FCF269775E418.quest_desc: [
		"Place the wok directly over a lit Stove or another suitable heat source."
		"Add Oil, then the recipe ingredients. Stir with the spatula until cooking finishes; wrong ingredients or waiting too long can spoil the dish."
		"Use the required serving container, usually a Bowl, to collect the result. For dishes without a container, sneak-right-click with the Kitchen Spatula."
	]
	quest.733FCF269775E418.title: "Your First Wok"
	quest.735DF7ABE693CD2A.quest_desc: ["Golden apples and golden carrots make useful expedition supplies. Keep the apple for a difficult fight."]
	quest.735DF7ABE693CD2A.title: "Royale food"
	quest.7388048AC50D5ECE.quest_desc: [
		"Find a Waystone and look directly at it to complete the observation task."
		"Interact with it to activate the destination. Newly found Waystones in this pack use activation-based visibility by default."
	]
	quest.73BB8BC267841762.quest_desc: ["Check the material and mining tier before replacing your current tools, and keep spare materials for repairs or replacements."]
	quest.73BB8BC267841762.title: "Blazing Tools"
	quest.7400035D23127D31.quest_desc: ["Carry a Satchel to expand your traveling storage. Check its controls before filling it with expedition supplies."]
	quest.74952DAF91A29B22.quest_desc: ["Power the pump with rotation and connect its front and back to pipes. Reverse rotation when you need to reverse the fluid flow."]
	quest.74952DAF91A29B22.title: "Mechanical Pump"
	quest.74B6DA366E71A547.quest_desc: [
		"Prepare Bamboo Tube Rice in your Steamer."
		"A meal packed in bamboo is ready for a well-earned break after a day in the fields."
	]
	quest.74B6DA366E71A547.title: "Lunch in a Bamboo Tube"
	quest.74CF736A6991E557.quest_desc: ["Keeps refilling stack of selected items in player's inventory Allows for more precise target slot selection Also allows middle click picking blocks from backpack Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.75192CE143345911.quest_desc: ["Add the Fluid Atomizer to your fluid workshop. Its JEI uses and Ponder scene show the supported processing arrangements."]
	quest.75192CE143345911.title: "Fluid Atomizer"
	quest.754CDEB099E74278.quest_desc: ["Start brewing with a Brewing Stand, blaze powder and the ingredients shown in JEI. Prepare bottles of water before adding ingredients."]
	quest.754CDEB099E74278.title: "Let's drink it"
	quest.7579B276EAB98783.quest_desc: ["Apply this tier upgrade to a matching Basic storage container to raise it to Diamond tier. Check the accepted base and ingredients in JEI before crafting."]
	quest.75B04C49A360261F.quest_desc: ["A Deployer performs item interactions at its working face. Use it for Sequenced Assembly and other recipes that require a held ingredient or tool."]
	quest.75B04C49A360261F.title: "Deployer"
	quest.75B4499D270B3411.quest_desc: ["Claim the dragon egg after defeating the Ender Dragon. It teleports when touched, so collect it with a suitable piston or falling-block setup."]
	quest.7652FF171AFF4D4B.quest_desc: ["Convert an existing Tier 2 stack upgrade into Tier 4. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.7695E361852C9C5C.quest_desc: ["Convert an existing Tier 1 stack upgrade into Tier 2. Use the conversion recipe in JEI when upgrading a module you already own."]
	quest.76AC070F021FA148.quest_desc: ["Feeds player with food from backpack's inventory Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.774291101D99615E.quest_desc: ["Small and large cogwheels transfer rotation and can change its speed. Watch the direction of rotation when connecting machines."]
	quest.774291101D99615E.title: "Cogwheels"
	quest.775F114D30179638.quest_desc: [
		"Craft a Bamboo Tray and lay Fresh Tea Leaves on it to dry."
		"These are used to prepare tea ingredients for your Teapot."
	]
	quest.775F114D30179638.title: "Leaves on the Drying Tray"
	quest.77DBB83428A21C83.quest_desc: ["Place an Andesite Tunnel over a belt to manage its item flow. Ponder shows where items can enter and leave."]
	quest.77DBB83428A21C83.title: "Andesite Tunnel"
	quest.7801851C6939D024.quest_desc: ["Equip the Exoskeleton Chestplate and inspect its operating requirements. Check the assigned controls before testing its movement features."]
	quest.7801851C6939D024.title: "Copper Exoskeleton"
	quest.780AF722C380D38C.quest_desc: ["Craft every armor piece shown in the task and keep the complete set together. Equip it before the next expedition and check durability after combat."]
	quest.780AF722C380D38C.title: "Copper armor"
	quest.78902351B2D4C08A.quest_desc: ["Hold every available Flora flower drink in your inventory at once."]
	quest.78902351B2D4C08A.title: "The Complete Bouquet"
	quest.7993F28058B65375.quest_desc: [
		"Help a wandering villager settle in a tracked village."
		"Use their dialogue and Home information. Wandering traders do not count."
	]
	quest.7993F28058B65375.title: "A New Neighbor"
	quest.79D85F0CE7026A9C.quest_desc: [
		"Prepare Baozi in your Steamer."
		"These filled buns are a hearty addition to your menu. Save one to share with a hungry wolf."
	]
	quest.79D85F0CE7026A9C.title: "Something Good Inside"
	quest.79DE274016EE90F1.quest_desc: ["Deposits items from backpack into sneak right clicked inventory Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings."]
	quest.79E47D918E7EF240.quest_desc: ["The Portable Drill adds a handheld mining option. Check its tooltip for operation and supply requirements before a long mining trip."]
	quest.79E47D918E7EF240.title: "Portable Drill"
	quest.7A1648E7E2877A4A.quest_desc: [
		"Earn the Crowned by the Village advancement."
		"An optional reputation goal after becoming Revered."
	]
	quest.7A1648E7E2877A4A.title: "Crowned by the Village"
	quest.7A3DD8F510A38490.quest_desc: ["Check JEI for their recipes."]
	quest.7A3DD8F510A38490.title: "Experience Tools"
	quest.7A90F939830C8782.quest_desc: ["Input and Output handle directional item flow. Use the Storage Tool to link separate storage groups to the Controller; connectors bridge gaps in the storage layout."]
	quest.7A959F933587F365.quest_desc: ["Combine sequenced motion with Brass Funnels, Tunnels and inventory sensors. Configure filters and redstone thresholds before feeding a busy production line."]
	quest.7A959F933587F365.title: "Brass Logistics and Control"
	quest.7AEE5B1EC5B455A4.quest_desc: ["Supply a Blaze Enchanter with Liquid Experience. Set its enchanting level on the panel, then insert an unenchanted item."]
	quest.7AEE5B1EC5B455A4.title: "Blaze Enchanter"
