	quest.194D0AB03AB7C8DF.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Collect \"},{\"text\":\"Hydrogen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from water electrolysis and store it in your fluid network. It can be used as \"},{\"text\":\"rocket fuel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or sent on for liquefaction.\"}]}"
