	quest.09512212C7737B61.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Restocks the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from an \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" you \"},{\"text\":\"sneak-right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Set its \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to choose which \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are affected. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
