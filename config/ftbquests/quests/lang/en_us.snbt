	quest.224EAC86A82372E5.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Recruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through the party-contract menu.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check its requirements, then use \"},{\"text\":\"Party\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to manage movement and combat. \"},{\"text\":\"Self-check\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": tick when done.\"}]}"
