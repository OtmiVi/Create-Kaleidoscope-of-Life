	quest.6A81000000000036.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Roasted Endermite Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can be cooked by a furnace, smoker or campfire. Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the stir-fried version.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save a portion of \"},{\"text\":\"Stir-Fried Endermite Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for its \"},{\"text\":\"rice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"-bowl recipe.\"}]}"
	]
	quest.6A81000000000036.title: "Small Bites"
	quest.6A8100000000003B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Harvest \"},{\"text\":\"Chorus Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to find an \"},{\"text\":\"End Caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A8100000000003B.title: "A Bug at the End"
	quest.6A8100000000003E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Finish \"},{\"text\":\"End Caterpillar Sashimi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect it with a Bowl.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save a \"},{\"text\":\"caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when harvesting \"},{\"text\":\"Chorus Fruit\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" so the kitchen has the special ingredient ready.\"}]}"
	]
	quest.6A8100000000003E.title: "The Last Sashimi"
	quest.6A81000000000044.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Brush Suspicious End Stone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and get \"},{\"text\":\"Void Conches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A81000000000044.title: "A Whisper from the Void"
	quest.6A81000000000047.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Stuffed Void Conch and Void Mutton Steak\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". The stuffed conch is served in a \"},{\"text\":\"Void Conch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", while the steak uses a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Void Conch Noodle Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs a \"},{\"text\":\"Water\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" base in the \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep its serving Bowls near the pot.\"}]}"
	]
	quest.6A81000000000047.title: "A Taste of the Void"
	quest.6A8100000000004C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Gain Void Erosion\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from an \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dish.\"}]}"]
	quest.6A8100000000004C.title: "A Touch of the Void"
	quest.6A8100000000004F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Brush Suspicious Dragon Eggs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to obtain \"},{\"text\":\"Dragon Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A8100000000004F.title: "Dust of an Ancient Dragon"
	quest.6A81000000000052.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Dragon Egg Shell\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as the \"},{\"text\":\"serving container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Dark Dragon Egg Stew and Dragon Egg Custard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep spare shells beside the \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". They are also used in \"},{\"text\":\"Dragon Egg Ice Cream\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A81000000000052.title: "A Shell for the Table"
	quest.6A81000000000055.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Brush Suspicious Dragon Eggs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect \"},{\"text\":\"2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Dragon Egg Liquid.\"}]}"]
	quest.6A81000000000055.title: "Inside a Suspicious Egg"
	quest.6A81000000000058.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fried Dragon Egg and Dragon Souffle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" ready for the souffle and reserve some \"},{\"text\":\"Dragon Egg Liquid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the later \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" recipes.\"}]}"
	]
	quest.6A81000000000058.title: "An Egg and a Little Magic"
	quest.6A8100000000005C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Dark Dragon Egg Stew\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses a \"},{\"text\":\"Water-filled Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a \"},{\"text\":\"Dragon Egg Shell\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Have\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the shell ready before finishing the batch; an ordinary \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is not the \"},{\"text\":\"serving container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for this dish.\"}]}"
	]
	quest.6A8100000000005C.title: "A Dragon's Breakfast"
	quest.6A81000000000061.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Eat \"},{\"text\":\"Dragon Egg Stew and Dragon Egg Custard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A81000000000061.title: "An Eggcellent Feast"
	quest.6A81000000000064.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Create Item Drain\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to empty \"},{\"text\":\"Dragon's Breath\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" bottles and collect a \"},{\"text\":\"Dragon Breath Bucket\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A81000000000064.title: "Catch Your Breath"
	quest.6A81000000000067.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Dragon Breath Chorus Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs \"},{\"text\":\"Dragon Breath\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as its \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" base and a Bowl for serving.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The mixed stew uses a \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and is served in a \"},{\"text\":\"Shulker Shell\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Keep the \"},{\"text\":\"Popping Candy\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" separate for its assembly recipe.\"}]}"
	]
	quest.6A81000000000067.title: "A Dragon's Aftertaste"
	quest.6A8100000000006C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Defeat the Ender Dragon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect \"},{\"text\":\"2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Raw Ender Dragon Meat.\"}]}"]
	quest.6A8100000000006C.title: "The Dragon's Share"
	quest.6A81000000000070.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cook Ender Dragon Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a furnace, smoker or campfire, or use its \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" route.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Dark Dragon Steak\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and is served in a \"},{\"text\":\"Bowl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Reserve part of your \"},{\"text\":\"rare\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" meat supply for each recipe you want to try.\"}]}"
	]
	quest.6A81000000000070.title: "A Feast for the Victor"
	quest.6A81000000000075.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"At a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", use the \"},{\"text\":\"Ender Dragon Smithing Template\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to upgrade a \"},{\"text\":\"Netherite Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with Dragon Dust.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a separate supply of \"},{\"text\":\"Dragon Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for cooking and planting uses.\"}]}"
	]
	quest.6A81000000000075.title: "A Pattern from the End"
	quest.6A81000000000078.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Upgrade\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Netherite Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the Ender Dragon Smithing Template and Dragon Dust.\"}]}"]
	quest.6A81000000000078.title: "The Dragon's Edge"
	quest.6A8100000000007B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"End Stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to heat cookware at your \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" outpost.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the cooking area away from island edges and leave room to reach ingredient \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"serving containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A8100000000007B.title: "A Hearth at the End"
	quest.6A8100000000007E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Chorus Flower Tea\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with its matching tea bag in a heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the \"},{\"text\":\"teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving.\"}]}"
		"{\"text\":\"Teapot\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BA7892EA25F733A\"}}"
	]
	quest.6A8100000000007E.title: "A Flower in the Teapot"
	quest.6A81000000000083.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Ender Mint Tea\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with its matching tea bag in a heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the \"},{\"text\":\"teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving.\"}]}"
		"{\"text\":\"Teapot\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BA7892EA25F733A\"}}"
	]
	quest.6A81000000000083.title: "A Fresh Cup"
	quest.6A81000000000088.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Void Tea\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with its matching tea bag in a heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the \"},{\"text\":\"teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving.\"}]}"
		"{\"text\":\"Teapot\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BA7892EA25F733A\"}}"
	]
	quest.6A81000000000088.title: "A Cup of the Void"
	quest.6A8100000000008D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Brew \"},{\"text\":\"Ender Dragon Tea\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with its matching tea bag in a heated \"},{\"text\":\"Teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep an Empty \"},{\"text\":\"Cup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the \"},{\"text\":\"teapot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for serving.\"}]}"
		"{\"text\":\"Teapot\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4BA7892EA25F733A\"}}"
	]
	quest.6A8100000000008D.title: "A Dragon in Your Teacup"
	quest.6A81000000000092.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can use \"},{\"text\":\"Chorus Seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to plant chorus on \"},{\"text\":\"End Stone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A81000000000092.title: "A Seed of Possibility"
	quest.6A81000000000096.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"You can use \"},{\"text\":\"Dragon Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as reusable bone meal.\"}]}"]
	quest.6A81000000000096.title: "A Dusting of Growth"
	quest.6A8100000000009A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Chorus Flower Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses an ingredient-assembly \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep its baking \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" together and check the \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s tooltip before deciding when to eat it.\"}]}"
	]
	quest.6A8100000000009A.title: "A Cake from the End"
	quest.6A810000000000A0.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Dragon Egg Ice Cream\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses a \"},{\"text\":\"Dragon Egg Shell\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" along with its chilled ingredients.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve a shell for the dessert instead of using the entire supply for \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" servings.\"}]}"
	]
	quest.6A810000000000A0.title: "A Frozen Dragon's Egg"
	quest.6A810000000000A3.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Dragon Egg Custard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" cooks in a \"},{\"text\":\"Water-filled Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and is served in a \"},{\"text\":\"Dragon Egg Shell\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep spare shells beside the pot and reserve \"},{\"text\":\"Dragon Egg Liquid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the next batch.\"}]}"
	]
	quest.6A810000000000A3.title: "A Silky Dragon's Egg"
	quest.6A810000000000A6.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep a \"},{\"text\":\"Dragon Tooth\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from the \"},{\"text\":\"Ender Dragon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as part of your \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" expedition collection.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Store\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with other \"},{\"text\":\"rare\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"End\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" drops when returning to the outpost so it is easy to find for later uses.\"}]}"
	]
	quest.6A810000000000A6.title: "A Dragon's Tooth"
	quest.6A82000000000001.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Glass Bottle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on the \"},{\"text\":\"Ender Dragon's\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" breath cloud to collect Dragon's Breath.\"}]}"
		"{\"text\":\"Dragon Breath Bucket\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6A81000000000064\"}}"
	]
	quest.6A82000000000001.title: "A Breath in a Bottle"
	quest.6A8509BF5F7846DC.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Apply this template at a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to change the tackle's appearance. Check the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for its matching material.\"}]}"]
	quest.6A8509BF5F7846DC.title: "Pearl Tackle Smithing Template"
	quest.6A86000000002000.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Quark\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" adds useful \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and small improvements throughout the world. These quests introduce a few highlights available in this pack.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Read this page and tick the task to open the tool branches and the decorative palette below. \"},{\"text\":\"Item\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tasks ask you to obtain sample \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; the descriptions suggest ways to try them.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"A few everyday shortcuts are enabled too: \"},{\"text\":\"right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" mature \"},{\"text\":\"crops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"harvest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", place \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" around an edge with reacharound placing, and keep spare \"},{\"text\":\"tools\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in your inventory for automatic restocking.\"}]}"
	]
	quest.6A86000000002000.title: "Small Changes, Big Help"
	quest.6A86000000002001.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Seed Pouch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" holds one kind of seed or sapling, up to \"},{\"text\":\"640 items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in this pack.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with one crop and use it on \"},{\"text\":\"farmland\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to plant a \"},{\"text\":\"3 x 3\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" patch. Keep different \"},{\"text\":\"crops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in separate pouches.\"}]}"
	]
	quest.6A86000000002001.title: "A Pocketful of Seeds"
	quest.6A86000000002002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Feeding Trough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" inside an animal pen and stock it with the \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" your animals breed with.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Nearby\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" animals can eat and breed without being hand-fed. Keep the trough supplied and leave room: overcrowding stops breeding, and eating does not always result in breeding.\"}]}"
	]
	quest.6A86000000002002.title: "Let the Herd Help Itself"
	quest.6A86000000002003.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Put a selection of building \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on your hotbar, then use the \"},{\"text\":\"Trowel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to place a random \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from those slots.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Repeat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in more hotbar slots to give it a \"},{\"text\":\"larger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" share of the pattern. The \"},{\"text\":\"trowel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has no durability limit in this pack.\"}]}"
	]
	quest.6A86000000002003.title: "Mix Your Building Palette"
	quest.6A86000000002004.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Glass Item Frames\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" disappear when they hold an item, leaving the displayed object visible as a \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"label\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through the frame to open the \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" behind it. \"},{\"text\":\"Glow Glass Item Frames\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" provide a brighter display.\"}]}"
	]
	quest.6A86000000002004.title: "Labels Without the Frame"
	quest.6A86000000002005.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" arrows with torches to make eight \"},{\"text\":\"Torch Arrows\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Bring a bow when exploring a cave.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Shoot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" one at a distant surface: the arrow tries to place a torch where it lands. Use it to light ledges or inspect a dark route before walking in.\"}]}"
	]
	quest.6A86000000002005.title: "Light the Way from Afar"
	quest.6A86000000002006.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use an empty bucket on a small slime to obtain a \"},{\"text\":\"Slime\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a \"},{\"text\":\"Bucket\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Split\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"larger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" slime down to its smallest size first.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the bucket in your \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and watch its icon as you travel: the slime becomes excited in a slime chunk. \"},{\"text\":\"Mark\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" that chunk if you want to build a slime farm later.\"}]}"
	]
	quest.6A86000000002006.title: "A Slime Chunk Detector"
	quest.6A86000000002007.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cartographers and Wandering Traders\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sell the \"},{\"text\":\"Pathfinder's Quill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Its tooltip names the biome it searches for.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the quill and wait for the search to finish. It becomes a \"},{\"text\":\"Pathfinder Map\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when it finds a destination; follow that map to the biome.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"If no target is found, travel farther and try again. The search radius is \"},{\"text\":\"6400 blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in this pack.\"}]}"
	]
	quest.6A86000000002007.title: "A Map to Your Next Biome"
	quest.6A86000000002008.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Face\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Dispenser\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" toward an empty space and load it with a building \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Quark\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" lets it place ordinary blocks in this pack.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pulse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with a \"},{\"text\":\"Lever\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and test a few placements before connecting it to a \"},{\"text\":\"larger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" machine.\"}]}"
	]
	quest.6A86000000002008.title: "A Simple Block Placer"
	quest.6A86000000002009.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Redstone Randomizer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sends each incoming \"},{\"text\":\"redstone signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to either its left or right \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at random.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect a button to the \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and lamps to both outputs to test it. Use the changing \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a game or a random display.\"}]}"
	]
	quest.6A86000000002009.title: "Let Redstone Choose"
	quest.6A87000000002000.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Framed Glass\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a workshop window or greenhouse wall to add detail to a flat surface.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Framed Glass Panes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" offer a thinner version for smaller windows and interior partitions.\"}]}"
	]
	quest.6A87000000002000.title: "Windows with a Frame"
	quest.6A87000000002001.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Turn terracotta into \"},{\"text\":\"Shingles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then prepare \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" full blocks and eight Shingle Stairs.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Try a small pitched roof. \"},{\"text\":\"Quark\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" also offers slabs and colored shingles, so you can match the roof to your walls.\"}]}"
	]
	quest.6A87000000002001.title: "A Proper Tiled Roof"
	quest.6A87000000002002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine Oak Leaves\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with oak logs to obtain \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Oak Hedges.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use them around a garden, path or animal pen. Other leaf types provide different colors for the same kind of border.\"}]}"
	]
	quest.6A87000000002002.title: "A Living Garden Border"
	quest.6A87000000002003.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Combine Cobblestone Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with \"},{\"text\":\"Carved Mud Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a sample wall.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Try a stone base and a warmer mud-brick band. \"},{\"text\":\"Stairs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", slabs and walls carry the same palette around corners.\"}]}"
	]
	quest.6A87000000002003.title: "A Masonry Sample Wall"
	quest.6A87000000002004.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Raw Iron Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" work as an accent around a mine entrance, ore \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or smelting area.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use their raw-metal texture beside plain stone or metal rather than covering every surface with the same pattern.\"}]}"
	]
	quest.6A87000000002004.title: "An Ore-Textured Accent"
	quest.6A87000000002005.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Moss Paste\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make \"},{\"text\":\"16\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Midori Blocks, then prepare four Midori Pillars.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Try a green courtyard, bathhouse or garden arch. \"},{\"text\":\"Pillars\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" add a different texture without changing the color palette.\"}]}"
	]
	quest.6A87000000002005.title: "Green Stone and Pillars"
	quest.6A87000000002006.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pair Soul Sandstone and Soul Sandstone Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with dark wood or \"},{\"text\":\"soul\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" lighting for a \"},{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" outpost.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compare the plain and brick textures on a small wall before extending the palette to the whole building.\"}]}"
	]
	quest.6A87000000002006.title: "A Palette from Soul Sand"
	quest.6A87000000002007.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Spruce Bookshelves and Spruce Chests\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" together in a study or storeroom.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Matching\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" wood lets useful furniture fit the walls, shelves and other furnishings around it.\"}]}"
	]
	quest.6A87000000002007.title: "Furnish a Spruce Interior"
	quest.6A88000000002000.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Create Deco\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" adds masonry, metal structures and small finishing details for workshops, stations and factories.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Tick this introduction to open four short branches. The item tasks ask you to obtain sample materials; each description suggests a small build to try.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Many\"},{\"text\":\" blocks come in iron, industrial iron, andesite, copper, brass or zinc versions.\"}]}"
	]
	quest.6A88000000002000.title: "Give the Factory a Finish"
	quest.6A88000000002001.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compare \"},{\"text\":\"Pearl Bricks and Umber Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in two small panels beside your factory machinery.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a light wall with darker trim, or reverse the colours for a heavier industrial appearance.\"}]}"
	]
	quest.6A88000000002001.title: "Choose a Brick Palette"
	quest.6A88000000002002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Long Red Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" along a wall's base and \"},{\"text\":\"Tiled Red Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" around a doorway.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Stonecutting\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" changes the pattern while keeping the same colour, making it easy to add detail without changing the whole palette.\"}]}"
	]
	quest.6A88000000002002.title: "Change the Brick Pattern"
	quest.6A88000000002003.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mix \"},{\"text\":\"Mossy Red Bricks and Cracked Red Bricks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into a plain wall to suggest damp corners, age or an abandoned workshop.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use them in small patches so the weathering follows the shape of the building.\"}]}"
	]
	quest.6A88000000002003.title: "A Factory with Some History"
	quest.6A88000000002004.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Industrial Iron Sheet Metal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the walls of a machine room. Press \"},{\"text\":\"Industrial Iron Ingots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into sheets when supplying the cladding \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save extra sheets and ingots for matching supports, walkways and other metal details.\"}]}"
	]
	quest.6A88000000002004.title: "Industrial Iron Cladding"
	quest.6A88000000002005.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Industrial Iron Catwalks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a maintenance walkway above a machine line.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect the walkway to the floor with \"},{\"text\":\"Catwalk Stairs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and finish exposed edges with matching \"},{\"text\":\"Catwalk Railings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A88000000002005.title: "Walk Above the Machines"
	quest.6A88000000002006.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Frame\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a loading entrance with \"},{\"text\":\"Industrial Iron Supports\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and add \"},{\"text\":\"Support Wedges\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at the corners.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"These decorative parts give a large roof or walkway a more convincing structure.\"}]}"
	]
	quest.6A88000000002006.title: "Beams and Braces"
	quest.6A88000000002007.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Industrial Iron Windows\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a workshop facade and \"},{\"text\":\"Industrial Iron Bars\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to divide a machine bay.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Both carry the same metal palette into different parts of the building.\"}]}"
	]
	quest.6A88000000002007.title: "Windows for the Machine Hall"
	quest.6A88000000002008.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Pair Industrial Iron Doors\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with matching \"},{\"text\":\"Trapdoors\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a service entrance and maintenance hatch.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Fit the controls needed by the chosen door before enclosing the entrance.\"}]}"
	]
	quest.6A88000000002008.title: "A Matching Service Entrance"
	quest.6A88000000002009.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place \"},{\"text\":\"Red Industrial Iron Cage Lamps\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" around a \"},{\"text\":\"work area\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to give its lighting a consistent metal finish.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Other lamp colours and cage metals let you match different rooms or production lines.\"}]}"
	]
	quest.6A88000000002009.title: "Cage Lights for the Workshop"
	quest.6A8800000000200A.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cut Iron Sheets\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into two \"},{\"text\":\"Warning Decals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and two \"},{\"text\":\"Right Arrow Decals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using a Stonecutter.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place warning symbols near dangerous machinery and arrows along a route to \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Other decals offer more directions and hazard symbols.\"}]}"
	]
	quest.6A8800000000200A.title: "Mark Routes and Hazards"
	quest.6A8800000000200B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Yellow Placards\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside doors and workstations to mark related areas.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the same colour for one department and compare the other \"},{\"text\":\"placard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" variants before marking the \"},{\"text\":\"rest\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of the factory.\"}]}"
	]
	quest.6A8800000000200B.title: "Signs for Each Work Area"
	quest.6A8800000000200C.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Industrial Iron Train Hull\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a carriage or loading platform, with \"},{\"text\":\"Red Shipping Containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the freight yard.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Compare the other metal and \"},{\"text\":\"container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" colours when extending the station.\"}]}"
	]
	quest.6A8800000000200C.title: "Finish the Loading Yard"
	quest.6A89000000000100.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Physics Assembler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" turns glued \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into a \"},{\"text\":\"Simulated Contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Start with a small test craft close to the ground.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Super Glue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Honey Glue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to select its \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then \"},{\"text\":\"hold right-click\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and pull the assembler lever. Open \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the exact assembly controls. \"},{\"text\":\"Item\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tasks do not consume items; tick practical tasks after testing.\"}]}"
	]
	quest.6A89000000000100.title: "Your First Physics Assembler"
	quest.6A89000000000101.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Super Glue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to select the craft's frame, cargo and machinery. \"},{\"text\":\"Include\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" every part that should move and avoid gluing the launch platform to the hull.\"}]}"]
	quest.6A89000000000101.title: "A Hull That Stays Together"
	quest.6A89000000000102.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Contraption Diagram\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to inspect the assembled build. Keep your first hull small while learning how mass and connections affect movement.\"}]}"]
	quest.6A89000000000102.title: "Inspect Your Contraption"
	quest.6A89000000000103.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Produce Honey Glue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by filling an \"},{\"text\":\"iron plate\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with honey. \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" scene and compare the available connections before using it in your hull.\"}]}"]
	quest.6A89000000000103.title: "Honey Glue"
	quest.6A89000000000104.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Portable Engine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on the craft to \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its machinery away from the ground.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Leave access for \"},{\"text\":\"fuel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then test the moving build without a shaft connection to the launch platform.\"}]}"
	]
	quest.6A89000000000104.title: "A Portable Power Plant"
	quest.6A89000000000105.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mount the Portable Engine\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"fuel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply and a short \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" network on the same craft. Run it without any \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" connection to the launch platform. Tick after verifying independent \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A89000000000105.title: "Power Away from the Ground"
	quest.6A89000000000106.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Add a \"},{\"text\":\"barrel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to the hull and secure it with glue. Test lift with cargo loaded: \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and its contents can change how the craft behaves.\"}]}"]
	quest.6A89000000000106.title: "Make Room for Cargo"
	quest.6A89000000000107.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build a pair of \"},{\"text\":\"Docking Connectors\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Extended\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" connectors align and lock the two contraptions together while keeping them independent.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Once locked, they can transfer \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"fluids\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Arrange insertion and extraction on both sides; retract either connector to undock.\"}]}"
	]
	quest.6A89000000000107.title: "A Dock That Transfers Cargo"
	quest.6A89000000000108.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a ground dock and a connector on your craft. \"},{\"text\":\"Lock\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" them, transfer a stack of supplies, undock and connect again. Tick after checking that cargo reaches the receiving \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A89000000000108.title: "Load, Undock and Return"
	quest.6A89000000000109.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build a closed \"},{\"text\":\"Hot Air Envelope\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with usable empty volume inside. The \"},{\"text\":\"amount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" of lift depends on the enclosed space, so a solid pile of envelope \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" will not work.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Start with a small hollow shape and inspect the envelope \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" scene before assembling.\"}]}"
	]
	quest.6A89000000000109.title: "An Airtight Balloon"
	quest.6A8900000000010A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Hot Air Burner\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" under the balloon. \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its maximum \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and apply \"},{\"text\":\"redstone power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; signal strength scales the hot air output.\"}]}"]
	quest.6A8900000000010A.title: "Fill the Balloon with Hot Air"
	quest.6A8900000000010B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use envelope encasing where a \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" passes through the balloon shell. Check the \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" scene for the encasing interaction and make sure the balloon remains sealed.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build the sealed \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" passage and confirm the balloon can fill, then tick this task.\"}]}"
	]
	quest.6A8900000000010B.title: "Keep the Shaft Airtight"
	quest.6A8900000000010C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Fill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an airtight envelope structure with hot \"},{\"text\":\"air\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to earn the \"},{\"text\":\"Aeronautics\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement. Watch lift and weight, then adjust burner \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" gradually.\"}]}"]
	quest.6A8900000000010C.title: "Head in the Clouds"
	quest.6A8900000000010D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Steam Vent\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a working boiler and feed the envelope with \"},{\"text\":\"steam\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Supply enough water, heat and boiler capacity.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"vent\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" needs redstone \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; multiple vents share the boiler's available power.\"}]}"
	]
	quest.6A8900000000010D.title: "Steam-Powered Lift"
	quest.6A8900000000010E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Add an \"},{\"text\":\"Altitude Sensor\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Its redstone \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" depends on height and can be configured in the interface. \"},{\"text\":\"Lift\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" thrust weaken as \"},{\"text\":\"air\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" pressure drops at higher altitude.\"}]}"]
	quest.6A8900000000010E.title: "Altitude and Air Pressure"
	quest.6A8900000000010F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"With the craft assembled, lift off, hold a steady height and return to the launch area using controlled burner or \"},{\"text\":\"vent\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Tick after landing without losing the cargo.\"}]}"]
	quest.6A8900000000010F.title: "Controlled Takeoff and Landing"
	quest.6A89000000000110.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Wooden Propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a small craft. \"},{\"text\":\"Reverse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rotation or adjust thrust direction with the wrench to compare forward and reverse thrust.\"}]}"]
	quest.6A89000000000110.title: "The First Propeller"
	quest.6A89000000000111.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place and \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a propeller to earn the \"},{\"text\":\"Aeronautics\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" thrust advancement. \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the thrust and airflow information with goggles.\"}]}"]
	quest.6A89000000000111.title: "For Every Action"
	quest.6A89000000000112.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Try \"},{\"text\":\"Andesite Propellers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in a compact propulsion unit. Compare direction, \"},{\"text\":\"shaft\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"speed\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and the loaded craft's response before adding more.\"}]}"]
	quest.6A89000000000112.title: "Andesite Propellers"
	quest.6A89000000000113.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" structure to a \"},{\"text\":\"Propeller Bearing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with at least two valid sail-like blocks. More sails improve thrust efficiency.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the \"},{\"text\":\"propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s swept area clear of the hull and dock.\"}]}"
	]
	quest.6A89000000000113.title: "Build a Larger Propeller"
	quest.6A89000000000114.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Assemble\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Propeller Bearing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to generate thrust and earn its Aeronautics advancement.\"}]}"]
	quest.6A89000000000114.title: "In Thrust We Trust"
	quest.6A89000000000115.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Gyroscopic Propeller Bearing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when building a helicopter or a craft needing an upright rotor. It tries to keep the \"},{\"text\":\"propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upright; a \"},{\"text\":\"redstone signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" resets the tilt.\"}]}"]
	quest.6A89000000000115.title: "A Stable Rotor"
	quest.6A89000000000116.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Smart Propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" pitches along one axis to try to face upward. Check its orientation and use the \"},{\"text\":\"wrench\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to reverse thrust when needed.\"}]}"]
	quest.6A89000000000116.title: "Compact Stabilising Thrust"
	quest.6A89000000000117.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a \"},{\"text\":\"propeller\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"-driven craft, take off, turn and land near the starting point. Test with its normal cargo load. Tick once you can control the craft consistently.\"}]}"]
	quest.6A89000000000117.title: "A Powered Test Flight"
	quest.6A89000000000118.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Wear \"},{\"text\":\"Aviator's Goggles\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to inspect kinetic machinery and flight components. Use the readouts while tuning the craft instead of guessing its \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A89000000000118.title: "Instruments for the Pilot"
	quest.6A89000000000119.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Install a \"},{\"text\":\"Throttle Lever\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to adjust analog redstone \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by dragging it. Connect it to the burner or another component that accepts proportional control.\"}]}"]
	quest.6A89000000000119.title: "A Throttle in the Cockpit"
	quest.6A8900000000011A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Linked Controller and Redstone Links\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to control selected functions. Bind and test every control while the craft is still on the ground.\"}]}"]
	quest.6A8900000000011A.title: "Wireless Flight Controls"
	quest.6A8900000000011B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Steering Wheel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and inspect its rotational output in \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its maximum angle and ensure connected bearings are set to stay assembled while steering.\"}]}"]
	quest.6A8900000000011B.title: "A Wheel for Precise Control"
	quest.6A8900000000011C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Velocity Sensor\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" reports motion and a \"},{\"text\":\"Gimbal Sensor\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" reports orientation. \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" their \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" directions and configure them before connecting an automatic control circuit.\"}]}"]
	quest.6A8900000000011C.title: "Read Speed and Orientation"
	quest.6A8900000000011D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Provide\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a supported navigation item to the \"},{\"text\":\"Navigation Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Its redstone feedback indicates the destination direction; test its response before using it to assist flight.\"}]}"]
	quest.6A8900000000011D.title: "A Navigation Table"
	quest.6A8900000000011E.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Crush \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"End Stone\"},{\"text\":\" into powder, then use \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"heated\"},{\"text\":\" mixing with zinc nuggets and water to make \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Levitite Blend\"},{\"text\":\". Collect it in a bucket.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Heat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can trigger crystallisation. Plan the casting area first: \"},{\"text\":\"Levitite\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" alone keeps a craft afloat but cannot make it gain altitude.\"}]}"
	]
	quest.6A8900000000011E.title: "Beyond Hot Air"
	quest.6A8900000000011F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Crystallise Levitite Blend\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into \"},{\"text\":\"Levitite\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to earn its \"},{\"text\":\"Aeronautics\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement. The reaction spreads through connected blend and can destroy unsuitable casting \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A8900000000011F.title: "Cast Levitite"
	quest.6A89000000000120.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a controllable cargo craft with independent \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a working dock. Load supplies, fly them to a second landing area, unload and return. Tick after completing the round trip.\"}]}"]
	quest.6A89000000000120.title: "A Cargo Route Through the Sky"
	quest.6A89000000000121.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build the \"},{\"text\":\"Mounted Potato Cannon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using \"},{\"text\":\"Mechanical Crafting\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Supply supported ammunition, \"},{\"text\":\"charge\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with rotational power and apply redstone to fire.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the first test aimed at an empty area away from your craft and dock.\"}]}"
	]
	quest.6A89000000000121.title: "A Mounted Potato Cannon"
	quest.6A90000000000100.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Turn separate machines into one supply network: store bulk materials, sort \"},{\"text\":\"belt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" traffic, request packages and move \"},{\"text\":\"fluids\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Item\"},{\"text\":\" tasks detect items in your inventory without consuming them. \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Practical\"},{\"text\":\" build tasks use a manual checkmark: tick them after testing the described setup.\"}]}"
	]
	quest.6A90000000000100.title: "A Factory That Delivers"
	quest.6A90000000000101.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build an \"},{\"text\":\"Item Vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for bulk materials. \"},{\"text\":\"Join\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" matching \"},{\"text\":\"vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then use funnels, chutes or other inventory connections to insert and extract.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Vaults\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" have no normal chest screen. Check capacity and multiblock placement with \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A90000000000101.title: "Bulk Storage"
	quest.6A90000000000102.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a \"},{\"text\":\"vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a separate \"},{\"text\":\"input and output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Send\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at least one stack of cobblestone through it and confirm that extraction works before expanding.\"}]}"]
	quest.6A90000000000102.title: "A Working Warehouse"
	quest.6A90000000000103.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Vibrant Vaults\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to fit bulk \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into a taller building. Any item in the vertical \"},{\"text\":\"vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tag counts; inspect its \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" scene for assembly rules.\"}]}"]
	quest.6A90000000000103.title: "Vertical Vaults"
	quest.6A90000000000104.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Shipping Containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" provide \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a warehouse or freight yard. Any colour in the \"},{\"text\":\"Shipping Containers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tag counts.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect them to belts, interfaces, packages or trains when you need to move their contents elsewhere.\"}]}"
	]
	quest.6A90000000000104.title: "Shipping Containers"
	quest.6A90000000000105.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Choose any coloured \"},{\"text\":\"Vibrant Vault\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Give raw materials, parts and finished goods distinct \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" zones so inputs are easy to trace.\"}]}"]
	quest.6A90000000000105.title: "Colour-Coded Storage"
	quest.6A90000000000106.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Sophisticated Storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" controller and \"},{\"text\":\"Storage I\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"/O as the access point for your existing \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" network. Connect \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" insertion and extraction there, then check both directions.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The installed \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" compatibility mods extend \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" handling; test the actual \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" connection before building a large factory.\"}]}"
	]
	quest.6A90000000000106.title: "Connect Your Storage Controller"
	quest.6A90000000000107.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Threshold Switch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", set low and high levels, and use its redstone \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to stop production when the buffer is full.\"}]}"]
	quest.6A90000000000107.title: "Stop Before Overflow"
	quest.6A90000000000108.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Smart Observer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to watch \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or passing \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Select the product that should trigger your next production step.\"}]}"]
	quest.6A90000000000108.title: "Detect the Right Product"
	quest.6A90000000000109.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect a \"},{\"text\":\"Display Link\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a supported source and bind it to a \"},{\"text\":\"Display Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Choose the available stock or status information in the link interface.\"}]}"]
	quest.6A90000000000109.title: "Warehouse Status Board"
	quest.6A9000000000010A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a \"},{\"text\":\"warehouse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with two separate resources, \"},{\"text\":\"filtered outputs\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", an \"},{\"text\":\"overflow stop\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a readable \"},{\"text\":\"status display\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Test filling, draining and automatic restart, then tick this task.\"}]}"]
	quest.6A9000000000010A.title: "A Warehouse That Regulates Itself"
	quest.6A9000000000010B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect powered shafts with \"},{\"text\":\"Mechanical Belts\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Place \"},{\"text\":\"Andesite Funnels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at inventories, then check arrow directions before starting the line.\"}]}"]
	quest.6A9000000000010B.title: "Belts and Transfer Points"
	quest.6A9000000000010C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Chutes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for vertical item paths. \"},{\"text\":\"Inspect Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before adding fans or side inputs; make sure the receiving \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has space.\"}]}"]
	quest.6A9000000000010C.title: "Gravity and Vertical Transfer"
	quest.6A9000000000010D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place \"},{\"text\":\"Andesite Tunnels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" over belts to route simple lines through your factory. Use \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to check valid connections and item movement.\"}]}"]
	quest.6A9000000000010D.title: "Cover and Split Belt Lines"
	quest.6A9000000000010E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Brass Funnels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" can \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" items and control transfer sizes. \"},{\"text\":\"Smart Chutes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" add filtered vertical transfer. Use these where an \"},{\"text\":\"Andesite Funnel\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is too limited.\"}]}"]
	quest.6A9000000000010E.title: "Controlled Sorting"
	quest.6A9000000000010F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"List Filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for selected \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then try an \"},{\"text\":\"Attribute Filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for a category such as a mod or item property.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Install \"},{\"text\":\"filters\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into supported \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" slots. Check whitelist and blacklist mode before running mixed items.\"}]}"
	]
	quest.6A9000000000010F.title: "Lists and Attributes"
	quest.6A90000000000110.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use \"},{\"text\":\"Brass Tunnels\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to distribute \"},{\"text\":\"belt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" traffic. Select the distribution \"},{\"text\":\"mode\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"wrench\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and test what happens when one destination fills up.\"}]}"]
	quest.6A90000000000110.title: "Distribute Across Outputs"
	quest.6A90000000000111.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a \"},{\"text\":\"belt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" carrying three different materials. \"},{\"text\":\"Route\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" each into its own \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and provide a safe destination for unmatched \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Test a full \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then tick this task.\"}]}"]
	quest.6A90000000000111.title: "A Three-Way Sorting Line"
	quest.6A90000000000112.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Configure Weighted Ejectors\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for item transfer across a gap. Keep the landing point clear and test a single stack before sending valuable parts.\"}]}"]
	quest.6A90000000000112.title: "Across the Factory Floor"
	quest.6A90000000000113.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Align\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a pair of \"},{\"text\":\"Portable Storage Interfaces\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": one on the moving \"},{\"text\":\"contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and one at its stop.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Stop\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside the fixed interface and extract items on the stationary side.\"}]}"
	]
	quest.6A90000000000113.title: "Unload Moving Storage"
	quest.6A90000000000114.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a moving \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" farm or carrier with attached \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Stop\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside its interface, unload into your sorting line, then send it out again. Tick after a successful transfer cycle.\"}]}"]
	quest.6A90000000000114.title: "The Farm Unloads Itself"
	quest.6A90000000000115.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to an \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". A \"},{\"text\":\"redstone signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" makes a package; an incoming package is unpacked into that inventory when all its contents fit.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Any \"},{\"text\":\"Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Vibrant Vaults\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" packagers tag counts, including the normal Create version.\"}]}"
	]
	quest.6A90000000000115.title: "Your First Packager"
	quest.6A90000000000116.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a stack from one \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", move the package to another \"},{\"text\":\"Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and recover its contents there.\"}]}"]
	quest.6A90000000000116.title: "Pack and Unpack"
	quest.6A90000000000117.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Give outgoing packages an address using the \"},{\"text\":\"Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sign or a logistics request. \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Package Filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to route that address to the correct receiving line.\"}]}"]
	quest.6A90000000000117.title: "Addresses and Package Filters"
	quest.6A90000000000118.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bind \"},{\"text\":\"Stock Links\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to the same network before placing them on your \"},{\"text\":\"Packagers\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Linked\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" inventories become available for requests.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The stock \"},{\"text\":\"signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" has unlimited \"},{\"text\":\"range\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"; the actual packages still need a physical delivery route.\"}]}"
	]
	quest.6A90000000000118.title: "One Stock Network"
	quest.6A90000000000119.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bind a \"},{\"text\":\"Stock Ticker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to your \"},{\"text\":\"Stock Link\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" network. Place a seated \"},{\"text\":\"mob\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Blaze Burner\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as its keeper and order items to a destination address.\"}]}"]
	quest.6A90000000000119.title: "Request from the Warehouse"
	quest.6A9000000000011A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect \"},{\"text\":\"Chain Conveyors\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" using \"},{\"text\":\"chains\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the network. Leave room for packages to travel above your machines.\"}]}"]
	quest.6A9000000000011A.title: "Overhead Package Transport"
	quest.6A9000000000011B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bind two \"},{\"text\":\"Frogports\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to your chain network and give each an address. Test sending a \"},{\"text\":\"package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to the other port; a \"},{\"text\":\"package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" without a matching destination will keep circling.\"}]}"]
	quest.6A9000000000011B.title: "Frogport Delivery"
	quest.6A9000000000011C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bind a \"},{\"text\":\"Redstone Requester\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to the stock network, configure an order and destination, then send one \"},{\"text\":\"redstone pulse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Each pulse creates a new request.\"}]}"]
	quest.6A9000000000011C.title: "Orders from Redstone"
	quest.6A9000000000011D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bind a \"},{\"text\":\"Factory Gauge\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to your stock network and place it on a \"},{\"text\":\"Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Select an item, destination address and target quantity to refill that \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" automatically.\"}]}"]
	quest.6A9000000000011D.title: "Keep the Buffer Supplied"
	quest.6A9000000000011E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Collect the fragments of one order in an \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Re-Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". It waits for all fragments and exports the combined \"},{\"text\":\"package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use this before \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" inputs that must arrive together.\"}]}"]
	quest.6A9000000000011E.title: "Keep Ingredients Together"
	quest.6A9000000000011F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect ingredient gauges to an \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" gauge, configure the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" amounts and delivery address, and return products to linked \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"For crafting-table recipes, use the gauge's auto-arrangement with a connected \"},{\"text\":\"3x3\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"Mechanical Crafter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" grid. A \"},{\"text\":\"Re-Packager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" helps keep ingredient packages together.\"}]}"
	]
	quest.6A9000000000011F.title: "Craft to a Target Stock"
	quest.6A90000000000120.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build two linked \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" inventories, a \"},{\"text\":\"Stock Ticker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and an addressed \"},{\"text\":\"package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" route. \"},{\"text\":\"Order\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an item, receive it at the correct destination and use a \"},{\"text\":\"Factory Gauge\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to replenish a depleted buffer. Tick after the complete test.\"}]}"]
	quest.6A90000000000120.title: "An Order That Finishes the Journey"
	quest.6A90000000000121.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect \"},{\"text\":\"Fluid Tanks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into a multiblock. \"},{\"text\":\"Attach\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for filling and draining; keep different fluids on separate lines.\"}]}"]
	quest.6A90000000000121.title: "Bulk Fluid Storage"
	quest.6A90000000000122.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Mechanical Pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and check its direction with the \"},{\"text\":\"wrench\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Connect source, pump and destination with \"},{\"text\":\"Fluid Pipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then test a short line first.\"}]}"]
	quest.6A90000000000122.title: "Move Fluids with Pumps"
	quest.6A90000000000123.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Fluid Valve\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to control flow and a \"},{\"text\":\"Smart Fluid Pipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to restrict the \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" accepted by a branch. Set the \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before connecting mixed processing lines.\"}]}"]
	quest.6A90000000000123.title: "Valves and Fluid Filters"
	quest.6A90000000000124.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Lower a \"},{\"text\":\"Hose Pulley\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into a \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" source and connect its pipe to a \"},{\"text\":\"pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the source and the mod's fluid rules before planning large-scale extraction.\"}]}"]
	quest.6A90000000000124.title: "Pumping from the World"
	quest.6A90000000000125.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Spout\"},{\"text\":\" to fill supported \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"items\"},{\"text\":\" with fluid. Use an \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Item Drain\"},{\"text\":\" to recover fluid from containers.\"}]}"
	]
	quest.6A90000000000125.title: "Fill and Empty Containers"
	quest.6A90000000000126.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Align Portable Fluid Interfaces\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a moving \"},{\"text\":\"contraption\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and its stopping point.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the stationary pipework to transfer \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when the interfaces connect.\"}]}"
	]
	quest.6A90000000000126.title: "Unload Moving Tanks"
	quest.6A90000000000127.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a tank, \"},{\"text\":\"pump\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", controlled pipe and filling station. \"},{\"text\":\"Fill\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", empty it back through an \"},{\"text\":\"Item Drain\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and verify the \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" returns to storage. Tick after testing the full route.\"}]}"]
	quest.6A90000000000127.title: "A Closed Fluid Route"
	quest.6A90000000000128.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bind \"},{\"text\":\"Postboxes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to \"},{\"text\":\"Train Stations\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before placing them nearby. Set addresses; stopping trains collect outgoing packages and drop off matching ones. \"},{\"text\":\"Continue\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Trains\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" chapter to build the route.\"}]}"]
	quest.6A90000000000128.title: "Packages by Rail"
	quest.6A90000000000129.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect your regulated \"},{\"text\":\"warehouse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", sorting line, \"},{\"text\":\"package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" network and \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" route. \"},{\"text\":\"Deliver\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a requested part to a working machine, then confirm the \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" returns to storage without manual carrying.\"}]}"]
	quest.6A90000000000129.title: "A Connected Supply System"
	quest.6A9000000000012A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place \"},{\"text\":\"Depots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at the ends of processing steps or beside machines. Use funnels or a \"},{\"text\":\"Mechanical Arm\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to move \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between these buffer points.\"}]}"]
	quest.6A9000000000012A.title: "Buffers on the Work Floor"
	quest.6A9000000000012B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Select the arm's \"},{\"text\":\"input and output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" targets before placing it, then \"},{\"text\":\"power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it and choose a distribution \"},{\"text\":\"mode\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use it between supported inventories, depots and machines where a straight \"},{\"text\":\"belt\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is awkward. \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its reach and target setup in \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A9000000000012B.title: "A Mechanical Arm"
	quest.6A9000000000012C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Mechanical Arm\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to take \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from one \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", feed two supported \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" targets and collect the resulting products into storage. Test a full destination, then tick this task.\"}]}"]
	quest.6A9000000000012C.title: "Supply a Machine with an Arm"
	quest.6A91000000000100.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Plan a line between your factory and a resource outpost. This chapter covers \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", train assembly, automatic driving, freight and \"},{\"text\":\"signals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Item\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tasks detect \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" without consuming them. \"},{\"text\":\"Practical\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" build tasks have a manual checkmark: tick them after the described test. Open \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on tracks, stations and controls before building.\"}]}"
	]
	quest.6A91000000000100.title: "Build a Railway"
	quest.6A91000000000101.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use long placement and curves when laying \"},{\"text\":\"Train Tracks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to create a smooth route.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Leave clearance around bends and station platforms, then inspect the full path before assembling a train.\"}]}"
	]
	quest.6A91000000000101.title: "Lay Your First Track"
	quest.6A91000000000102.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"station marker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" beside its \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", give it a clear name and build a second station at the destination. Check each marker's \"},{\"text\":\"facing direction\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A91000000000102.title: "Two Named Stations"
	quest.6A91000000000103.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect two named stations with an uninterrupted \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" curves and clearances, then confirm that your train can reach both station markers. Tick after the first manual trip.\"}]}"]
	quest.6A91000000000103.title: "A Continuous Route"
	quest.6A91000000000104.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Automate\"},{\"text\":\" track production using \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Deployers\"},{\"text\":\" and a \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Mechanical Press\"},{\"text\":\". Keep ingredients supplied and collect the finished tracks into storage.\"}]}"
	]
	quest.6A91000000000104.title: "A Track Production Line"
	quest.6A91000000000105.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Run your \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" line automatically until it produces a fresh batch of at least \"},{\"text\":\"64\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" tracks. Test an interrupted \"},{\"text\":\"input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and make sure production resumes when it is refilled.\"}]}"]
	quest.6A91000000000105.title: "Tracks for the Next Outpost"
	quest.6A91000000000106.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Extend\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a railway through a suitable portal and ride a train through it to earn the \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement. Check \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and give the portal and both approaches enough clearance.\"}]}"]
	quest.6A91000000000106.title: "A Railway Between Dimensions"
	quest.6A91000000000107.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place \"},{\"text\":\"Train Controls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" facing the driving direction, with a \"},{\"text\":\"Seat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" close enough to use them.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"A second control position lets you drive from the opposite end of the train.\"}]}"
	]
	quest.6A91000000000107.title: "The Driver's Cab"
	quest.6A91000000000108.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Open the \"},{\"text\":\"Train Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" assembly interface and use \"},{\"text\":\"Railway Casings\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on the assembly \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to create bogeys.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Build the chassis around them, glue the moving parts and attach \"},{\"text\":\"Train Controls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Bogeys\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are placed during assembly; there is no separate bogey item to craft.\"}]}"
	]
	quest.6A91000000000108.title: "Bogeys and a Glued Chassis"
	quest.6A91000000000109.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Assemble\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a train at the \"},{\"text\":\"Train Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to earn the \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement. \"},{\"text\":\"Name\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it and take a short manual drive before adding cargo.\"}]}"]
	quest.6A91000000000109.title: "Your First Train"
	quest.6A9100000000010A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Write\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Train Schedule\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with both station names and useful waiting conditions. \"},{\"text\":\"Seat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a suitable \"},{\"text\":\"mob\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by the controls and hand it the schedule to start automatic driving.\"}]}"]
	quest.6A9100000000010A.title: "Give the Conductor a Schedule"
	quest.6A9100000000010B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Run an \"},{\"text\":\"automatic trip\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" between both stations and back. For a line without \"},{\"text\":\"turning loops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", provide controls for \"},{\"text\":\"both directions\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check that each stop is reached and the \"},{\"text\":\"schedule\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" repeats.\"}]}"]
	quest.6A9100000000010B.title: "A Working Automatic Shuttle"
	quest.6A9100000000010C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Add seats and a clear boarding area. \"},{\"text\":\"Train Doors and Train Trapdoors\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" help build the carriage; test boarding and leaving at a platform.\"}]}"]
	quest.6A9100000000010C.title: "A Passenger Carriage"
	quest.6A9100000000010D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach Item Vaults\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a carriage and include them in its glued structure before assembly. Leave space for loading interfaces and test the full carriage through a curve.\"}]}"]
	quest.6A9100000000010D.title: "A Freight Wagon"
	quest.6A9100000000010E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use paired \"},{\"text\":\"Portable Storage Interfaces\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": one on the carriage and one at a station. \"},{\"text\":\"Align\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" them where the train stops, then insert and extract through the stationary side.\"}]}"]
	quest.6A9100000000010E.title: "Load and Unload at a Stop"
	quest.6A9100000000010F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" schedule waiting conditions for the loading operation. Check the available cargo and inactivity conditions; leave enough time for the interfaces to finish.\"}]}"]
	quest.6A9100000000010F.title: "Wait for the Cargo"
	quest.6A91000000000110.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Load at least one stack at the source station, transport it with a scheduled train and unload it into a different \"},{\"text\":\"inventory\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at the destination. Tick after confirming the \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" arrived without manual transfer.\"}]}"]
	quest.6A91000000000110.title: "The First Automatic Freight Run"
	quest.6A91000000000111.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Attach Fluid Tanks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a carriage and use \"},{\"text\":\"Portable Fluid Interfaces\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at the stops. Connect pumps on the stationary sides and keep the \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" line separate from item cargo.\"}]}"]
	quest.6A91000000000111.title: "A Tank Carriage"
	quest.6A91000000000112.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Automatically fill the tank carriage at one station and drain it into a stationary tank at another. \"},{\"text\":\"Verify\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the transfer, waiting conditions and return trip before ticking.\"}]}"]
	quest.6A91000000000112.title: "Fluid by Rail"
	quest.6A91000000000113.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Bind each \"},{\"text\":\"Postbox\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to its \"},{\"text\":\"Train Station\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", set distinct addresses and provide a train that visits both stops.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Trains\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" collect outgoing packages and drop off packages matching the destination \"},{\"text\":\"Postbox\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Inspect Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for the routing behaviour.\"}]}"
	]
	quest.6A91000000000113.title: "The Railway Post"
	quest.6A91000000000114.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Send\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an addressed logistics \"},{\"text\":\"package\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through the station \"},{\"text\":\"Postboxes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and collect its contents at the outpost. Tick after checking the automatic delivery and return route.\"}]}"]
	quest.6A91000000000114.title: "A Package to the Outpost"
	quest.6A91000000000115.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place \"},{\"text\":\"Train Signals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to divide the route into occupied sections. \"},{\"text\":\"Inspect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the coloured \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" boundaries and keep \"},{\"text\":\"signals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" out of positions where a stopped train would \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a junction.\"}]}"]
	quest.6A91000000000115.title: "Divide the Railway into Blocks"
	quest.6A91000000000116.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Train Signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to earn its \"},{\"text\":\"Create\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" advancement. Check direction and \"},{\"text\":\"block\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" boundaries with the signal item held.\"}]}"]
	quest.6A91000000000116.title: "A Signal on the Track"
	quest.6A91000000000117.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Build a passing loop or junction. Use the \"},{\"text\":\"signal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" modes shown in \"},{\"text\":\"Ponder\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to reserve a safe path through it and leave enough space beyond the exit for a complete train. Tick after testing both routes.\"}]}"]
	quest.6A91000000000117.title: "A Junction That Stays Clear"
	quest.6A91000000000118.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use a \"},{\"text\":\"Train Observer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to detect trains at a chosen \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" point. \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" its \"},{\"text\":\"filter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and connect the output to a lamp or station mechanism.\"}]}"]
	quest.6A91000000000118.title: "Detect Passing Trains"
	quest.6A91000000000119.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Bind a \"},{\"text\":\"Display Link\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from a supported station source to a \"},{\"text\":\"Display Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Select the available train or schedule information and check the display while the service runs.\"}]}"]
	quest.6A91000000000119.title: "A Station Information Board"
	quest.6A9100000000011A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Run two scheduled trains sharing part of the \"},{\"text\":\"track\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Verify\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" that \"},{\"text\":\"signals\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" prevent conflicts, both trains can reach their destinations and neither waits forever at the junction.\"}]}"]
	quest.6A9100000000011A.title: "Two Trains, One Network"
	quest.6A9100000000011B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Connect a production site and \"},{\"text\":\"warehouse\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with an automatic freight service. Keep item cargo moving, complete a \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" run, and run two trains safely on the shared railway. Tick after a full operating cycle.\"}]}"]
	quest.6A9100000000011B.title: "The Factory Express"
	quest.6A93000000000100.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Clam\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on sand and wait for it to open, then right-click it to harvest a \"},{\"text\":\"Pearl\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Pearls\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are used to craft every color of \"},{\"text\":\"Fisherman's Hat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A93000000000100.title: "A Pearl from a Clam"
	quest.6A93000000000103.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Makes \"},{\"text\":\"caught fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"bigger\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and heavier.\"}]}"]
	quest.6A93000000000103.title: "White Fisherman's Hat"
	quest.6A93000000000106.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Adds a \"},{\"text\":\"Glowing\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"sweet-spot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to the fishing minigame.\"}]}"]
	quest.6A93000000000106.title: "Orange Fisherman's Hat"
	quest.6A93000000000109.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Increases the \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s rotation speed by \"},{\"text\":\"25%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A93000000000109.title: "Magenta Fisherman's Hat"
	quest.6A9300000000010C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Adds a \"},{\"text\":\"Dripstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"sweet-spot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and briefly freezes your \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" when you miss. Increases the minimum and maximum wait for bites by \"},{\"text\":\"40%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and the bite chance each tick by \"},{\"text\":\"40%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A9300000000010C.title: "Light Blue Fisherman's Hat"
	quest.6A9300000000010F.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Makes \"},{\"text\":\"perfect catches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" more likely to be \"},{\"text\":\"golden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Increases the minimum and maximum wait for bites by \"},{\"text\":\"20%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", the bite chance each tick by \"},{\"text\":\"40%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and the penalty for misses by \"},{\"text\":\"50%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A9300000000010F.title: "Yellow Fisherman's Hat"
	quest.6A93000000000112.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Lures\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a creeper and halves the minimum and maximum wait for a bite.\"}]}"]
	quest.6A93000000000112.title: "Lime Fisherman's Hat"
	quest.6A93000000000115.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Makes the \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" rotate five times as fast, and missing a \"},{\"text\":\"sweet-spot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" sets it on fire. Only \"},{\"text\":\"trash can\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" be caught.\"}]}"]
	quest.6A93000000000115.title: "Pink Fisherman's Hat"
	quest.6A93000000000118.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Adds three \"},{\"text\":\"extra fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a \"},{\"text\":\"perfect catch\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Hides\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" your catch, prevents \"},{\"text\":\"golden fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", and multiplies the penalty for misses by five.\"}]}"]
	quest.6A93000000000118.title: "Gray Fisherman's Hat"
	quest.6A9300000000011B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Adds one \"},{\"text\":\"extra fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" per catch, but hides your catch and prevents \"},{\"text\":\"golden fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A9300000000011B.title: "Light Gray Fisherman's Hat"
	quest.6A9300000000011E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Reduces the rate at which fish swim away and the \"},{\"text\":\"penalty\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for misses by \"},{\"text\":\"30%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A9300000000011E.title: "Cyan Fisherman's Hat"
	quest.6A93000000000121.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Reduces the \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s rotation speed by \"},{\"text\":\"25%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A93000000000121.title: "Purple Fisherman's Hat"
	quest.6A93000000000124.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Has a \"},{\"text\":\"50%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" chance to bypass weather restrictions. \"},{\"text\":\"Flips\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after every successful hit and reduces its rotation speed by \"},{\"text\":\"25%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A93000000000124.title: "Blue Fisherman's Hat"
	quest.6A93000000000127.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Launches the \"},{\"text\":\"bobber\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"2.5\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" times as fast, allowing much longer casts.\"}]}"]
	quest.6A93000000000127.title: "Brown Fisherman's Hat"
	quest.6A9300000000012A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Halves\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" fish \"},{\"text\":\"health\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and awards extra \"},{\"text\":\"experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" based on your performance. Prevents epic and legendary catches, and makes fish swim away \"},{\"text\":\"50%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" faster.\"}]}"]
	quest.6A9300000000012A.title: "Green Fisherman's Hat"
	quest.6A9300000000012D.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Has a \"},{\"text\":\"50%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" chance to bypass time-of-day restrictions. \"},{\"text\":\"Flips\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"handle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" after every successful hit.\"}]}"]
	quest.6A9300000000012D.title: "Red Fisherman's Hat"
	quest.6A93000000000130.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Adds five \"},{\"text\":\"extra fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" per catch, but hides your catch and prevents \"},{\"text\":\"golden fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Multiplies\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the \"},{\"text\":\"penalty\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for misses by five, doubles the rate at which fish swim away, and makes \"},{\"text\":\"sweet-spots\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" move and vanish \"},{\"text\":\"50%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" faster.\"}]}"]
	quest.6A93000000000130.title: "Black Fisherman's Hat"
	quest.6A96249657454FB1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Speeds up \"},{\"text\":\"bites\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and favors \"},{\"text\":\"swamp fish\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A96249657454FB1.title: "Murky Waters"
	quest.6AADEDD4135544C6.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Restores vanilla fishing loot. \"},{\"text\":\"Pair\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" it with the \"},{\"text\":\"Vanilla-flavoured Hook\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to skip the minigame.\"}]}"]
	quest.6AADEDD4135544C6.title: "Back to Basics"
	quest.6AAF9B27F5D15786.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Fishing Rod and Soul Sand\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to make this locator rod. \"},{\"text\":\"Mount\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a tamed \"},{\"text\":\"Sniffer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and use the rod to search toward \"},{\"text\":\"Ancient City\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Use it again to return to manual control.\"}]}"]
	quest.6AFBA81B1AF60F4D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Echo Ingot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" production starts with \"},{\"text\":\"Netherite\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and alternates filling, pressing and deploying steps.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", \"},{\"text\":\"Molten Echo\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and blaze powder supplied to the \"},{\"text\":\"Sequenced Assembly\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" line, and let the intermediate item finish every step.\"}]}"
