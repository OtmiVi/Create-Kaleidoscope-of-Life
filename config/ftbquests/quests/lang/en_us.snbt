	quest.6BA47FF208C2449B.title: "Humble Rod"
	quest.6BA7F02C8E3129AE.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Complete \"},{\"text\":\"Springboard Champion\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" by using a Weighted Ejector to launch \"},{\"text\":\"yourself\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" more than \"},{\"text\":\"30 blocks\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". You must launch yourself to complete this quest.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the destination and supply rotation before stepping onto the ejector. Keep the flight path clear and prepare a safe landing.\"}]}"
