	quest.0451FE3705BED077.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smokes \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"automatic input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in its settings. Install the module in a compatible backpack upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.049404DD6AEF27A7.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Place a \"},{\"text\":\"Sniffer Egg\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" somewhere safe to hatch.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Moss\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" speeds up hatching. \"},{\"text\":\"Protect\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the hatchling, then use the \"},{\"text\":\"companion\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" quest to learn this pack's taming and riding features.\"}]}"
	]
	quest.04CB233532021E15.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Circuit Engraver\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" performs the engraving steps in Northstar\u0027s electronic assembly sequences. Give it \"},{\"text\":\"rotational power\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and route the unfinished item through it at the correct point in the sequence.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Deploying components and engraving are separate operations; keep unfinished circuits moving through all required steps.\"}]}"
	]
	quest.04CB233532021E15.title: "Engrave the Circuit"
	quest.057CE0DED0A13A8B.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smelts \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Install the module in a compatible \"},{\"text\":\"storage\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"upgrade slot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", then open its tab to adjust the available settings.\"}]}"]
