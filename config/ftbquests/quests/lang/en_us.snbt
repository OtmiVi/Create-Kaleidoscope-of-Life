	]
	quest.14F8C1786EB82B7A.title: "Breath of the Ancients"
	quest.16C38A47D457DF54.title: "I kill'd him!"
	quest.181186E256272E35.quest_desc: [
		"Build a working Grindstone Drain with a Mechanical Grindstone above it and supply rotation."
		"Feed an enchanted item through the setup and stay nearby while its enchantments are removed. Witnessing the disenchanting process grants Gone with the Foil."
	]
	quest.181186E256272E35.title: "Gone with the Foil"
	quest.186DD501F439D1A4.quest_desc: [
		"Craft a Recipe item from four Paper arranged in a square."
		"Use it on a Wok or Stockpot to record ingredients for one-click cooking later. Keep useful recipes beside your stove."
	]
	quest.186DD501F439D1A4.title: "Write It Down"
	quest.18FB820A56B1C8C4.quest_desc: [
		"Prepare the Chorus Flower Tea Bag and brew Echo of the End."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.18FB820A56B1C8C4.title: "Echo of the End"
	quest.195E74A1833DE00D.quest_desc: [
		"Craft Kitchenware Racks, a Fruit Basket and a Tea Banner."
		"Hang cooking tools on the racks. The basket stores eight stacks of items and keeps them when carried, while the banner decorates your kitchen."
	]
	quest.195E74A1833DE00D.title: "A Kitchen That Feels Like Home"
	quest.19E084093DF5A0D0.quest_desc: [
		"Supply a Blaze Forger with Liquid Experience and switch its side panel to Application Mode."
		"Give it an Enchanting Template that already holds an enchantment and a compatible item. Applying the template grants Sigil Casting."
	]
	quest.19E084093DF5A0D0.title: "Put the Plan to Work"
	quest.1B677906BB80775E.quest_desc: [
		"Combine a Fishing Rod with certain items to create special locator rods."
		""
		"Different rods can point your Sniffer toward different biomes and structures."
		""
		"Mount your Sniffer and use a locator rod to begin searching. Use it again to switch back to manual control."
	]
	quest.1B677906BB80775E.title: "Sniffer Navigation System"
	quest.1CAE63D2EF47179F.quest_desc: [
		"Harvest 8 Red Chilis and 8 Green Chilis."
		"Keep both colors in your pantry. Some recipes accept either color, while others specifically need green peppers."
	]
	quest.1CAE63D2EF47179F.title: "Two Colors of Heat"
	quest.1CE3D2ACF9DAE82D.title: "I can do something from this"
	quest.1EC672DB21FC8697.quest_desc: [
		"Prepare the Lilac Tea Bag and brew Spring Waltz."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.1EC672DB21FC8697.title: "Spring Waltz"
	quest.1F29B43874969679.quest_desc: [
		"Craft a Straw Hat and wear it while breaking grass. This gives you a chance to find Tomato, Chili, Lettuce and Tea Seeds, as well as Wild Rice."
		"Start a small farm and save some of every crop. Your harvest will supply the steamer, wok and stockpot branches."
	]
	quest.1F29B43874969679.title: "A Straw Hat and a Fresh Start"
	quest.1FAF140FB6D4064B.quest_desc: ["Eat a dew flower cake, then land its shockwave on something from at least two blocks up"]
	quest.1FAF140FB6D4064B.title: "Treading the Dew"
