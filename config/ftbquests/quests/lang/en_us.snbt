	quest.21775B3DBED2E2D8.title: "Half a Cup of the World"
	quest.218B6C60AB1E94C1.quest_desc: ["Obtain a Blaze Forger and supply it with Liquid Experience. Use its side panel to switch between merging enchantments, applying templates, and extracting enchantments into blank templates."]
	quest.218B6C60AB1E94C1.title: "Strike While It's Enchanted"
	quest.22B9B33AB325C110.quest_desc: ["Obtain an Experience Hatch and attach it to your experience storage. Right-click to deposit experience. Sneak-right-click to withdraw it. Adjust the amount transferred with the hatch's scroll panel."]
	quest.22B9B33AB325C110.title: "Bank Your Levels"
	quest.22C6644CC2675898.quest_desc: [
		"Prepare the Poppy Tea Bag and brew Lullaby."
		"Serve this flower tea from your heated Teapot in an Empty Cup."
	]
	quest.22C6644CC2675898.title: "Lullaby"
	quest.242F82EDB7AD82B9.title: "Get some arms"
	quest.2655497B751A1091.quest_desc: [
		"Prepare all five noodle and congee dishes in this Stockpot collection."
		"From a warming broth to a hearty bowl of noodles, there is something here for every appetite."
	]
	quest.2655497B751A1091.title: "Noodles and a Pot of Comfort"
	quest.266E1B1345DE3792.quest_desc: [
		"Supply a Blaze Forger with Liquid Experience and select its merge mode."
		"Give it two items of the same type, such as two enchanted swords, and let it combine them. A successful merge grants Blazing Fusion."
	]
	quest.266E1B1345DE3792.title: "Blazing Fusion"
	quest.26A4E6CE696C4E90.quest_desc: [
		"Obtain two Mechanical Grindstones and one Item Drain. Right-click the Item Drain with one grindstone to make a Grindstone Drain, then place the second grindstone above it and supply rotation."
		"Use the setup to remove enchantments or turn Nuggets of Experience into Liquid Experience."
	]
	quest.26A4E6CE696C4E90.title: "Grind Away the Magic"
	quest.26F5EDFCE5206941.quest_desc: [
		"Mill Wheat in a powered Create Millstone to obtain Flour."
		"Turn the Flour into Raw Dough by washing it with an Encased Fan blowing through water. Place the flour in the washing air stream and let processing finish."
		"Save some dough for steamed buns, stuffed dough and noodles."
		""
		"{\"text\":\"Open the quest with Create\\u0027s Millstone\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"449A09FC50B32D81\"}}"
