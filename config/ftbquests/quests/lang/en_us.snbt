	quest.2D285B53EFF7C1D1.title: "Advanced Guardian Beam Turret"
	quest.2D648D7F05233247.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Accept\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"villager\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" request, complete it and return to the quest giver.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Check Controls for the \"},{\"text\":\"Quest Journal\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" key. \"},{\"text\":\"Self-check\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\": tick when done.\"}]}"
