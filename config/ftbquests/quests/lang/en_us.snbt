	image.354647FC886C0D78.title: "{\"text\":\"COPPER ERA\",\"color\":\"#D6B879\",\"bold\":true}"
	image.36E89B1546DFA8FD.title: "{\"text\":\"Store, sort and pack for the road.\",\"color\":\"#D4CDBE\",\"bold\":false}"
