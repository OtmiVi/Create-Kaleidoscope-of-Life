	quest.28D901913D5E7494.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Apply this tier upgrade to a matching \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Iron\"},{\"text\":\" \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"storage\"},{\"text\":\" container to raise it to \"},{\"bold\":true,\"color\":\"#D6B879\",\"text\":\"Netherite\"},{\"text\":\" tier.\"}]}"
	]
	quest.28FEB827BAE264B5.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Apply this template at a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to change the tackle's appearance. Check the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for its matching material.\"}]}"]
	quest.28FEB827BAE264B5.title: "Frog Tackle Smithing Template"
	quest.29606372FC3CABF2.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Ancient Debris\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" survives \"},{\"text\":\"lava\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and can be smelted into \"},{\"text\":\"Netherite Scrap\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Bring a diamond pickaxe or better.\"}]}"]
	quest.29606372FC3CABF2.title: "Anchient ore"
	quest.29A5526C099C6643.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Smelts \"},{\"text\":\"items\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"upgrade tab\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Configure\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" \"},{\"text\":\"automatic input\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and \"},{\"text\":\"output\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in its settings. Install the module in a compatible storage upgrade slot, then open its tab to adjust the available settings.\"}]}"]
	quest.29BBE84EA28C1152.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Backpack Upgrade Bases\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" are components for portable upgrades. \"},{\"text\":\"Match\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" the upgrade namespace to the \"},{\"text\":\"backpack\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before crafting a module.\"}]}"]
	quest.2A4213D1093462B1.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Finish hired-\"},{\"text\":\"worker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" assignments for every supported profession.\"}]}"]
