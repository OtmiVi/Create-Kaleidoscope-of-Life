	quest.2E9FA72B8E45D381.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Glowstone\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" dust and glow ink are useful for lighting and decoration. Collect glowstone in the \"},{\"text\":\"Nether\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and glow ink from glow squids.\"}]}"]
