	]
	quest.31A8F6CD2AEC9561.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Feed \"},{\"text\":\"Cake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" o' \"},{\"text\":\"Enchanting\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to a \"},{\"text\":\"Blaze Enchanter\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or Blaze Forger to activate Super Enchanting mode.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep supplying \"},{\"text\":\"Liquid Experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and place a \"},{\"text\":\"Lightning Rod\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" nearby before processing equipment.\"}]}"
	]
