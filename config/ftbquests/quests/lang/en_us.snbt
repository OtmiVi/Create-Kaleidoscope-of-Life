	quest.21198D09380BE14F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Atmospheric Concentrator\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" collects gases from the surrounding atmosphere. Use it to supply \"},{\"text\":\"Oxygen\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Carbon\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" where the planet's atmosphere contains them.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Connect its output to your fluid network and check the gas available at your location. A vacuum cannot supply the oxygen needed by an \"},{\"text\":\"Oxygen Filler\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Oxygen Sealer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
