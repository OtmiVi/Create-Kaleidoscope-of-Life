	]
	quest.6A7E00000000009A.title: "From Vineyard to Cellar"
	quest.6A7E0000000000A2.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"You can use an \"},{\"text\":\"Item Drain and Spout\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to empty and fill bottles.\"}]}"
		"{\"text\":\"Item Drain and Spout\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"0172930769CA91D7\"}}"
		"{\"text\":\"Depot\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"24A3A61046CA3464\"}}"
	]
	quest.6A7E0000000000A2.title: "A Bottling Line of Your Own"
	quest.6A7F000000000002.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a kitchen knife to gather \"},{\"text\":\"Sculk Branches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the \"},{\"text\":\"Deep Dark\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Branches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply \"},{\"text\":\"Sculk Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" through milling and are also used in the \"},{\"text\":\"Erosion Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" branch. Reserve some for each route.\"}]}"
	]
	quest.6A7F000000000002.title: "A Taste of the Deep Dark"
	quest.6A7F000000000005.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mill \"},{\"text\":\"Sculk Branches\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Sculk Dust.\"}]}"]
	quest.6A7F000000000005.title: "A Pinch of Darkness"
	quest.6A7F000000000008.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Cut\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a \"},{\"text\":\"Sculk\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" block four times on a Chopping Board to get \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Sculk Fungus.\"}]}"
		"{\"text\":\"Chopping Board\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"381A43D155C8D44B\"}}"
	]
	quest.6A7F000000000008.title: "Something Growing in the Dark"
	quest.6A7F00000000000B.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Erosion Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" preparation and keep it available for the \"},{\"text\":\"Silent Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" upgrade.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"At a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", combine it with a \"},{\"text\":\"Silent Upgrade Smithing Template\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a \"},{\"text\":\"Sculk Shrieker\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to obtain the upgraded knife.\"}]}"
	]
	quest.6A7F00000000000B.title: "An Edge of Erosion"
	quest.6A7F00000000000E.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Mill an \"},{\"text\":\"Echo Shard\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" into Echo Seeds and collect \"},{\"text\":\"2\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A7F00000000000E.title: "Plant an Echo"
	quest.6A7F000000000011.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Plant Echo Seeds\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" on a Sculk Catalyst and harvest \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Sheer Purity.\"}]}"]
	quest.6A7F000000000011.title: "Sheer Purity"
	quest.6A7F000000000014.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Cut Sheer Purity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" three times on a \"},{\"text\":\"Chopping Board\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to get Sculk Flesh. Collect \"},{\"text\":\"6\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A7F000000000014.title: "What Is Inside?"
	quest.6A7F000000000017.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"A \"},{\"text\":\"Soul\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" is used with \"},{\"text\":\"Sculk Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and water to produce Sculk Dough.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep part of your \"},{\"text\":\"soul\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" supply for the dessert branch instead of using everything immediately.\"}]}"
	]
	quest.6A7F000000000017.title: "A Little Soul"
	quest.6A7F00000000001A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Combine Sculk Dust\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", a \"},{\"text\":\"Soul\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a Water Bucket to make Sculk Dough. Collect \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"]
	quest.6A7F00000000001A.title: "Dough from the Depths"
	quest.6A7F00000000001D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Deepslate Stove\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" as the \"},{\"text\":\"heat source\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for your underground cookware.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Leave access to the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" above it for ingredients and serving containers.\"}]}"
	]
	quest.6A7F00000000001D.title: "A Darker Hearth"
	quest.6A7F000000000020.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use a heated \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Sculk Fungus Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", Sculk Chicken Stew and Sculk Stew.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Add the \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\"'s \"},{\"text\":\"fluid\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" before its \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", close the lid while cooking, and keep the matching serving container ready.\"}]}"
		"{\"text\":\"Stockpot\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"331F655A447D9BC3\"}}"
	]
	quest.6A7F000000000020.title: "Three Bowls from Below"
	quest.6A7F000000000025.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use an oiled, heated \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Sculk Lamb Chop and Erosion Dumpling Skewer\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep each dish's \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" together and collect the finished meal before changing \"},{\"text\":\"recipes\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"Wok\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"733FCF269775E418\"}}"
	]
	quest.6A7F000000000025.title: "A Sizzle in the Dark"
	quest.6A7F000000000029.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Boil Sheer Purity\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses the \"},{\"text\":\"Stockpot\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", while Sculk Pineapple Jelly uses the Wok.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep their \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in separate batches so each goes to the correct cookware.\"}]}"
	]
	quest.6A7F000000000029.title: "Soft, Sweet and Strange"
	quest.6A7F00000000002D.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve \"},{\"text\":\"Sculk Dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Soul Pancake and Deepslate Cake Slice\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep the prepared \"},{\"text\":\"dough\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the dessert \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" instead of using the entire supply in one \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A7F00000000002D.title: "Dessert Has an Echo"
	quest.6A7F000000000031.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ancient City Style Sashimi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" combines ordinary \"},{\"text\":\"Sashimi\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a \"},{\"text\":\"Red Candle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", a Sculk Shrieker and a Bowl.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep those components together in the kitchen pantry; its assembly uses the \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" directly rather than a cooking cycle.\"}]}"
	]
	quest.6A7F000000000031.title: "The City's Secret Recipe"
	quest.6A7F000000000034.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Ancient Bone Fragments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" come from encounters with a \"},{\"text\":\"Warden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Save them for the bone-\"},{\"text\":\"food\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" branch and the \"},{\"text\":\"Soul Sail\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" instead of spending the entire supply on one \"},{\"text\":\"recipe\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.6A7F000000000034.title: "Bones That Remember"
	quest.6A7F000000000037.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Defeat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" a Warden and collect \"},{\"text\":\"4\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" Warden Tendrils.\"}]}"]
	quest.6A7F000000000037.title: "A Warden's Last Whisper"
	quest.6A7F00000000003A.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Use an \"},{\"text\":\"Erosion Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" or \"},{\"text\":\"Silent Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to obtain \"},{\"text\":\"Eerie Meat\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" from animals.\"}]}"]
	quest.6A7F00000000003A.title: "An Unusual Cut"
	quest.6A7F000000000040.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Sculk Pork Ribs and Ancient Brittle Bone Fragments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". \"},{\"text\":\"Pork Ancient Bone Soup\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" uses the Stockpot.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Keep \"},{\"text\":\"Ancient Bone Fragments\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" in the kitchen pantry and check the \"},{\"text\":\"serving container\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for each dish before cooking.\"}]}"
	]
	quest.6A7F000000000040.title: "A Meal on the Bone"
	quest.6A7F000000000045.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" for \"},{\"text\":\"Cooked Warden Tendril Bowl and Sculk-Flavoured Mooncake\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\".\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reserve \"},{\"text\":\"Warden\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" drops for both dishes and keep their \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" separated from ordinary \"},{\"text\":\"Wok\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" batches.\"}]}"
	]
	quest.6A7F000000000045.title: "Nothing Goes to Waste"
	quest.6A7F000000000049.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Use the \"},{\"text\":\"Silent Upgrade Smithing Template\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at a \"},{\"text\":\"Smithing Table\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" to upgrade an \"},{\"text\":\"Erosion Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a Sculk Shrieker.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"The template is also a component of the \"},{\"text\":\"Soul Sail\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\", so keep a spare for that equipment branch.\"}]}"
	]
	quest.6A7F000000000049.title: "A Silent Pattern"
	quest.6A7F00000000004C.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Upgrade\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" an \"},{\"text\":\"Erosion Kitchen Knife\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with the \"},{\"text\":\"Silent Upgrade Smithing Template\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and a Sculk Shrieker.\"}]}"]
	quest.6A7F00000000004C.title: "A Quieter Edge"
	quest.6A7F00000000004F.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"The \"},{\"text\":\"Sculk Bone Sickle\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" harvests a wide area of \"},{\"text\":\"crops\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" and bushes.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Try it on a small section of your farm before using it along mixed crop borders.\"}]}"
	]
	quest.6A7F00000000004F.title: "A Wider Harvest"
	quest.6A7F000000000052.quest_desc: [
		"{\"text\":\"\",\"extra\":[{\"text\":\"Aim the Soul Sail\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" at a creature below \"},{\"text\":\"30%\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" health and use its \"},{\"text\":\"Reap\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" key.\"}]}"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Reaping\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" costs XP and has a \"},{\"text\":\"cooldown\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\". Check the assigned key and keep enough \"},{\"text\":\"experience\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" available before depending on the ability.\"}]}"
	]
	quest.6A7F000000000052.title: "Souls on the Wind"
	quest.6A7F000000000055.quest_desc: ["{\"text\":\"\",\"extra\":[{\"text\":\"Find a \"},{\"text\":\"Sculk Caterpillar\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" while gathering sculk \"},{\"text\":\"ingredients\",\"color\":\"#D6B879\",\"bold\":true},{\"text\":\" with a kitchen knife.\"}]}"]
